#!/usr/bin/env bash
# Link jstack's settings, skills, agents, and hooks into every harness. Safe to rerun.
# Usage: ./install [--dry-run]
set -euo pipefail

repo=$(cd "$(dirname "$0")" && pwd -P)
dry=0
[ "${1:-}" = "--dry-run" ] && dry=1

skill_dirs=("$HOME/.claude/skills" "$HOME/.agents/skills")
agent_dirs=("$HOME/.claude/agents" "$HOME/.cursor/agents")
profiles=("$HOME/.claude_prime" "$HOME/.claude_agent")

run() { [ "$dry" -eq 1 ] || "$@"; }
say() { if [ "$dry" -eq 1 ]; then echo "would: $*"; else echo "$*"; fi; }

link() { # link <source> <destination>
    local src=$1 dst=$2
    if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$src")" ]; then return; fi
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        echo "conflict: $dst exists and is not a link (skipped)" >&2
        return
    fi
    run mkdir -p "$(dirname "$dst")"
    run ln -sfn "$src" "$dst"
    say "linked  $dst"
}

prune() { # remove dead links in <dir>
    local dir=$1
    [ -d "$dir" ] || return 0
    for l in "$dir"/*; do
        [ -L "$l" ] || continue
        if [ ! -e "$l" ]; then run rm "$l"; say "pruned  $l (dead)"; fi
    done
}

# The live settings are untracked. A machine without them starts from the template.
if [ ! -e "$repo/settings.json" ]; then
    run cp "$repo/settings.example.json" "$repo/settings.json"
    say "copied  settings.example.json to settings.json (edit it)"
fi
link "$repo/settings.json" "$HOME/.claude/settings.json"
for p in "${profiles[@]}"; do
    [ -d "$p" ] || continue
    link "$HOME/.claude/settings.json" "$p/settings.json"
    link "$HOME/.claude/skills" "$p/skills"
    link "$HOME/.claude/agents" "$p/agents"
done

for d in "${skill_dirs[@]}"; do
    prune "$d"
    for s in "$repo"/skills/*/; do
        s=${s%/}
        link "$s" "$d/$(basename "$s")"
    done
done

for d in "${agent_dirs[@]}"; do
    prune "$d"
    for a in "$repo"/agents/*.md; do
        link "$a" "$d/$(basename "$a")"
    done
done

# Hooks: hooks/hooks.json names each script and its event per harness. Every
# run drops the entries a previous run wrote (commands ending in
# "hooks/<script> <harness>") and writes the current set, leaving other hooks alone.
ours='/hooks/[^/ ]+ (claude|codex|cursor)$'

write_json() { # write_json <file> <jq filter> <harness>: rewrite <file> through the filter
    local file=$1 filter=$2 harness=$3 target new
    target=$(readlink -f "$file" 2>/dev/null || echo "$file")
    new=$(jq --arg dir "$repo/hooks" --arg h "$harness" --arg ours "$ours" \
        --slurpfile specs "$repo/hooks/hooks.json" "$filter" "$target" 2>/dev/null ||
        jq -n --arg dir "$repo/hooks" --arg h "$harness" --arg ours "$ours" \
            --slurpfile specs "$repo/hooks/hooks.json" "{} | $filter")
    if [ -e "$target" ] && [ "$new" = "$(jq . "$target")" ]; then return; fi
    run mkdir -p "$(dirname "$target")"
    [ "$dry" -eq 1 ] || printf '%s\n' "$new" >"$target"
    say "hooks   $file"
}

# Claude Code and Codex share one schema: {hooks: {Event: [{matcher, hooks: [{type, command}]}]}}.
# shellcheck disable=SC2016 # $names are jq variables
nested='.hooks = ((.hooks // {})
        | with_entries(.value |= (map(.hooks |= map(select(.command | test($ours) | not)))
            | map(select(.hooks | length > 0))))
        | with_entries(select(.value | length > 0)))
    | reduce $specs[0][] as $s (.; .hooks[$s[$h].event] += [{matcher: $s[$h].matcher,
        hooks: [{type: "command", command: "\($dir)/\($s.script) \($h)", timeout: 10}]}])'
# Cursor: {version: 1, hooks: {event: [{command, matcher}]}}.
# shellcheck disable=SC2016
flat='.version = 1
    | .hooks = ((.hooks // {})
        | with_entries(.value |= map(select(.command | test($ours) | not)))
        | with_entries(select(.value | length > 0)))
    | reduce $specs[0][] as $s (.; .hooks[$s[$h].event] += [{command: "\($dir)/\($s.script) \($h)",
        matcher: $s[$h].matcher, timeout: 10}])'

write_json "$HOME/.claude/settings.json" "$nested" claude
write_json "$HOME/.codex/hooks.json" "$nested" codex
write_json "$HOME/.cursor/hooks.json" "$flat" cursor

# Codex skips a hook nobody has trusted, without a word, so trust our own.
if [ -e "$HOME/.codex/hooks.json" ] && command -v codex >/dev/null; then
    flag=(); [ "$dry" -eq 1 ] && flag=(--dry-run)
    node "$repo/scripts/codex-trust-hooks.mjs" "$ours" "${flag[@]}" | sed 's/^/codex   /' ||
        echo "codex   could not trust its hooks; Codex will skip them until you trust them in codex /hooks" >&2
fi
