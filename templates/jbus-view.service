[Unit]
Description=jbus view: the bus as a page, read-only
Documentation=file:%Y/../docs/jbus.md#the-view

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus view
Restart=always
RestartForceExitStatus=75
SuccessExitStatus=75
RestartSec=5

[Install]
WantedBy=default.target
