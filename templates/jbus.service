[Unit]
Description=jbus: launch what was approved, merge through jmerge, watch what is done, wake the Chef
Documentation=file:%Y/../docs/jbus.md#set-up-jbus file:%Y/../docs/jbus.md#when-jbus-fails
OnFailure=jbus-failed.service

[Service]
Type=oneshot
TimeoutStartSec=20min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus poll
