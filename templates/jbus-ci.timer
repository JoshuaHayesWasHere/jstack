# Runs jbus-ci.service every Monday at 09:00 in New York, whatever zone the machine is in.
# Persistent=true runs one that the machine slept through as soon as it is up again.
[Unit]
Description=jbus ci: the week's CI report, Mondays at 09:00 ET

[Timer]
OnCalendar=Mon *-*-* 09:00:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
