[Unit]
Description=jbus snapshot: commit and push the homes' state tree
Documentation=file:%Y/../docs/jbus.md#back-up-the-homes-state
OnFailure=jbus-snapshot-failed.service

[Service]
Type=oneshot
TimeoutStartSec=5min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus snapshot
