# jbus ci: keep the last two weeks of jstack's CI jobs, write reports/ci-week-<date>.md in
# jstack's home, and alert once if a target was missed.
# Install: `sh install.sh` links this file and jbus-ci.timer into ~/.config/systemd/user/ with the
# jbus units, and enables the timer. Do not copy this file.
[Unit]
Description=jbus ci: keep CI's jobs, write the week's report and alert on a missed target

[Service]
Type=oneshot
TimeoutStartSec=10min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus --project jstack ci --report
