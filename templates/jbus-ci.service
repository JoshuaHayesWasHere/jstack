[Unit]
Description=jbus ci: keep CI's jobs, write the week's report and alert on a missed target
Documentation=file:%Y/../docs/jbus.md#measure-the-ci file:%Y/../docs/jbus.md#the-weeks-report

[Service]
Type=oneshot
TimeoutStartSec=10min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus --project jstack ci --report
