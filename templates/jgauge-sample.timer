# Runs jgauge-sample.service every 15 s. OnUnitActiveSec counts from the last start, so
# OnBootSec gives it a first one; with AccuracySec=1s a row comes every 15 to 16 s.
[Unit]
Description=jgauge sample: load and pressure every 15 s

[Timer]
OnBootSec=1min
OnUnitActiveSec=15s
AccuracySec=1s

[Install]
WantedBy=timers.target
