# jgauge sample: append one row of load and pressure to ~/.local/state/jgauge/load.tsv.
# Install: `sh install.sh` links this file and jgauge-sample.timer into ~/.config/systemd/user/
# with the jbus units, and enables the timer. Do not copy this file.
[Unit]
Description=jgauge sample: one row of load and pressure

[Service]
Type=oneshot
TimeoutStartSec=1min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jgauge sample
