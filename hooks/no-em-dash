#!/usr/bin/env bash
set -uo pipefail

harness=${1:?usage: no-em-dash claude|codex|cursor|antigravity}
payload=$(cat)
dash=$'\u2014'

# Cursor also runs hooks from ~/.claude/settings.json; its own entry covers it.
if [ "$harness" = claude ] && jq -e '.cursor_version' <<<"$payload" >/dev/null 2>&1; then
    exit 0
fi

# Antigravity sends camelCase fields and its own argument names; read them as Claude's.
if [ "$harness" = antigravity ]; then
    payload=$(jq -c '{hook_event_name: .hookEventName, tool_name: .toolCall.name, cwd,
        tool_input: (.toolCall.args // {} | {command: .CommandLine, file_path: .Path,
            content: .Content, new_string: .Replacement})}' <<<"$payload")
fi

deny() { # deny <reason>: refuse the tool call in this harness's format
    case "$harness" in
    cursor) jq -n --arg r "$1" '{permission: "deny", user_message: $r, agent_message: $r}' ;;
    antigravity) jq -n --arg r "$1" '{decision: "deny", reason: $r}' ;;
    *) echo "$1" >&2; exit 2 ;;
    esac
    exit 0
}

body_file_text() { # <command> <cwd>
    command -v python3 >/dev/null || return 0
    python3 -I - "$1" "$2" 2>/dev/null <<'PY'
import os, shlex, sys

command, cwd = sys.argv[1].replace("\\\n", " "), sys.argv[2]
lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|\n")
lexer.whitespace_split, lexer.whitespace, lexer.commenters = True, " \t\r", ""
tokens = []
try:
    for token in lexer:
        tokens.append(token)
except ValueError:
    pass
segments, segment = [], []
for token in tokens:
    if set(token) <= set(";&|\n"):
        segments.append(segment)
        segment = []
    else:
        segment.append(token)
segments.append(segment)

subcommands = {"git": {"commit", "tag"}, "gh": {"pr", "issue", "release", "api"}}
flags = {"--body-file", "--notes-file", "--file", "--field", "-F"}
for segment in segments:
    if segment[:1] == ["cd"]:
        target = next((a for a in segment[1:] if not a.startswith("-")), "~")
        cwd = os.path.join(cwd, os.path.expanduser(target))
        continue
    tool = next((t for t in segment if os.path.basename(t) in subcommands), None)
    if tool is None or not subcommands[os.path.basename(tool)] & set(segment):
        continue
    base = cwd
    if os.path.basename(tool) == "git" and "-C" in segment[:-1]:
        base = os.path.join(cwd, os.path.expanduser(segment[segment.index("-C") + 1]))
    for i, token in enumerate(segment):
        name, _, attached = token.partition("=")
        if token in flags and i + 1 < len(segment):
            value = segment[i + 1]
        elif name in flags and attached:
            value = attached
        elif token.startswith("-F") and len(token) > 2:
            value = token[2:]
        else:
            continue
        if "=@" in value:
            value = value.partition("=@")[2]
        elif "=" in value or value == "-":
            continue
        try:
            with open(os.path.join(base, os.path.expanduser(value)), errors="replace") as f:
                print(f.read())
        except OSError:
            pass
PY
}

event=$(jq -r '.hook_event_name // empty' <<<"$payload")
tool=$(jq -r '.tool_name // empty' <<<"$payload")

case "$event" in
PreToolUse | preToolUse) check=shell ;;
PostToolUse | postToolUse) check=edit ;;
*) exit 0 ;;
esac
# Antigravity ignores what a PostToolUse hook prints, so it checks an edit before it lands.
[ "$harness" = antigravity ] && [ "$tool" != run_command ] && check=edit

if [ "$check" = shell ]; then
    command=$(jq -r '.tool_input.command // empty' <<<"$payload")
    grep -Eq '(^|[^[:alnum:]_-])(git[[:space:]]([^;&|]*[[:space:]])?(commit|tag)|gh[[:space:]]([^;&|]*[[:space:]])?(pr|issue|release|api))([[:space:]]|$)' <<<"$command" || exit 0
    cwd=$(jq -r '.cwd // empty' <<<"$payload")
    sent=$command$'\n'$(body_file_text "$command" "${cwd:-$PWD}")
    [[ "$sent" == *"$dash"* ]] || exit 0
    deny "This command sends an em dash (U+2014) into git or GitHub text, in the command or a file it reads. Use a period or a comma instead, then run it again."
fi

if [ "$tool" = apply_patch ] || [ "$tool" = ApplyPatch ]; then
    text=$(jq -r '.tool_input.command // .tool_input.patch // .tool_input.input // empty' <<<"$payload" |
        grep -E '^\+' | grep -Ev '^\+\+\+ ')
else
    text=$(jq -r '[.tool_input | .. | objects | to_entries[]
        | select(.key | test("^(content|contents|new_string|new_source|code_edit|streamContent)$"))
        | .value | strings] | join("\n")' <<<"$payload")
fi

[[ "$text" == *"$dash"* ]] || exit 0

file=$(jq -r '.tool_input.file_path // .tool_input.path // .tool_input.notebook_path // empty' <<<"$payload")
lines=$(grep -F -- "$dash" <<<"$text" | head -5 | cut -c1-160)
reason="That edit${file:+ to $file} writes an em dash (U+2014). Replace each with a period or a comma:
$lines"

case "$harness" in
cursor) jq -n --arg r "$reason" '{additional_context: $r}' ;;
antigravity) deny "$reason" ;;
*) echo "$reason" >&2; exit 2 ;;
esac
