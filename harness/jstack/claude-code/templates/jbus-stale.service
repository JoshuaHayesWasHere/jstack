[Unit]
Description=jbus stale: alert once when no pass ended in the last 2 hours
Documentation=file:%Y/../docs/jbus/when-jbus-fails.md#when-jbus-fails

[Service]
Type=oneshot
TimeoutStartSec=5min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus alarm --stale 2h
