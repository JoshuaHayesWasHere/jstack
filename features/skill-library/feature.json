{
  "$schema": "../../schemas/feature.schema.json",
  "name": "skill-library",
  "description": "The skills any thread may load by name, and the tips hook that suggests them.",
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "script": "hooks/skill-tips.sh",
      "harnesses": [
        "claude-code"
      ]
    }
  ],
  "owns": [
    "skills/blast-radius/**",
    "skills/create-formal-verification-skill/**",
    "skills/create-verification-skill/**",
    "skills/maintain-verification-skill/**",
    "skills/figure-it-out/**",
    "skills/interrogate/**",
    "skills/poteto-help/**",
    "hooks/skill-tips.sh",
    "templates/skill-artifacts.md",
    "tests/test_skill_tips.py",
    "tests/test_gate_skills.py",
    ".claude/skills/verify-jstack/features/skill-library.md",
    "playbooks/authoring-*.md",
    "templates/playbook.md"
  ]
}
