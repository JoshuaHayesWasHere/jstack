    state "Not red" as legendGroup0
    state "Red, its fix on its way" as legendGroup1
    state "Red, nothing open yet" as legendGroup2
    state "Breaks a rule today" as legendWrong
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendGroup2 group2
  class legendWrong plainWrong
  state "Main green" as g0 {
    state "a fix row out" as s0
    state "nothing open to fix it" as s1
  }
  state "Main red" as g1 {
    state "a fix row out" as s2
    state "a revert open" as s3
