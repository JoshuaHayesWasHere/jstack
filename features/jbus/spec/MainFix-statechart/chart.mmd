    state "no revert; main's Mac: no<br/>fix brief" as s10
  }
  state "Main's Mac red, jbus in a<br/>pass" as g4 {
    state "a revert on record, never<br/>said; main's Mac: no fix<br/>brief" as s11
    state "a revert open on GitHub,<br/>its brief written, not on<br/>record; main's Mac: no fix<br/>brief" as s12
    state "a revert open on GitHub,<br/>not on record; main's Mac:<br/>a fix brief with no row" as s13
    state "a revert open on GitHub,<br/>not on record; main's Mac:<br/>no fix brief" as s14
    state "no revert; main's Mac: a<br/>fix brief with no row" as s15
    state "no revert; main's Mac: no<br/>fix brief" as s16
  }
  state "Main green, between<br/>passes: no revert" as s17
  state "Main red, after a pass<br/>that died: a revert open<br/>on GitHub, not on record;<br/>main: no fix brief" as s18
  state "Main red, then green<br/>again, after a pass that<br/>died: a revert open on<br/>GitHub, not on record" as s19
  state "Main red, then green<br/>again, between passes: a<br/>revert open on GitHub, not<br/>on record" as s20
  state "Main red, then green<br/>again, jbus in a pass: a<br/>revert open on GitHub, not<br/>on record" as s21
  [*] --> s17
  s17 --> s1 : a merge turns main red
  s17 --> s10 : a merge turns main's Mac red
  s1 --> s4 : a pass starts
  s10 --> s16 : a pass starts
  s16 --> s15 : jbus writes the fix brief
  s16 --> s14 : jbus opens the revert on<br/>GitHub
  s15 --> s7 : the pass dies
  s4 --> s3 : jbus opens the revert on<br/>GitHub
  s14 --> s6 : the pass dies
  s14 --> s12 : jbus writes the revert's brief
  s7 --> s15 : a pass starts
  s3 --> s18 : the pass dies
  s6 --> s19 : you run a red check again, and<br/>it passes or a pull request<br/>merges, a fix row's or one you<br/>merge, and main's Mac turns<br/>green
  s12 --> s11 : jbus records the revert in<br/>reverts.json
  s18 --> s3 : a pass starts
  s19 --> s21 : a pass starts
  s11 --> s5 : the pass dies
  s5 --> s11 : a pass starts
  s15 --> s13 : jbus opens the revert on<br/>GitHub
  s21 --> s20 : jbus finds main green
  s3 --> s2 : jbus writes the fix brief
  s11 --> s8 : jbus finds main green
  s13 --> s9 : jbus finds main green
  s2 --> s0 : jbus queues the fix row
