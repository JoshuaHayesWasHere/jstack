  }
  state "Main red, jbus in a pass" as g1 {
    state "a revert open on GitHub,<br/>not on record; main: a fix<br/>brief with no row" as s2
    state "a revert open on GitHub,<br/>not on record; main: no<br/>fix brief" as s3
    state "no revert; main: no fix<br/>brief" as s4
  }
  state "Main's Mac red, after a<br/>pass that died" as g2 {
    state "a revert on record, never<br/>said; main's Mac: no fix<br/>brief" as s5
