[Unit]
Description=jbus ci: write the day's CI report from the ledger, for each project with ci_report = true
Documentation=file:%Y/../docs/jbus/measure-the-ci.md#the-days-report

[Service]
Type=oneshot
TimeoutStartSec=10min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus ci --day --each
