[Unit]
Description=jbus ci: keep CI's jobs, write the week's report and alert on a missed target, for each project with ci_report = true
Documentation=file:%Y/../docs/jbus/measure-the-ci.md#measure-the-ci

[Service]
Type=oneshot
TimeoutStartSec=10min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus ci --report --each
