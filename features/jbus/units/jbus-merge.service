[Unit]
Description=jbus merge tick: run jmerge for each project where a check ended since the last tick
Documentation=file:%Y/../docs/jbus/the-units.md#the-units
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=20min
LogLevelMax=notice
SyslogLevel=notice
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/jbus tick
