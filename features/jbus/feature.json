{
  "$schema": "../../schemas/feature.schema.json",
  "name": "jbus",
  "description": "Does a home's routine work from a timer, so a repo can run with no home thread.",
  "packages": [
    "src/jbus"
  ],
  "commands": {
    "jbus": "jbus.cli:main"
  },
  "units": [
    "units/jbus-ci.service",
    "units/jbus-ci.timer",
    "units/jbus-failed.service",
    "units/jbus-relay.service",
    "units/jbus-snapshot.service",
    "units/jbus-snapshot.timer",
    "units/jbus-stale.service",
    "units/jbus-stale.timer",
    "units/jbus-view.service",
    "units/jbus.service",
    "units/jbus.timer"
  ],
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "hooks/door-command.sh",
      "harnesses": [
        "claude-code",
        "codex"
      ],
      "refuses": true
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "hooks/merge-command.sh",
      "harnesses": [
        "claude-code",
        "codex"
      ],
      "refuses": true
    },
    {
      "event": "Stop",
      "script": "hooks/turn-end.sh",
      "harnesses": [
        "claude-code",
        "codex"
      ]
    }
  ],
  "projectSkills": [
    "project-skill/verify-green-move",
    "project-skill/verify-main-fix",
    "project-skill/verify-main-red",
    "project-skill/verify-one-list",
    "project-skill/verify-row-life",
    "project-skill/verify-tell-once",
    "project-skill/verify-thread-life"
  ],
  "docs": [
    "docs/jbus.md",
    "docs/chef.md"
  ]
}
