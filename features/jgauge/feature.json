{
  "$schema": "../../schemas/feature.schema.json",
  "name": "jgauge",
  "description": "Counts what a thread cost in tokens, and says whether there is room for one more.",
  "packages": [
    "src/jgauge"
  ],
  "commands": {
    "jgauge": "jgauge.cli:main"
  },
  "docs": [
    "docs/jgauge.md"
  ],
  "statusLine": {
    "script": "hooks/limits.sh"
  },
  "owns": [
    "src/jgauge/**",
    "docs/jgauge.md",
    "docs/meter-findings.md",
    "docs/troubleshooting/jgauge-room-prints-wait.md",
    "hooks/limits.sh",
    "templates/jgauge-*",
    "tests/test_jgauge_sample.py",
    "tests/test_jgauge_limits.py",
    "tests/test_limits.py",
    "tests/test_probes.py",
    "tests/test_session.py",
    "tests/test_slot.py",
    "tests/test_slot_waiters.py",
    "tests/test_transcript.py",
    "tests/test_room.py",
    "tests/test_machine_sizes.py",
    "tests/test_limits_doc.py",
    "docs/limits.md",
    "docs/design/limits.md",
    "tests/fixtures/claude/**",
    ".claude/skills/verify-jstack/features/jgauge-*.md"
  ]
}
