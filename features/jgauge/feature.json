{
  "$schema": "../../schemas/feature.schema.json",
  "name": "jgauge",
  "description": "Counts what a thread cost in tokens, and says whether there is room for one more.",
  "packages": [
    "src/jgauge"
  ],
  "commands": {
    "jgauge": "jgauge.cli:main"
  },
  "units": [
    "units/jgauge-limits.service",
    "units/jgauge-limits.timer",
    "units/jgauge-sample.service",
    "units/jgauge-sample.timer"
  ],
  "docs": [
    "docs/jgauge.md"
  ],
  "statusLine": {
