{
  "$schema": "../../schemas/feature.schema.json",
  "name": "home",
  "description": "The home: plans with the user, writes each brief and launches its thread.",
  "hidden": [
    "handoff",
    "home",
    "new-home",
    "nohome",
    "root",
    "unstick"
  ],
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "startup|resume|clear|compact|fork",
      "script": "hooks/home-start.sh",
      "harnesses": [
        "claude-code",
        "codex"
      ]
    },
    {
      "event": "PreToolUse",
      "matcher": "mcp__t3[-_]code__t3_thread_send",
      "script": "hooks/agent-sends.sh",
      "harnesses": [
        "claude-code",
        "codex"
      ],
      "refuses": true
    }
  ],
  "projectSkills": [
    "project-skill/verify-home-tree",
    "project-skill/verify-home-tree-today",
    "project-skill/verify-plan-scope"
  ],
  "docs": [
    "docs/state.md",
    "docs/flow.md",
    "docs/hooks.md",
    "docs/playbooks.md",
    "docs/vision.md"
  ]
}
