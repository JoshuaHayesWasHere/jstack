{
  "$schema": "../../schemas/feature.schema.json",
  "name": "home",
  "description": "The home: plans with the user, writes each brief and launches its thread.",
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "startup",
      "script": "hooks/home-start.sh",
      "harnesses": [
        "claude-code",
        "codex"
      ]
    },
    {
      "event": "PreToolUse",
      "script": "hooks/home-gauge.sh",
      "harnesses": [
        "claude-code"
      ]
    },
    {
      "event": "PostToolUse",
      "script": "hooks/home-gauge.sh",
      "harnesses": [
        "claude-code"
      ]
    },
    {
      "event": "PreToolUse",
      "matcher": "mcp__t3[-_]code__t3_thread_send",
      "script": "hooks/agent-sends.sh",
      "harnesses": [
        "claude-code"
      ],
      "refuses": true
    }
  ],
  "docs": [
    "docs/state.md",
    "docs/flow.md",
    "docs/hooks.md",
    "docs/playbooks.md",
    "docs/vision.md"
  ]
}
