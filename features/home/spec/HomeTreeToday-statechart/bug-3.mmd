---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (against): the design
  classDef plainWrong fill:#f4f6f7,stroke:#c0392b,stroke-width:4px,color:#7b241c
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef plainPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef group0 fill:#d1f2eb,stroke:#697976,color:#1b2631
  classDef group0Wrong fill:#d1f2eb,stroke:#c0392b,stroke-width:4px,color:#7b241c
  classDef group0Path fill:#d1f2eb,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  state "Legend" as legend {
    state "Fine" as legendGroup0
    state "Wrong today" as legendWrong
    state "Fixed by the design" as legendFixed
  }
  class legendGroup0 group0
  class legendWrong plainWrong
  class legendFixed plainFixed
  state "Child a working, pull<br/>request ready" as g0 {
    state "jbus merging child a's<br/>pull request" as s0
    state "nothing for you" as s1
    state "the root merging child a's<br/>pull request" as s2
  }
  state "Child a working, crew out:<br/>nothing for you" as s3
  state "Child a working, pull<br/>request open: nothing for<br/>you" as s4
  state "Child a working: nothing<br/>for you" as s5
  state "No child yet: nothing for<br/>you" as s6
  [*] --> s6
  s6 --> s5 : 1. the root makes child a
  s5 --> s3 : 2. child a launches a crew
  s3 --> s4 : 3. child a's crew opens its<br/>pull request
  s4 --> s1 : 4. child a's pull request is<br/>green and reviewed
  s1 --> s2 : 5. the root reads main to<br/>merge child a's pull request
  s1 --> s0 : in the design, jbus reads main<br/>to merge child a's pull<br/>request
  class s3 plainPath
  class s4 plainPath
  class s0 plainFixed
  class s1 plainPath
  class s2 group0Wrong
  class s5 plainPath
  class s6 group0Path
