  state "At the same time" as regions {
    state "What an uninstall would<br/>leave" as region0 {
      [*] --> r0s8
      state "Installed, uninstall<br/>leaves ~/.local/state and<br/>~/.local/state/jstack<br/>behind" as r0s0
      state "Installed, uninstall<br/>leaves ~/.local/state<br/>behind" as r0s1
      state "Installed, uninstall<br/>leaves<br/>~/.local/state/jstack<br/>behind" as r0s2
      state "Installed, uninstall<br/>removes it all" as r0s3
      state "Installing, uninstall<br/>leaves ~/.local/state and<br/>~/.local/state/jstack<br/>behind" as r0s4
      state "Installing, uninstall<br/>leaves ~/.local/state<br/>behind" as r0s5
      state "Installing, uninstall<br/>leaves<br/>~/.local/state/jstack<br/>behind" as r0s6
      state "Installing, uninstall<br/>removes it all" as r0s7
      state "Nothing of jstack's on<br/>disk" as r0s8
      r0s0 --> r0s4 : you run install.sh: --repo<br/>sets up a repo
      r0s1 --> r0s5 : you run install.sh: --repo<br/>sets up a repo
      r0s2 --> r0s6 : you run install.sh: --repo<br/>sets up a repo
      r0s3 --> r0s8 : you uninstall
      r0s4 --> r0s5 : it writes the record of what<br/>it made
      r0s4 --> r0s0 : the install is killed
      r0s5 --> r0s1 : the install is killed
      r0s6 --> r0s2 : the install is killed
      r0s7 --> r0s6 : it makes ~/.local/state/jstack
      r0s7 --> r0s4 : it makes ~/.local/state/jstack
      r0s7 --> r0s3 : it makes the folder
      r0s7 --> r0s3 : it puts the repo's hook
      r0s7 --> r0s3 : it writes the seeded config
      r0s7 --> r0s3 : the install is killed
      r0s8 --> r0s7 : you run install.sh: --repo<br/>sets up a repo
      r0s8 --> r0s7 : you run install.sh: --setup<br/>seeds a config
      r0s8 --> r0s7 : you run install.sh: the<br/>install makes a folder
    }
    --
