+import { EnvironmentId, ProjectId, ThreadId } from "@t3tools/contracts";
+import { describe, expect, it, vi } from "vite-plus/test";
+import { userEvent } from "vite-plus/test/browser";
+
+import "~/index.css";
+import { render } from "../../../test/render";
+import type { SidebarProjectSnapshot } from "../../sidebarProjectGrouping";
+import { makeThreadFixture } from "../../test-fixtures";
+import type { JstackRootRow, JstackTreeRow } from "./jstackTree.logic";
+import { JstackTreeRowView, type JstackTreeRowActions } from "./JstackTreeRows";
+
+const environmentId = EnvironmentId.make("environment-local");
+const projectId = ProjectId.make("project-jstack");
+
+const member = {
+  id: projectId,
+  environmentId,
+  title: "jstack",
+  workspaceRoot: "/repos/jstack",
+  physicalProjectKey: `${environmentId}:/repos/jstack`,
+  environmentLabel: null,
+  defaultModelSelection: null,
+  scripts: [],
+  projectIcon: { kind: "monogram" as const, text: "JK", color: "pink" as const },
+  createdAt: "2026-10-29T00:00:00.000Z",
+  updatedAt: "2026-10-29T00:00:00.000Z",
+};
+
+const group = (displayName: string): SidebarProjectSnapshot => ({
+  ...member,
+  title: displayName,
+  projectKey: displayName,
+  displayName,
+  memberProjects: [member],
+  memberProjectRefs: [{ environmentId, projectId }],
+  groupedProjectCount: 1,
+  environmentPresence: "local-only",
+  allRemoteMembersAreDesktopLocal: false,
+  allRemoteMembersAreWsl: false,
+  remoteEnvironmentLabels: [],
+});
+
+const rootThread = makeThreadFixture({ environmentId, projectId, id: ThreadId.make("root") });
+
+const root = (overrides: Partial<JstackRootRow> = {}): JstackRootRow => ({
+  kind: "project",
+  key: "jstack-home:root",
+  main: rootThread,
+  noProject: false,
+  collapsed: false,
+  asksYou: false,
+  dot: false,
+  landed: 0,
+  folded: { count: 0, unit: "task" },
+  faded: false,
+  selected: false,
+  ...overrides,
+});
+
+const home: JstackTreeRow = {
+  kind: "domain",
+  key: "jstack-home:flow",
+  parentKey: "jstack-home:root",
+  scope: "flow",
+  threadId: ThreadId.make("flow"),
+  thread: null,
+  open: true,
+  asksYou: false,
+  dot: false,
+  tally: { queue: 0, crew: 1, review: 0 },
+  faded: false,
+  selected: false,
+};
+
+const worker: JstackTreeRow = {
+  kind: "worker",
+  key: "jstack-task:jstack/fl-pump",
+  parentKey: "jstack-home:flow",
+  depth: 2,
+  slug: "pump",
+  prefix: "fl-",
+  word: "crew",
+  tone: "plain",
+  ticks: { step: 1, hollow: false, asks: false },
+  threadId: ThreadId.make("crew-pump"),
+  openThreadId: ThreadId.make("crew-pump"),
+  ask: null,
+  thread: null,
+  pullRequest: null,
+  selected: false,
+};
+
+function actions(): JstackTreeRowActions {
+  return {
+    onOpenThread: vi.fn(),
+    onToggleProject: vi.fn(),
+    onExpandHome: vi.fn(),
+    onNewThread: vi.fn(),
+    onProjectContextMenu: vi.fn(),
+  };
+}
+
+function Tree(props: {
+  rows: ReadonlyArray<[JstackTreeRow, SidebarProjectSnapshot]>;
+  actions: JstackTreeRowActions;
+}) {
+  return (
+    <ul role="tree" className="flex w-[300px] flex-col gap-px bg-sidebar">
+      {props.rows.map(([row, rowGroup]) =>
+        row.kind === "loose" ? null : (
+          <JstackTreeRowView key={row.key} row={row} group={rowGroup} actions={props.actions} />
+        ),
+      )}
+    </ul>
+  );
+}
+
+/** The alpha of a computed colour: 1 for an opaque one. */
+const alphaOf = (color: string) => {
+  const match =
+    /\/\s*([\d.]+)\s*\)$/.exec(color) ?? /rgba\([^,]+,[^,]+,[^,]+,\s*([\d.]+)\)/.exec(color);
+  return match === null ? 1 : Number(match[1]);
+};
+
+/** A row's height and its name's type and ink, as the user sees them. */
+function measure(row: HTMLElement, name: string) {
+  const label = [...row.querySelectorAll("span")].find((span) => span.textContent === name);
+  if (label === undefined) throw new Error(`no label ${name} in the row`);
+  const style = getComputedStyle(label);
+  return {
+    height: row.getBoundingClientRect().height,
+    fontSize: style.fontSize,
+    fontWeight: style.fontWeight,
+    ink: Math.round(alphaOf(style.color) * 100) / 100,
+  };
+}
+
+describe("JstackTreeRowView sizes", () => {
+  it("steps each level down: root 36px 15/650 with 10px above, home 28px 13/450 at 90% ink, worker 24px 12/400 at 70% ink", async () => {
+    await using screen = await render(
+      <Tree
+        actions={actions()}
+        rows={[
+          [root({ key: "jstack-home:infra", main: rootThread }), group("infra")],
+          [root(), group("jstack")],
+          [home, group("jstack")],
+          [worker, group("jstack")],
+        ]}
+      />,
+      { router: false },
+    );
+    const rootRow = screen.container.querySelector<HTMLElement>(
+      '[data-sidebar-row="jstack-home:root"]',
+    )!;
+    const homeRow = screen.container.querySelector<HTMLElement>(
+      '[data-sidebar-row="jstack-home:flow"]',
+    )!;
+    const workerRow = screen.container.querySelector<HTMLElement>(
+      '[data-sidebar-row="jstack-task:jstack/fl-pump"]',
+    )!;
+
+    expect(measure(rootRow, "jstack")).toEqual({
+      height: 36,
+      fontSize: "15px",
+      fontWeight: "650",
+      ink: 1,
+    });
+    expect(getComputedStyle(rootRow.closest("li")!).marginTop).toBe("10px");
+    expect(measure(homeRow, "flow")).toEqual({
+      height: 28,
+      fontSize: "13px",
+      fontWeight: "450",
+      ink: 0.9,
+    });
+    expect(measure(workerRow, "fl-pump")).toEqual({
+      height: 24,
+      fontSize: "12px",
+      fontWeight: "400",
+      ink: 0.7,
+    });
+  });
+});
+
+describe("JstackTreeRowView root rows", () => {
+  it("opens the root home's main thread from a project with a home", async () => {
+    const spies = actions();
+    await using screen = await render(<Tree actions={spies} rows={[[root(), group("jstack")]]} />, {
+      router: false,
+    });
+    await userEvent.click(screen.getByRole("treeitem", { name: "jstack main thread" }));
+    expect(spies.onOpenThread).toHaveBeenCalledWith(ThreadId.make("root"));
+    expect(spies.onToggleProject).not.toHaveBeenCalled();
+  });
+
+  it("folds a project with no home from its name, and offers a new thread in it", async () => {
+    const spies = actions();
+    const winnifred = group("Winnifred");
+    await using screen = await render(
+      <Tree actions={spies} rows={[[root({ key: "folder:Winnifred", main: null }), winnifred]]} />,
+      { router: false },
+    );
+    await userEvent.click(screen.getByRole("treeitem", { name: "Winnifred" }));
+    expect(spies.onToggleProject).toHaveBeenCalledWith(winnifred);
+    expect(spies.onOpenThread).not.toHaveBeenCalled();
+    await userEvent.click(screen.getByRole("button", { name: "New thread in Winnifred" }));
+    expect(spies.onNewThread).toHaveBeenCalledWith(winnifred);
+  });
+
+  it("draws No project as a root row, faded while idle, that counts its folded threads", async () => {
+    await using screen = await render(
+      <Tree
+        actions={actions()}
+        rows={[
+          [
+            root({
+              key: "folder:none",
+              main: null,
+              noProject: true,
+              collapsed: true,
+              faded: true,
+              folded: { count: 2, unit: "thread" },
+            }),
+            group("No project"),
+          ],
+        ]}
+      />,
+      { router: false },
+    );
+    const row = screen.getByRole("treeitem", { name: "No project" }).element() as HTMLElement;
+    expect(measure(row, "No project")).toMatchObject({ height: 36, fontSize: "15px" });
+    expect(row.textContent).toContain("2 threads");
+    expect(getComputedStyle(row.closest("li")!).opacity).toBe("0.5");
+  });
+});
