+it.live("reads the brief jbus keeps for a row, with the sha jbus checks an approval against", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const { roots } = yield* seed;
+    const briefs = path.join(roots.jbus, "jstack", "briefs");
+    yield* fs.makeDirectory(briefs, { recursive: true });
+    // The lines a launch adds to the head are not in the sha; below the first ## they are.
+    const text =
+      "# fl-meter: a meter\nHome: flow\nThread: mcp:crew\nSize: S\nTask: read the meter\n" +
+      "## Result\nHome: kept below the head\n";
+    yield* fs.writeFileString(path.join(briefs, "fl-meter.md"), text);
+    // A brief of a folder jbus has but the tree does not show: no home-id beside it.
+    yield* fs.makeDirectory(path.join(roots.jbus, "other", "briefs"), { recursive: true });
+    yield* fs.writeFileString(path.join(roots.jbus, "other", "work.json"), "{}");
+    yield* fs.writeFileString(path.join(roots.jbus, "other", "briefs", "x.md"), "# x\n");
+    const service = yield* JbusWork.make(roots);
+
+    // jmerge.judgement.brief_sha(text)[:12], as `jbus queue approve --sha` takes it.
+    assert.deepEqual(yield* service.readBrief({ repo: "jstack", slug: "fl-meter", kind: "crew" }), {
+      repo: "jstack",
+      slug: "fl-meter",
+      text,
+      sha: "f7de575cc0d0",
+    });
+    assert.deepEqual(yield* service.readBrief({ repo: "jstack", slug: "gone", kind: "crew" }), {
+      repo: "jstack",
+      slug: "gone",
+      text: null,
+      sha: null,
+    });
+    assert.deepEqual(yield* service.readBrief({ repo: "other", slug: "x", kind: "crew" }), {
+      repo: "other",
+      slug: "x",
+      text: null,
+      sha: null,
+    });
+
+    // A scout's brief is the one its home wrote; jbus keeps no copy of it.
+    const scout = "# probe: look at the meter\nSize: S\n";
+    yield* fs.makeDirectory(path.join(roots.home, "jstack", "scouts"), { recursive: true });
+    yield* fs.writeFileString(path.join(roots.home, "jstack", "scouts", "probe.md"), scout);
+    const read = yield* service.readBrief({ repo: "jstack", slug: "probe", kind: "scout" });
+    assert.equal(read.text, scout);
+    assert.deepEqual(
+      (yield* service.readBrief({ repo: "jstack", slug: "probe", kind: "crew" })).text,
+      null,
+    );
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
