diff --git a/apps/web/src/components/sidebar/JstackBriefDialog.tsx b/apps/web/src/components/sidebar/JstackBriefDialog.tsx
new file mode 100644
index 0000000000..73c01f5eed
--- /dev/null
+++ b/apps/web/src/components/sidebar/JstackBriefDialog.tsx
@@ -0,0 +1,142 @@
+import type { EnvironmentId, JbusBrief, ThreadId } from "@t3tools/contracts";
+import { useState } from "react";
+
+import { serverEnvironment } from "../../state/server";
+import { useAtomCommand } from "../../state/use-atom-command";
+import { Button } from "../ui/button";
+import {
+  Dialog,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogPanel,
+  DialogPopup,
+  DialogTitle,
+} from "../ui/dialog";
+
+// jstack fork: "Open brief" on a tree row. It shows the copy of the brief jbus keeps, which an
+// approval is checked against, and approves that copy by its sha through the task's home.
+
+export interface JstackBriefTarget {
+  readonly environmentId: EnvironmentId;
+  readonly repo: string;
+  readonly kind: "crew" | "scout";
+  /** The task's slug, its home's prefix included. */
+  readonly slug: string;
+  /** The home the brief names, which an approval is sent to. */
+  readonly homeThreadId: ThreadId;
+  readonly homeName: string;
+  /** jbus waits on the user's approval of this brief. */
+  readonly approvable: boolean;
+}
+
+type Read =
+  | { readonly status: "reading" }
+  | { readonly status: "read"; readonly brief: JbusBrief }
+  | { readonly status: "failed" };
+
+interface JstackBriefShown {
+  readonly target: JstackBriefTarget;
+  readonly read: Read;
+}
+
+/**
+ * The brief the sidebar shows, read afresh each time it opens: jbus rewrites a brief when its
+ * home edits it, and nothing watches `briefs/` for that.
+ */
+export function useJstackBrief() {
+  const readBrief = useAtomCommand(serverEnvironment.jbusReadBrief, { reportFailure: false });
+  const [shown, setShown] = useState<JstackBriefShown | null>(null);
+  const open = (target: JstackBriefTarget) => {
+    setShown({ target, read: { status: "reading" } });
+    void readBrief({
+      environmentId: target.environmentId,
+      input: { repo: target.repo, slug: target.slug, kind: target.kind },
+    }).then((result) => {
+      const read: Read =
+        result._tag === "Success" ? { status: "read", brief: result.value } : { status: "failed" };
+      // A read that lands after the user opened another brief, or closed this one, is dropped.
+      setShown((current) => (current?.target === target ? { target, read } : current));
+    });
+  };
+  return { shown, open, close: () => setShown(null) };
+}
+
+function describe(shown: JstackBriefShown): string {
+  const { read, target } = shown;
+  if (read.status === "reading") return "Reading the brief jbus keeps...";
+  if (read.status === "failed") return "The server could not read the brief.";
+  if (read.brief.text === null) return "jbus keeps no brief for this task.";
+  if (target.kind === "scout") return "The brief its home wrote for this scout.";
+  const approve = target.approvable ? ` Approve sends ${target.homeName} your go for it.` : "";
+  return `The copy jbus keeps, brief sha ${read.brief.sha}.${approve}`;
+}
+
+/** Approve, which waits on its send; a new brief draws a new one. */
+function ApproveButton(props: {
+  sha: string | null;
+  onApprove: (sha: string) => Promise<boolean>;
+}) {
+  const [approving, setApproving] = useState(false);
+  const approve = async () => {
+    if (props.sha === null || approving) return;
+    setApproving(true);
+    if (!(await props.onApprove(props.sha))) setApproving(false);
+  };
+  return (
+    <Button disabled={props.sha === null || approving} onClick={() => void approve()}>
+      {approving ? "Sending..." : "Approve this brief"}
+    </Button>
+  );
+}
+
+export function JstackBriefDialog(props: {
+  shown: JstackBriefShown | null;
+  onClose: () => void;
+  /** Sends the task's home its approval of the brief with this sha; true once sent. */
+  onApprove: (target: JstackBriefTarget, sha: string) => Promise<boolean>;
+}) {
+  const { shown } = props;
+  const brief = shown?.read.status === "read" ? shown.read.brief : null;
+  const target = shown?.target ?? null;
+
+  return (
+    <Dialog open={shown !== null} onOpenChange={(open) => (open ? undefined : props.onClose())}>
+      <DialogPopup className="max-w-2xl">
+        <DialogHeader>
+          <DialogTitle>Brief: {target?.slug}</DialogTitle>
+          <DialogDescription>{shown === null ? "" : describe(shown)}</DialogDescription>
+        </DialogHeader>
+        <DialogPanel>
+          {brief?.text ? (
+            // A region, so the keyboard can scroll a long brief and a reader names it.
+            <pre
+              role="region"
+              tabIndex={0}
+              aria-label={`The brief of ${target?.slug}`}
+              className="max-h-[60vh] overflow-auto rounded-md bg-muted/50 p-3 font-mono text-xs leading-relaxed whitespace-pre-wrap text-foreground outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
+            >
+              {brief.text}
+            </pre>
+          ) : null}
+        </DialogPanel>
+        <DialogFooter>
+          <Button variant="outline" onClick={props.onClose}>
+            Close
+          </Button>
+          {target?.approvable ? (
+            <ApproveButton
+              key={`${target.repo}/${target.slug}`}
+              sha={brief?.sha ?? null}
+              onApprove={async (sha) => {
+                const sent = await props.onApprove(target, sha);
+                if (sent) props.onClose();
+                return sent;
+              }}
+            />
+          ) : null}
+        </DialogFooter>
+      </DialogPopup>
+    </Dialog>
+  );
+}
