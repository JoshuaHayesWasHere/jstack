+/** What a row waits on the user for, from jbus's `value` and `who` (features/jbus/src/jbus/work.py). */
+const waitsOnOf = (value: string, who: unknown): JbusWaitsOn | null => {
+  if (who !== "user") return null;
+  if (value === "unapproved") return "approval";
+  if (value === "asking") return "answer";
+  return "word";
+};
+
+/** The lines of a brief's head that jbus adds as it sends one, which its sha leaves out. */
+const SENT_TO = ["Home:", "Thread:", "Green main:", "Stacked on:"];
+
+/**
+ * The text whose sha256 jbus takes for a brief, as `jmerge.judgement.body` reads it: the brief
+ * with no `SENT_TO` line above its first `## ` heading.
+ */
+export const briefBody = (brief: string): string => {
+  let head = true;
+  return (brief.match(/[^\n]*\n|[^\n]+$/g) ?? [])
+    .filter((line) => {
+      head = head && !line.startsWith("## ");
+      return !(head && SENT_TO.some((prefix) => line.startsWith(prefix)));
+    })
+    .join("");
+};
+
 /** The first word of a brief's `Home:` line: `root`, a scope, or a home's thread id. */
 export const homeWord = (line: string): string => {
   const first = line.trim().split(/\s+/)[0] ?? "";
@@ -141,7 +167,7 @@ export const buildRepoWork = (files: JbusRepoFiles, nowMs: number): JbusWorkSnap
