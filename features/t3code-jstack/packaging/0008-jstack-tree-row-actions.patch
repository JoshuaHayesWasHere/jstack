+import { EnvironmentId, ThreadId, type JbusBrief } from "@t3tools/contracts";
+import axe from "axe-core";
+import { describe, expect, it, vi } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+import "~/index.css";
+import { render } from "../../../test/render";
+import { JstackBriefDialog, useJstackBrief, type JstackBriefTarget } from "./JstackBriefDialog";
+
+// What the server's jbus.readBrief answers, read by the test as the dialog asks for it.
+const server = vi.hoisted(() => ({
+  briefs: new Map<string, { text: string | null; sha: string | null }>(),
+  asked: [] as Array<unknown>,
+}));
+vi.mock("../../state/use-atom-command", () => ({
+  useAtomCommand:
+    () =>
+    async (value: {
+      environmentId: string;
+      input: { repo: string; slug: string; kind: string };
+    }) => {
+      server.asked.push(value);
+      const kept = server.briefs.get(value.input.slug) ?? { text: null, sha: null };
+      const brief: JbusBrief = { repo: value.input.repo, slug: value.input.slug, ...kept };
+      return { _tag: "Success" as const, value: brief };
+    },
+}));
+
+const environmentId = EnvironmentId.make("environment-local");
+const BRIEF = "# fl-meter: a meter\nSize: S\nTask: read the meter\n";
+
+const target = (overrides: Partial<JstackBriefTarget> = {}): JstackBriefTarget => ({
+  environmentId,
+  repo: "jstack",
+  kind: "crew",
+  slug: "fl-meter",
+  homeThreadId: ThreadId.make("flow"),
+  homeName: "the flow home",
+  approvable: true,
+  ...overrides,
+});
+
+/** A button that opens the brief, as a row's menu item does, with the sidebar's dialog. */
+function Opener(props: {
+  target: JstackBriefTarget;
+  onApprove: (target: JstackBriefTarget, sha: string) => Promise<boolean>;
+}) {
+  const brief = useJstackBrief();
+  return (
+    <>
+      <button type="button" onClick={() => brief.open(props.target)}>
+        Open brief
+      </button>
+      <JstackBriefDialog shown={brief.shown} onClose={brief.close} onApprove={props.onApprove} />
+    </>
+  );
+}
+
+const audit = async () => {
