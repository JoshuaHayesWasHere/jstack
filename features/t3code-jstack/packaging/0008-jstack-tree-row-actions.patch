   mergeSnapshots,
   readHomeLine,
@@ -34,6 +42,8 @@ export class JbusWork extends Context.Service<
   JbusWork,
   {
     readonly subscribe: Effect.Effect<SnapshotSubscription<JbusWorkSnapshot>, never, Scope.Scope>;
+    /** A task's brief in a repo the tree shows, as `JbusBrief` says where; it only reads. */
+    readonly readBrief: (input: JbusReadBriefInput) => Effect.Effect<JbusBrief>;
   }
 >()("t3/jstack/JbusWork") {}
 
@@ -214,8 +224,23 @@ export const make = Effect.fn("JbusWork.make")(function* (roots: JbusWorkRoots)
     Effect.forkScoped,
   );
 
+  const readBrief = Effect.fn("JbusWork.readBrief")(function* (input: JbusReadBriefInput) {
+    const missing: JbusBrief = { repo: input.repo, slug: input.slug, text: null, sha: null };
+    // Only a repo the tree shows, so no name reaches a folder jbus does not keep.
+    if (!(yield* repos).includes(input.repo)) return missing;
+    const file =
+      input.kind === "scout"
+        ? path.join(roots.home, input.repo, "scouts", `${input.slug}.md`)
+        : path.join(roots.jbus, input.repo, "briefs", `${input.slug}.md`);
+    const text = yield* fs.readFileString(file).pipe(Effect.orElseSucceed(() => null));
+    if (text === null) return missing;
+    const sha = NodeCrypto.createHash("sha256").update(briefBody(text)).digest("hex").slice(0, 12);
+    return { ...missing, text, sha };
+  });
+
   return JbusWork.of({
     subscribe: subscribeBeforeSnapshot(changes, Ref.get(state), mutex),
+    readBrief,
   });
 });
 
