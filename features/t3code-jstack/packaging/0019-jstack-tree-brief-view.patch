new file mode 100644
index 0000000000..bc24b15941
--- /dev/null
+++ b/apps/web/src/components/sidebar/jstackBrief.logic.ts
@@ -0,0 +1,213 @@
+// jstack fork: a brief read as its lines, for the "Open brief" dialog. The names are those of
+// jstack's `templates/brief.md` and `templates/scout-request.md`, the lines jbus adds as it sends
+// one (`SENT_TO`: Home, Thread, Green main, Stacked on) and `Follows:`, which the home's queue
+// writes. Each name's place in the dialog and how it draws are one row of BRIEF_LINES.
+
+/**
+ * Where a line shows: as a chip under the one line, as the caution band under the chips, in the
+ * body in the brief's own order, or under "More".
+ */
+export type BriefPlace = "chip" | "caution" | "body" | "more";
+
+/** How a line's value draws. */
+export type BriefLook = "quote" | "checklist" | "numbered" | "list" | "files" | "links" | "text";
+
+export const BRIEF_LINES = {
+  Task: { place: "body", look: "quote" },
+  Request: { place: "body", look: "quote" },
+  "Done when": { place: "body", look: "checklist" },
+  Questions: { place: "body", look: "numbered" },
+  Deliver: { place: "body", look: "list" },
+  "Proves it": { place: "body", look: "text" },
+  Where: { place: "body", look: "files" },
+  "Builds on": { place: "body", look: "links" },
+  Follows: { place: "body", look: "links" },
+  Size: { place: "chip", look: "text" },
+  Review: { place: "chip", look: "text" },
+  Playbook: { place: "chip", look: "text" },
+  "Pull request": { place: "chip", look: "text" },
+  Home: { place: "chip", look: "text" },
+  "Do not touch": { place: "caution", look: "text" },
+  "Out of bounds": { place: "caution", look: "text" },
+  Decisions: { place: "more", look: "text" },
+  Design: { place: "more", look: "text" },
+  Skills: { place: "more", look: "text" },
+  Read: { place: "more", look: "text" },
+  Change: { place: "more", look: "text" },
+  "Rests on": { place: "more", look: "text" },
+  Sources: { place: "more", look: "text" },
+  "Ruled out": { place: "more", look: "text" },
+  Thread: { place: "more", look: "text" },
+  "Green main": { place: "more", look: "text" },
+  "Stacked on": { place: "more", look: "text" },
+} as const satisfies Record<string, { place: BriefPlace; look: BriefLook }>;
+
+export type BriefLineName = keyof typeof BRIEF_LINES;
+
+/** The chips, in the order they draw, whatever order the brief writes them in. */
+export const BRIEF_CHIPS: ReadonlyArray<BriefLineName> = [
+  "Size",
+  "Review",
+  "Playbook",
+  "Pull request",
+  "Home",
+];
+
+export type BriefLine =
+  | {
+      readonly kind: "known";
+      readonly name: BriefLineName;
+      readonly value: string;
+      /** The `- ` list under it. */
+      readonly items: ReadonlyArray<string>;
+    }
+  | {
+      /** A line no template names, kept as written, with the list under it. */
+      readonly kind: "other";
+      /** Its line in the file, from 0, which keys it. */
+      readonly at: number;
+      readonly text: string;
+      readonly items: ReadonlyArray<string>;
+    };
+
+export interface BriefSection {
+  /** Its `## ` line in the file, from 0, which keys it. */
+  readonly at: number;
+  readonly heading: string;
+  /** The section's Markdown, as written. */
+  readonly text: string;
+}
+
+export interface ParsedBrief {
+  /** The one line of `# <slug>: <one line>`. */
+  readonly title: string | null;
+  /** The lines above the first `## `, in the brief's order. */
+  readonly head: ReadonlyArray<BriefLine>;
+  /** Each `## ` section after the head: Report, Result, Review. */
+  readonly sections: ReadonlyArray<BriefSection>;
+}
+
+// jbus's own label grammar (`jbriefs/parse.py` `_LABEL`): a capitalised label of up to four words.
+const LABEL = /^([A-Z][A-Za-z]*(?:[ -][A-Za-z]+){0,3}):(?:[ \t]+|$)/;
+const ITEM = /^\s*- /;
+
+const isKnown = (name: string): name is BriefLineName => Object.hasOwn(BRIEF_LINES, name);
+
+export function parseBrief(text: string): ParsedBrief {
+  const lines = text.split("\n");
+  let title: string | null = null;
+  const order: Array<{ line: BriefLine; items: string[] }> = [];
+  const seen = new Set<BriefLineName>();
+  let index = 0;
+  for (; index < lines.length; index += 1) {
+    const line = lines[index] ?? "";
+    if (line.startsWith("## ")) break;
+    if (index === 0 && line.startsWith("# ")) {
+      const named = /^#\s+[^\s:]+:\s*(.*)$/.exec(line);
+      title = named ? (named[1] ?? null) : line.slice(2).trim();
+      continue;
+    }
+    if (line.trim() === "") continue;
+    const last = order.at(-1);
+    if (ITEM.test(line) && last !== undefined) {
+      last.items.push(line.replace(ITEM, ""));
+      continue;
+    }
+    const label = LABEL.exec(line);
+    const name = label?.[1];
+    // A name's first line is the one jbus reads; a second is kept as written.
+    if (label && name !== undefined && isKnown(name) && !seen.has(name)) {
+      seen.add(name);
+      const items: string[] = [];
+      order.push({
+        line: { kind: "known", name, value: line.slice(label[0].length).trim(), items },
+        items,
+      });
+      continue;
+    }
+    const items: string[] = [];
+    order.push({ line: { kind: "other", at: index, text: line.trim(), items }, items });
+  }
+  const sections: Array<{ at: number; heading: string; lines: string[] }> = [];
+  for (; index < lines.length; index += 1) {
+    const line = lines[index] ?? "";
+    if (line.startsWith("## "))
+      sections.push({ at: index, heading: line.slice(3).trim(), lines: [] });
+    else sections.at(-1)?.lines.push(line);
+  }
+  return {
+    title,
+    head: order.map((each) => each.line),
+    sections: sections.map((section) => ({
+      at: section.at,
+      heading: section.heading,
+      text: section.lines.join("\n").trim(),
+    })),
+  };
+}
+
+/** A line of the brief by its name, or null. */
+export const briefLine = (
+  brief: ParsedBrief,
+  name: BriefLineName,
+): Extract<BriefLine, { kind: "known" }> | null =>
+  brief.head.find(
+    (line): line is Extract<BriefLine, { kind: "known" }> =>
+      line.kind === "known" && line.name === name,
+  ) ?? null;
+
+/** Where a line of the head draws: an unknown line stays in the body, where it was written. */
+export const briefPlace = (line: BriefLine): BriefPlace =>
+  line.kind === "known" ? BRIEF_LINES[line.name].place : "body";
+
+/** A chip's value: its first clause, as `twice` of `twice, then ...`. */
+export const chipValue = (value: string): string => value.split(/[,(;]/)[0]?.trim() || value;
+
+export interface InlinePart {
+  /** Where it starts in the text, which keys it. */
+  readonly at: number;
+  readonly code: boolean;
+  readonly text: string;
+}
+
+/** Text with its `code` spans apart, so each draws as a chip. */
+export function inlineParts(text: string): ReadonlyArray<InlinePart> {
+  const parts: Array<InlinePart> = [];
+  let at = 0;
+  for (const part of text.split(/(`[^`]+`)/)) {
+    if (part !== "") {
+      const code = part.length > 2 && part.startsWith("`") && part.endsWith("`");
+      parts.push({ at, code, text: code ? part.slice(1, -1) : part });
+    }
+    at += part.length;
+  }
+  return parts;
+}
+
+/** A `Where:` line as file chips, with the words between kept beside them. */
+export const whereParts = (value: string): ReadonlyArray<InlinePart> =>
+  inlineParts(value)
+    .map((part) => (part.code ? part : { ...part, text: part.text.trim() }))
+    .filter((part) => part.code || part.text !== "");
+
+export interface BriefLink {
+  readonly slug: string;
+  /** What of that row's work this one starts from; empty for a bare slug. */
+  readonly what: string;
+}
+
+/**
+ * `Builds on:` is `<slug>: <what>; <slug>: <what>`, and `Follows:` a bare slug, which jbus reads
+ * back as it is. Each names a row the dialog links to.
+ */
+export const briefLinks = (value: string): ReadonlyArray<BriefLink> =>
+  value
+    .split(/;\s*/)
+    .map((item) => item.trim())
+    .filter((item) => item !== "")
+    .map((item) => {
+      const colon = item.indexOf(": ");
+      return colon === -1
+        ? { slug: item.replace(/:$/, "").trim(), what: "" }
+        : { slug: item.slice(0, colon).trim(), what: item.slice(colon + 2).trim() };
+    });
