diff --git a/apps/web/src/components/sidebar/JstackBriefView.tsx b/apps/web/src/components/sidebar/JstackBriefView.tsx
new file mode 100644
index 0000000000..e6bc7e3c86
--- /dev/null
+++ b/apps/web/src/components/sidebar/JstackBriefView.tsx
@@ -0,0 +1,317 @@
+import { ChevronRightIcon, TriangleAlertIcon } from "lucide-react";
+import type { ReactNode } from "react";
+
+import { Collapsible, CollapsiblePanel, CollapsibleTrigger } from "../ui/collapsible";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+import {
+  BRIEF_CHIPS,
+  BRIEF_LINES,
+  briefLine,
+  briefLinks,
+  briefPlace,
+  chipValue,
+  inlineParts,
+  parseBrief,
+  whereParts,
+  type BriefLine,
+} from "./jstackBrief.logic";
+
+// jstack fork: a brief drawn as what it says, in one column. The one line, then Size, Review,
+// Playbook, Pull request and Home as chips, then what is out of bounds, then the brief's own lines
+// in its order, each under an 11px label; the rest under "More", each `## ` section folded, and
+// the Markdown one click away. Type is 13/400 and 11/400 only, and sky is on the row links only.
+
+export interface JstackBriefViewProps {
+  readonly text: string;
+  readonly slug: string;
+  /** A `Builds on:` or `Follows:` row the tree has, so its link can show it. */
+  readonly revealable: (slug: string) => boolean;
+  readonly onReveal: (slug: string) => void;
+}
+
+const LABEL = "mb-1 text-2xs text-muted-foreground";
+const FOCUS = "outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring";
+
+/** Text with its `code` spans as 11px mono chips. */
+function Inline(props: { text: string }) {
+  return inlineParts(props.text).map((part) =>
+    part.code ? (
+      <code key={part.at} className="rounded-sm bg-muted px-1 font-mono text-2xs break-all">
+        {part.text}
+      </code>
+    ) : (
+      <span key={part.at}>{part.text}</span>
+    ),
+  );
+}
+
+/** A list as written; a line's items are its own, so their text keys them. */
+function Items(props: { items: ReadonlyArray<string>; look: "checklist" | "numbered" | "list" }) {
+  const keyed = props.items.map((item, index) => ({ item, key: `${index}:${item}` }));
+  if (props.look === "numbered") {
+    return (
+      <ol className="list-decimal space-y-1 pl-5">
+        {keyed.map(({ item, key }) => (
+          <li key={key}>
+            <Inline text={item} />
+          </li>
+        ))}
+      </ol>
+    );
+  }
+  if (props.look === "list") {
+    return (
+      <ul className="list-disc space-y-1 pl-5">
+        {keyed.map(({ item, key }) => (
+          <li key={key}>
+            <Inline text={item} />
+          </li>
+        ))}
+      </ul>
+    );
+  }
+  return (
+    <ul className="space-y-1.5">
+      {keyed.map(({ item, key }) => (
+        <li key={key} className="flex gap-2">
+          <span
+            aria-hidden
+            className="mt-0.5 size-3 shrink-0 rounded-sm border border-muted-foreground"
+          />
+          <span className="min-w-0">
+            <Inline text={item} />
+          </span>
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function Files(props: { value: string }) {
+  return (
+    <div className="flex flex-wrap items-baseline gap-1">
+      {whereParts(props.value).map((part) =>
+        part.code ? (
+          <code
+            key={part.at}
+            className="rounded-sm border border-border px-1.5 py-0.5 font-mono text-2xs break-all"
+          >
+            {part.text}
+          </code>
+        ) : (
+          <span key={part.at} className="text-2xs text-muted-foreground">
+            {part.text}
+          </span>
+        ),
+      )}
+    </div>
+  );
+}
+
+function Links(props: { value: string } & Pick<JstackBriefViewProps, "revealable" | "onReveal">) {
+  return (
+    <ul className="space-y-0.5">
+      {briefLinks(props.value).map((link) => (
+        <li key={link.slug}>
+          {props.revealable(link.slug) ? (
+            <Tooltip>
+              <TooltipTrigger
+                render={
+                  <button
+                    type="button"
+                    onClick={() => props.onReveal(link.slug)}
+                    className={`rounded-sm text-jstack-link underline-offset-4 hover:underline ${FOCUS}`}
+                  >
+                    {link.slug}
+                  </button>
+                }
+              />
+              <TooltipPopup>Show {link.slug} in the tree</TooltipPopup>
+            </Tooltip>
+          ) : (
+            <>
+              <span>{link.slug}</span>{" "}
+              <span className="text-2xs text-muted-foreground">not in the tree</span>
+            </>
+          )}
+          {link.what === "" ? null : (
+            <span className="text-muted-foreground">
+              {": "}
+              <Inline text={link.what} />
+            </span>
+          )}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+const unquoted = (value: string) =>
+  value.length > 1 && value.startsWith('"') && value.endsWith('"') ? value.slice(1, -1) : value;
+
+/**
+ * A line's value, drawn the way its name asks, with the `- ` list under it: a list look draws
+ * the items its own way, and every other look draws them as a plain list after the value.
+ */
+function Value(props: { line: BriefLine } & Pick<JstackBriefViewProps, "revealable" | "onReveal">) {
+  const { line } = props;
+  const look = line.kind === "known" ? BRIEF_LINES[line.name].look : "text";
+  const value = line.kind === "known" ? line.value : line.text;
+  if (look === "checklist" || look === "numbered" || look === "list") {
+    return (
+      <div className="space-y-1">
+        {value === "" ? null : (
+          <p>
+            <Inline text={value} />
+          </p>
+        )}
+        <Items items={line.items} look={look} />
+      </div>
+    );
+  }
+  return (
+    <div className="space-y-1">
+      {value === "" ? null : look === "quote" ? (
+        <blockquote className="border-l-2 border-border pl-3">
+          <Inline text={unquoted(value)} />
+        </blockquote>
+      ) : look === "files" ? (
+        <Files value={value} />
+      ) : look === "links" ? (
+        <Links value={value} revealable={props.revealable} onReveal={props.onReveal} />
+      ) : (
+        <p>
+          <Inline text={value} />
+        </p>
+      )}
+      {line.items.length === 0 ? null : <Items items={line.items} look="list" />}
+    </div>
+  );
+}
+
+/** A head line under its label; an unknown line is its own label, as written. */
+function Line(props: { line: BriefLine } & Pick<JstackBriefViewProps, "revealable" | "onReveal">) {
+  const { line } = props;
+  if (line.kind === "other") {
+    return (
+      <section>
+        <Value {...props} />
+      </section>
+    );
+  }
+  return (
+    <section aria-label={line.name}>
+      <h3 className={LABEL}>{line.name}</h3>
+      <Value {...props} />
+    </section>
+  );
+}
+
+function Fold(props: { label: string; children: ReactNode }) {
+  return (
+    <Collapsible>
+      <CollapsibleTrigger
+        className={`group flex items-center gap-1 rounded-sm text-2xs text-muted-foreground hover:text-foreground ${FOCUS}`}
+      >
+        <ChevronRightIcon
+          aria-hidden
+          className="size-3 transition-transform group-data-panel-open:rotate-90"
+        />
+        {props.label}
+      </CollapsibleTrigger>
+      <CollapsiblePanel animate={false}>
+        <div className="space-y-3 pt-2">{props.children}</div>
+      </CollapsiblePanel>
+    </Collapsible>
+  );
+}
+
+const MARKDOWN = "whitespace-pre-wrap font-mono text-2xs";
+
+export function JstackBriefView(props: JstackBriefViewProps) {
+  const brief = parseBrief(props.text);
+  const chips = BRIEF_CHIPS.flatMap((name) => {
+    const line = briefLine(brief, name);
+    return line === null ? [] : [line];
+  });
+  const caution = brief.head.filter((line) => briefPlace(line) === "caution");
+  const body = brief.head.filter((line) => briefPlace(line) === "body");
+  const more = brief.head.filter((line) => briefPlace(line) === "more");
+  const links = { revealable: props.revealable, onReveal: props.onReveal };
+  // A known line is keyed by its name, which a brief has once, and an unknown one by its place.
+  const keyOf = (line: BriefLine) => (line.kind === "known" ? line.name : `line-${line.at}`);
+
+  return (
+    <div
+      role="region"
+      aria-label={`The brief of ${props.slug}`}
+      className="space-y-4 text-tree-row font-normal text-foreground"
+    >
+      <div className="space-y-2">
+        {/* The dialog's title names the slug: this is the brief's one line. */}
+        <p>{brief.title ?? props.slug}</p>
+        {chips.length === 0 ? null : (
+          <ul aria-label="At a glance" className="flex flex-wrap gap-1">
+            {chips.map((line) => (
+              <li
+                key={line.name}
+                className="inline-flex items-baseline gap-1 rounded-full border border-border px-2 py-0.5 text-2xs"
+              >
+                <span className="text-muted-foreground">
+                  {line.name === "Pull request" ? "PR" : line.name}
+                </span>{" "}
+                <span>{chipValue(line.value)}</span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+      {caution.map((line) =>
+        line.kind === "known" ? (
+          <div
+            key={line.name}
+            role="note"
+            aria-label={line.name}
+            className="flex gap-2 rounded-md border border-border bg-muted px-3 py-2"
+          >
+            <TriangleAlertIcon aria-hidden className="mt-0.5 size-3 shrink-0" />
+            <div className="min-w-0">
+              <div className={LABEL}>{line.name}</div>
+              <Value line={line} {...links} />
+            </div>
+          </div>
+        ) : null,
+      )}
+      {body.map((line) => (
+        <Line key={keyOf(line)} line={line} {...links} />
+      ))}
+      <div className="space-y-2 border-t border-border pt-3">
+        {more.length === 0 ? null : (
+          <Fold
+            label={`More: ${more.map((line) => (line.kind === "known" ? line.name : "")).join(", ")}`}
+          >
+            {more.map((line) => (
+              <Line key={keyOf(line)} line={line} {...links} />
+            ))}
+          </Fold>
+        )}
+        {brief.sections.map((section) => (
+          <Fold key={section.at} label={section.heading}>
+            <div className={MARKDOWN}>{section.text}</div>
+          </Fold>
+        ))}
+        <Fold label="Markdown">
+          {/* A region, so the keyboard can scroll a long brief and a reader names it. */}
+          <pre
+            role="region"
+            tabIndex={0}
+            aria-label={`The Markdown of ${props.slug}`}
+            className={`rounded-md bg-muted p-3 ${MARKDOWN} ${FOCUS}`}
+          >
+            {props.text}
+          </pre>
+        </Fold>
+      </div>
+    </div>
+  );
+}
