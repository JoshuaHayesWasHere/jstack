@@ -0,0 +1,149 @@
+import {
+  JstackTreeAttention,
+  MAX_JSTACK_TREE_QUIET_MINUTES,
+  MAX_JSTACK_TREE_ROW_CAP,
+  MIN_JSTACK_TREE_QUIET_MINUTES,
+  MIN_JSTACK_TREE_ROW_CAP,
+} from "@t3tools/contracts";
+import { useState } from "react";
+
+import { Input } from "../ui/input";
+import { Select, SelectItem, SelectPopup, SelectTrigger, SelectValue } from "../ui/select";
+import { Switch } from "../ui/switch";
+import { SettingsRow, SettingsSection } from "./settingsLayout";
+import { searchableSetting } from "./settingsSearch";
+import { useScopedSettings, useUpdateScopedSettings } from "./useScopedSettings";
+
+const ATTENTION_LABELS: Record<JstackTreeAttention, string> = {
+  gates: "Gates only",
+  "gates-and-quiet": "Gates and quiet tasks",
+};
+
+const isAttention = (value: unknown): value is JstackTreeAttention =>
+  JstackTreeAttention.literals.some((literal) => literal === value);
+
+function WholeNumberInput(props: {
+  value: number;
+  min: number;
+  max: number;
+  label: string;
+  disabled: boolean;
+  onCommit: (value: number) => void;
+}) {
+  const [draft, setDraft] = useState(String(props.value));
+  const [draftSource, setDraftSource] = useState(props.value);
+  if (draftSource !== props.value) {
+    setDraftSource(props.value);
+    setDraft(String(props.value));
+  }
+  return (
+    <Input
+      size="sm"
+      type="number"
+      min={props.min}
+      max={props.max}
+      className="w-full sm:w-24"
+      value={draft}
+      disabled={props.disabled}
+      onChange={(event) => {
+        setDraft(event.target.value);
+        const parsed = Number(event.target.value);
+        if (Number.isInteger(parsed) && parsed >= props.min && parsed <= props.max) {
+          props.onCommit(parsed);
+        }
+      }}
+      onBlur={() => setDraft(String(props.value))}
+      aria-label={props.label}
+    />
+  );
+}
+
+/** jstack fork: the tree sidebar and what it calls out. */
+export function JstackTreeSettingsSection() {
+  const settings = useScopedSettings();
+  const updateSettings = useUpdateScopedSettings();
+  const off = !settings.jstackTreeSidebarEnabled;
+  return (
+    <SettingsSection id="jstack" title="jstack">
+      <SettingsRow
+        {...searchableSetting("jstack-tree-sidebar")}
+        description="Draw each jstack project as one tree: its main thread, its domain homes, and the jbus tasks under each home with their stage. Projects without a jstack home keep their folder."
+        control={
+          <Switch
+            checked={settings.jstackTreeSidebarEnabled}
+            onCheckedChange={(checked) =>
+              updateSettings({ jstackTreeSidebarEnabled: Boolean(checked) })
+            }
+            aria-label="jstack tree sidebar"
+          />
+        }
+      />
+      <SettingsRow
+        {...searchableSetting("jstack-tree-attention")}
+        description="What the tree raises above the rest. A gate is a jbus question waiting on you. A quiet task has not written for a while."
+        control={
+          <Select
+            value={settings.jstackTreeAttention}
+            disabled={off}
+            onValueChange={(value) => {
+              if (isAttention(value)) updateSettings({ jstackTreeAttention: value });
+            }}
+          >
+            <SelectTrigger size="sm" className="w-full sm:w-52" aria-label="What needs you">
+              <SelectValue>{ATTENTION_LABELS[settings.jstackTreeAttention]}</SelectValue>
+            </SelectTrigger>
+            <SelectPopup align="end" alignItemWithTrigger={false}>
+              {JstackTreeAttention.literals.map((attention) => (
+                <SelectItem hideIndicator key={attention} value={attention}>
+                  {ATTENTION_LABELS[attention]}
+                </SelectItem>
+              ))}
+            </SelectPopup>
+          </Select>
+        }
+      />
+      <SettingsRow
+        {...searchableSetting("jstack-tree-quiet-minutes")}
+        description="Minutes without a write before a crew task reads as quiet."
+        control={
+          <WholeNumberInput
+            value={settings.jstackTreeQuietMinutes}
+            min={MIN_JSTACK_TREE_QUIET_MINUTES}
+            max={MAX_JSTACK_TREE_QUIET_MINUTES}
+            label="Minutes before a task is quiet"
+            disabled={off || settings.jstackTreeAttention === "gates"}
+            onCommit={(minutes) => updateSettings({ jstackTreeQuietMinutes: minutes })}
+          />
+        }
+      />
+      <SettingsRow
+        {...searchableSetting("jstack-tree-landed-count")}
+        description="Show how many tasks merged since you last opened the project's main thread."
+        control={
+          <Switch
+            checked={settings.jstackTreeLandedCount}
+            disabled={off}
+            onCheckedChange={(checked) =>
+              updateSettings({ jstackTreeLandedCount: Boolean(checked) })
+            }
+            aria-label="Landed count"
+          />
+        }
+      />
+      <SettingsRow
+        {...searchableSetting("jstack-tree-row-cap")}
+        description="Task rows per home before the rest fold into a +N row."
+        control={
+          <WholeNumberInput
+            value={settings.jstackTreeRowCap}
+            min={MIN_JSTACK_TREE_ROW_CAP}
+            max={MAX_JSTACK_TREE_ROW_CAP}
+            label="Task rows per home"
+            disabled={off}
+            onCommit={(rows) => updateSettings({ jstackTreeRowCap: rows })}
+          />
+        }
+      />
+    </SettingsSection>
+  );
+}
