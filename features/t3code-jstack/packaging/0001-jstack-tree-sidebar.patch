@@ -0,0 +1,270 @@
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import type { ThreadId } from "@t3tools/contracts";
+import { ChevronDownIcon } from "lucide-react";
+import { memo, type MouseEvent, type ReactNode } from "react";
+
+import { cn } from "~/lib/utils";
+import type { SidebarProjectSnapshot } from "../../sidebarProjectGrouping";
+import { ProjectFavicon } from "../ProjectFavicon";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+import type { JstackTally, JstackTicks, JstackTreeRow } from "./jstackTree.logic";
+import { RelativeTimeLabel, threadTimeTimestamp } from "./SidebarThreadRow";
+
+// jstack fork: the tree sidebar's rows. Amber is the only colour, and only for what waits on you.
+
+type TreeRow = Exclude<JstackTreeRow, { kind: "loose" }>;
+
+export interface JstackTreeRowActions {
+  readonly onOpenThread: (threadId: ThreadId) => void;
+  readonly onToggleProject: (group: SidebarProjectSnapshot) => void;
+  readonly onExpandHome: (homeKey: string) => void;
+}
+
+const ROW_BUTTON =
+  "flex w-full min-w-0 items-center gap-2 rounded-(--control-radius) px-2 text-left outline-none hover:bg-sidebar-row-hover focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring";
+
+/** The rule and indent of a nested row, once per level. */
+function Nest(props: { depth: number; children: ReactNode }) {
+  if (props.depth === 0) return props.children;
+  return (
+    <div className="ml-4 border-l border-sidebar-border/70 pl-2">
+      <Nest depth={props.depth - 1}>{props.children}</Nest>
+    </div>
+  );
+}
+
+function Ticks(props: { ticks: JstackTicks }) {
+  const { step, hollow, asks } = props.ticks;
+  return (
+    <span aria-hidden className="flex shrink-0 gap-0.5">
+      {[0, 1, 2, 3].map((index) => (
+        <i
+          key={index}
+          className={cn(
+            "block h-[3px] w-[7px] rounded-full",
+            index < step && "bg-sidebar-foreground/60",
+            index > step && "bg-sidebar-muted-foreground/35",
+            index === step &&
+              (asks
+                ? "bg-warning"
+                : hollow
+                  ? "bg-transparent ring-1 ring-inset ring-sidebar-muted-foreground/70"
+                  : "bg-sidebar-foreground"),
+          )}
+        />
+      ))}
+    </span>
+  );
+}
+
+function AsksYou() {
+  return <span className="shrink-0 text-2xs text-warning">asks you</span>;
+}
+
+function GateDot() {
+  return (
+    <span className="size-1.5 shrink-0 rounded-full bg-warning">
+      <span className="sr-only">, something inside asks you</span>
+    </span>
+  );
+}
+
+function Tally(props: { tally: JstackTally }) {
+  const parts = (["crew", "review", "queue"] as const).filter((stage) => props.tally[stage] > 0);
+  return (
+    <div className="flex gap-2.5 px-2 pb-1 text-2xs text-sidebar-muted-foreground">
+      {parts.length === 0 ? (
+        <span>idle</span>
+      ) : (
+        parts.map((stage) => (
+          <span key={stage}>
+            {stage} <b className="font-semibold text-sidebar-foreground/75">{props.tally[stage]}</b>
+          </span>
+        ))
+      )}
+    </div>
+  );
+}
+
+function TimeLabel(props: { thread: EnvironmentThreadShell | null }) {
+  if (props.thread === null) return null;
+  return (
+    <span className="shrink-0 text-2xs tabular-nums text-sidebar-muted-foreground">
+      <RelativeTimeLabel timestamp={threadTimeTimestamp(props.thread)} />
+    </span>
+  );
+}
+
+/** One tree row. Arrow keys reach rows through an untrusted click, which folds instead. */
+export const JstackTreeRowView = memo(function JstackTreeRowView(props: {
+  row: TreeRow;
+  group: SidebarProjectSnapshot;
+  actions: JstackTreeRowActions;
+}) {
+  const { row, group, actions } = props;
+  const open = (threadId: ThreadId | null) => (event: MouseEvent) => {
+    if (row.kind === "project" && !event.nativeEvent.isTrusted) {
+      actions.onToggleProject(group);
+      return;
+    }
+    if (threadId !== null) actions.onOpenThread(threadId);
+  };
+
+  switch (row.kind) {
+    case "project":
+      return (
+        <li
+          data-testid="jstack-tree-project"
+          className={cn("relative mt-2 list-none first:mt-0", row.faded && "opacity-50")}
+        >
+          <button
+            type="button"
+            role="treeitem"
+            tabIndex={-1}
+            data-sidebar-row={row.key}
+            aria-expanded={!row.collapsed}
+            aria-selected={row.selected}
+            aria-label={`${group.displayName} main thread${row.asksYou || row.dot ? ", asks you" : ""}`}
+            onClick={open(row.thread.id)}
+            className={cn(ROW_BUTTON, "h-8 pr-8", row.selected && "bg-sidebar-row-selected")}
+          >
+            <ProjectFavicon project={group} className="size-4 shrink-0" />
+            <span className="min-w-0 flex-1 truncate text-sm font-semibold text-sidebar-foreground">
+              {group.displayName}
+            </span>
+            {row.landed > 0 ? (
+              <span className="shrink-0 text-2xs tabular-nums text-sidebar-muted-foreground">
+                {row.landed} merged
+              </span>
+            ) : null}
+            {row.asksYou ? <AsksYou /> : row.dot ? <GateDot /> : null}
+            {row.collapsed && row.taskCount > 0 ? (
+              <span className="shrink-0 text-2xs tabular-nums text-sidebar-muted-foreground">
+                {row.taskCount} {row.taskCount === 1 ? "task" : "tasks"}
+              </span>
+            ) : (
+              <TimeLabel thread={row.thread} />
+            )}
+          </button>
+          <span className="absolute inset-y-0 right-1 flex items-center">
+            <button
+              type="button"
+              data-sidebar-action-for={row.key}
+              aria-label={
+                row.collapsed ? `Unfold ${group.displayName}` : `Fold ${group.displayName}`
+              }
+              onClick={() => actions.onToggleProject(group)}
+              className="flex size-6 items-center justify-center rounded-(--control-radius) text-sidebar-muted-foreground outline-none hover:bg-sidebar-row-hover hover:text-sidebar-foreground focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
+            >
+              <ChevronDownIcon
+                aria-hidden
+                className={cn("size-3.5 transition-transform", row.collapsed && "-rotate-90")}
+              />
+            </button>
+          </span>
+        </li>
+      );
+    case "domain":
+      return (
+        <li className={cn("list-none", row.faded && "opacity-50")}>
+          <Nest depth={1}>
+            <button
+              type="button"
+              role="treeitem"
+              tabIndex={-1}
+              data-sidebar-row={row.key}
+              data-sidebar-parent={row.parentKey}
+              aria-expanded={row.open}
+              aria-selected={row.selected}
+              aria-label={`${row.scope} home${row.asksYou || row.dot ? ", asks you" : ""}`}
+              onClick={open(row.threadId)}
+              className={cn(ROW_BUTTON, "h-7", row.selected && "bg-sidebar-row-selected")}
+            >
+              <span className="min-w-0 flex-1 truncate text-sm font-medium text-sidebar-foreground">
+                {row.scope}
+              </span>
+              {row.asksYou ? <AsksYou /> : row.dot ? <GateDot /> : null}
+              <TimeLabel thread={row.thread} />
+            </button>
+            {row.open ? null : <Tally tally={row.tally} />}
+          </Nest>
+        </li>
+      );
+    case "worker": {
+      const fullSlug = `${row.prefix ?? ""}${row.slug}`;
+      return (
+        <li className="list-none">
+          <Nest depth={row.depth}>
+            <Tooltip>
+              <TooltipTrigger
+                render={
+                  <button
+                    type="button"
+                    role="treeitem"
+                    tabIndex={-1}
+                    data-sidebar-row={row.key}
+                    data-sidebar-parent={row.parentKey}
+                    aria-selected={row.selected}
+                    aria-disabled={row.threadId === null}
+                    aria-label={`${fullSlug}, ${row.word}${row.ticks === null ? "" : " stage"}`}
+                    onClick={open(row.threadId)}
+                    className={cn(
+                      ROW_BUTTON,
+                      "h-6 text-xs",
+                      row.threadId === null && "cursor-default hover:bg-transparent",
+                      row.selected && "bg-sidebar-row-selected",
+                    )}
+                  >
+                    <span className="min-w-0 flex-1 truncate text-sidebar-foreground/75">
+                      {row.prefix ? (
+                        <span className="text-sidebar-muted-foreground/60">{row.prefix}</span>
+                      ) : null}
+                      {row.slug}
+                    </span>
+                    <span
+                      className={cn(
+                        "shrink-0 text-2xs",
+                        row.tone === "asks" ? "text-warning" : "text-sidebar-muted-foreground",
+                      )}
+                    >
+                      {row.word}
+                    </span>
+                    {row.ticks === null ? (
+                      <span
+                        aria-hidden
+                        className="mx-[13px] size-1.5 shrink-0 rounded-full bg-sidebar-muted-foreground/60"
+                      />
+                    ) : (
+                      <Ticks ticks={row.ticks} />
+                    )}
+                  </button>
+                }
+              />
+              <TooltipPopup side="right">
+                {[fullSlug, row.pullRequest, row.word].filter(Boolean).join(" · ")}
+              </TooltipPopup>
+            </Tooltip>
+          </Nest>
+        </li>
+      );
+    }
+    case "more":
+      return (
+        <li className="list-none">
+          <Nest depth={row.depth}>
+            <button
+              type="button"
+              role="treeitem"
+              tabIndex={-1}
+              data-sidebar-row={row.key}
+              data-sidebar-parent={row.parentKey}
+              onClick={() => actions.onExpandHome(row.homeKey)}
+              className={cn(ROW_BUTTON, "h-6 text-2xs text-sidebar-muted-foreground")}
+            >
+              +{row.count} more
+            </button>
+          </Nest>
+        </li>
+      );
+  }
+});
