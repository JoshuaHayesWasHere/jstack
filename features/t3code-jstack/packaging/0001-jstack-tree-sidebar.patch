+import * as Schema from "effect/Schema";
+
+import { IsoDateTime, ThreadId, TrimmedNonEmptyString } from "./baseSchemas.ts";
+
+// jstack fork: what jbus (~/.local/state/jbus) and jstack homes (~/.local/state/home) say about
+// each thread, read by the server so remote clients see the same tree.
+
+/** One word, as the tree sidebar prints it. */
+export const JbusWorkStage = Schema.Literals(["ready", "behind", "crew", "quiet", "review"]);
+export type JbusWorkStage = typeof JbusWorkStage.Type;
+
+export const JbusHome = Schema.Struct({
+  repo: TrimmedNonEmptyString,
+  /** null for the repo's root home. */
+  scope: Schema.NullOr(TrimmedNonEmptyString),
+  threadId: ThreadId,
+  /** The slug prefix this home's briefs carry, such as `fl-`. */
+  prefix: Schema.NullOr(TrimmedNonEmptyString),
+});
+export type JbusHome = typeof JbusHome.Type;
+
+export const JbusTask = Schema.Struct({
+  repo: TrimmedNonEmptyString,
+  slug: TrimmedNonEmptyString,
+  kind: Schema.Literals(["crew", "scout"]),
+  stage: JbusWorkStage,
+  /** null until jbus launches the task. */
+  threadId: Schema.NullOr(ThreadId),
+  homeThreadId: ThreadId,
+  pullRequest: Schema.NullOr(TrimmedNonEmptyString),
+  /** jbus waits on the user's word: a gate, an approval, a hung or lost thread. */
+  waitsOnUser: Schema.Boolean,
+});
+export type JbusTask = typeof JbusTask.Type;
+
+/** An unanswered jbus question, which waits on the user until its default applies. */
+export const JbusGate = Schema.Struct({
+  repo: TrimmedNonEmptyString,
+  number: Schema.Int,
+  threadId: Schema.NullOr(ThreadId),
+  slug: Schema.NullOr(TrimmedNonEmptyString),
+  question: Schema.String,
+  askedAt: IsoDateTime,
+});
+export type JbusGate = typeof JbusGate.Type;
+
+export const JbusLanded = Schema.Struct({
+  repo: TrimmedNonEmptyString,
+  slug: TrimmedNonEmptyString,
+  homeThreadId: ThreadId,
+  mergedAt: IsoDateTime,
+});
+export type JbusLanded = typeof JbusLanded.Type;
+
+export const JbusWorkSnapshot = Schema.Struct({
+  homes: Schema.Array(JbusHome),
+  tasks: Schema.Array(JbusTask),
+  gates: Schema.Array(JbusGate),
+  landed: Schema.Array(JbusLanded),
+});
+export type JbusWorkSnapshot = typeof JbusWorkSnapshot.Type;
+
+export const EMPTY_JBUS_WORK_SNAPSHOT: JbusWorkSnapshot = {
+  homes: [],
+  tasks: [],
+  gates: [],
+  landed: [],
+};
