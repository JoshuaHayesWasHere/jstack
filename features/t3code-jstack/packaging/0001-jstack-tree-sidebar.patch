+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  buildRepoWork,
+  homeWord,
+  slugsNeedingBriefs,
+  type JbusRepoFiles,
+} from "./jbusWork.logic.ts";
+
+const NOW = Date.parse("2026-10-29T15:00:00Z");
+
+const row = (slug: string, value: string, lane: string, extra: Record<string, unknown> = {}) => ({
+  kind: "row",
+  slug,
+  value,
+  lane,
+  thread: `mcp:${slug}`,
+  pr: "",
+  who: "crew",
+  ...extra,
+});
+
+const files = (overrides: Partial<JbusRepoFiles> = {}): JbusRepoFiles => ({
+  repo: "jstack",
+  rootHomeId: "mcp:root",
+  scopes: [{ scope: "flow", homeId: "mcp:flow-home", prefix: "fl-" }],
+  work: { work: [] },
+  questions: { next: 1, records: [] },
+  merged: {},
+  scouts: [],
+  briefHomes: new Map(),
+  ...overrides,
+});
+
+describe("buildRepoWork", () => {
+  it("places each jbus lane on one stage word and hides finished rows", () => {
+    const work = {
+      work: [
+        row("a-ready", "ready", "queued", { thread: "" }),
+        row("a-behind", "behind", "queued", { thread: "" }),
+        row("a-unapproved", "unapproved", "queued", { thread: "", who: "user" }),
+        row("a-working", "working", "running"),
+        row("a-quiet", "quiet", "running"),
+        row("a-hung", "hung", "running", { who: "user" }),
+        row("a-review", "review", "review"),
+        row("a-findings", "findings", "findings", { pr: "#725" }),
+        row("a-check", "check", "check"),
+        row("a-merged", "merged", "merged"),
+        row("a-done", "done", "merged"),
+        row("a-removed", "removed", ""),
+        { kind: "thread", slug: "a-thread", value: "done", lane: "running" },
+      ],
+    };
+    const result = buildRepoWork(files({ work }), NOW);
+    expect(
+      result.tasks.map((task) => [task.slug, task.stage, task.threadId, task.waitsOnUser]),
+    ).toEqual([
+      ["a-ready", "ready", null, false],
+      ["a-behind", "behind", null, false],
+      ["a-unapproved", "ready", null, true],
+      ["a-working", "crew", "mcp:a-working", false],
+      ["a-quiet", "quiet", "mcp:a-quiet", false],
+      ["a-hung", "crew", "mcp:a-hung", true],
+      ["a-review", "review", "mcp:a-review", false],
+      ["a-findings", "review", "mcp:a-findings", false],
+      ["a-check", "review", "mcp:a-check", false],
+    ]);
+    expect(result.tasks.find((task) => task.slug === "a-findings")?.pullRequest).toBe("#725");
+  });
+
+  it("nests each task under the home its brief names", () => {
+    const work = {
+      work: ["none", "root", "flow", "thread", "prose", "unknown", "fl-prefixed"].map((slug) =>
+        row(slug, "working", "running"),
+      ),
+    };
+    const briefHomes = new Map([
+      ["root", "root"],
+      ["flow", "flow"],
+      ["thread", "mcp:other-home"],
+      ["prose", "flow (a second home of this repo). Its plan is `flow/plan.md`."],
+      ["unknown", "nowhere"],
+    ]);
+    const result = buildRepoWork(files({ work, briefHomes }), NOW);
+    expect(result.tasks.map((task) => [task.slug, task.homeThreadId])).toEqual([
+      ["none", "mcp:root"],
+      ["root", "mcp:root"],
+      ["flow", "mcp:flow-home"],
+      ["thread", "mcp:other-home"],
+      ["prose", "mcp:flow-home"],
+      ["unknown", "mcp:root"],
+      ["fl-prefixed", "mcp:flow-home"],
+    ]);
+    expect(result.homes).toEqual([
+      { repo: "jstack", scope: null, threadId: "mcp:root", prefix: null },
+      { repo: "jstack", scope: "flow", threadId: "mcp:flow-home", prefix: "fl-" },
+    ]);
+  });
+
+  it("reads open gates, launched scouts, and merges inside the landed window", () => {
+    const result = buildRepoWork(
+      files({
+        questions: {
+          next: 3,
+          records: [
+            { number: 1, answer: { words: "default" }, thread: "mcp:x", question: "old" },
+            {
+              number: 2,
+              answer: null,
+              thread: "mcp:x",
+              slug: "x",
+              question: "keep it?",
+              asked_at: "2026-10-29T14:00:00Z",
+            },
+          ],
+        },
+        scouts: [
+          { slug: "s-flow", launch: { thread: "mcp:s-flow" }, approval: { scope: "flow" } },
+          { slug: "fl-scout", launch: { thread: "mcp:fl-scout" }, approval: { scope: "" } },
+          { slug: "s-unlaunched", launch: {}, approval: { scope: "" } },
+        ],
+        merged: {
+          recent: { mergedAt: "2026-10-29T10:00:00Z" },
+          stale: { mergedAt: "2026-10-26T10:00:00Z" },
+        },
+        briefHomes: new Map([["recent", "flow"]]),
+      }),
+      NOW,
+    );
+    expect(result.gates).toEqual([
+      {
+        repo: "jstack",
+        number: 2,
+        threadId: "mcp:x",
+        slug: "x",
+        question: "keep it?",
+        askedAt: "2026-10-29T14:00:00Z",
+      },
+    ]);
+    expect(result.tasks.map((task) => [task.slug, task.kind, task.homeThreadId])).toEqual([
+      ["s-flow", "scout", "mcp:flow-home"],
+      ["fl-scout", "scout", "mcp:flow-home"],
+    ]);
+    expect(result.landed).toEqual([
+      {
+        repo: "jstack",
+        slug: "recent",
+        homeThreadId: "mcp:flow-home",
+        mergedAt: "2026-10-29T10:00:00Z",
+      },
+    ]);
+    expect(slugsNeedingBriefs({ work: { work: [] }, merged: files().merged }, NOW)).toEqual([]);
+  });
+
+  it("is empty for a repo with no root home", () => {
+    expect(buildRepoWork(files({ rootHomeId: null }), NOW).homes).toEqual([]);
+  });
+});
+
+describe("homeWord", () => {
+  it("takes the first word without trailing punctuation", () => {
+    expect(homeWord("review-speed (a second home).")).toBe("review-speed");
+    expect(homeWord("flow.")).toBe("flow");
+  });
+});
diff --git a/apps/server/src/jstack/jbusWork.logic.ts b/apps/server/src/jstack/jbusWork.logic.ts
new file mode 100644
index 0000000000..43e838a2f0
--- /dev/null
+++ b/apps/server/src/jstack/jbusWork.logic.ts
@@ -0,0 +1,218 @@
+import {
+  ThreadId,
+  type JbusGate,
+  type JbusHome,
+  type JbusLanded,
+  type JbusTask,
+  type JbusWorkSnapshot,
+  type JbusWorkStage,
+} from "@t3tools/contracts";
+
+/** One repo's raw jbus and home state. Each file is its parsed JSON, or null when absent. */
+export interface JbusRepoFiles {
+  readonly repo: string;
+  readonly work: unknown;
+  readonly questions: unknown;
+  readonly merged: unknown;
+  readonly scouts: unknown;
+  /** `home/<repo>/home-id`. */
+  readonly rootHomeId: string | null;
+  readonly scopes: ReadonlyArray<{
+    readonly scope: string;
+    readonly homeId: string;
+    readonly prefix: string | null;
+  }>;
+  /** The value of each brief's `Home:` line, by slug. Briefs with no line are absent. */
+  readonly briefHomes: ReadonlyMap<string, string>;
+}
+
+/** How far back merges are sent; the sidebar counts those after the user's last look. */
+const LANDED_WINDOW_MS = 48 * 60 * 60 * 1000;
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+const text = (value: unknown): string | null =>
+  typeof value === "string" && value.trim() !== "" ? value.trim() : null;
+
+const records = (value: unknown): ReadonlyArray<Record<string, unknown>> => {
+  if (Array.isArray(value)) return value.filter(isRecord);
+  if (isRecord(value)) return Object.values(value).filter(isRecord);
+  return [];
+};
+
+const threadIdOf = (value: unknown): ThreadId | null => {
+  const id = text(value);
+  return id === null ? null : ThreadId.make(id);
+};
+
+interface Placement {
+  readonly stage: JbusWorkStage;
+}
+
+/**
+ * Where a work row sits, from jbus's own `value` and `lane` (features/jbus/src/jbus/work.py).
+ * null hides the row: it merged, finished, or was removed.
+ */
+const placeWorkRow = (value: string, lane: string): Placement | null => {
+  if (value === "behind") return { stage: "behind" };
+  if (value === "quiet") return { stage: "quiet" };
+  switch (lane) {
+    case "queued":
+      return { stage: "ready" };
+    case "running":
+    case "result":
+    case "gate":
+      return { stage: "crew" };
+    case "review":
+    case "second":
+    case "check":
+    case "findings":
+    case "rebase":
+      return { stage: "review" };
+    default:
+      return null;
+  }
+};
+
+/** The first word of a brief's `Home:` line: `root`, a scope, or a home's thread id. */
+export const homeWord = (line: string): string => {
+  const first = line.trim().split(/\s+/)[0] ?? "";
+  return first.replace(/[.,;:)]+$/, "");
+};
+
+export const readHomeLine = (brief: string): string | null => {
+  const match = /^Home:\s*(.*)$/m.exec(brief);
+  return match ? (match[1] ?? "").trim() : null;
+};
+
+const resolveHome = (
+  rootId: ThreadId,
+  scopeIds: ReadonlyMap<string, ThreadId>,
+  word: string | null,
+): ThreadId | null => {
+  if (word === "root") return rootId;
+  if (word === null || word === "") return null;
+  const scoped = scopeIds.get(word);
+  if (scoped !== undefined) return scoped;
+  if (word.startsWith("mcp:")) return ThreadId.make(word);
+  return null;
+};
+
+export const buildRepoWork = (files: JbusRepoFiles, nowMs: number): JbusWorkSnapshot => {
+  const rootId = threadIdOf(files.rootHomeId);
+  if (rootId === null) return { homes: [], tasks: [], gates: [], landed: [] };
+  const { repo } = files;
+  const scopeIds = new Map(files.scopes.map((each) => [each.scope, ThreadId.make(each.homeId)]));
+  const homes: Array<JbusHome> = [
+    { repo, scope: null, threadId: rootId, prefix: null },
+    ...files.scopes.map((each) => ({
+      repo,
+      scope: each.scope,
+      threadId: ThreadId.make(each.homeId),
+      prefix: each.prefix,
+    })),
+  ];
+  const prefixed = files.scopes.filter((each) => each.prefix !== null);
+  // A brief or scout that names no home belongs to the scope whose prefix its slug carries.
+  const homeOf = (slug: string, word: string | null) =>
+    resolveHome(rootId, scopeIds, word) ??
+    scopeIds.get(prefixed.find((each) => slug.startsWith(each.prefix ?? ""))?.scope ?? "") ??
+    rootId;
+  const homeOfSlug = (slug: string) => {
+    const line = files.briefHomes.get(slug);
+    return homeOf(slug, line === undefined ? null : homeWord(line));
+  };
+
+  const tasks: Array<JbusTask> = [];
+  const rows = isRecord(files.work) ? records(files.work.work) : [];
+  for (const row of rows) {
+    const slug = text(row.slug);
+    if (slug === null || row.kind !== "row") continue;
+    const placed = placeWorkRow(text(row.value) ?? "", text(row.lane) ?? "");
+    if (placed === null) continue;
+    tasks.push({
+      repo,
+      slug,
+      kind: "crew",
+      stage: placed.stage,
+      threadId: threadIdOf(row.thread),
+      homeThreadId: homeOfSlug(slug),
+      pullRequest: text(row.pr),
+      waitsOnUser: row.who === "user",
+    });
+  }
+  for (const scout of records(files.scouts)) {
+    const slug = text(scout.slug);
+    const launch = isRecord(scout.launch) ? scout.launch : {};
+    const threadId = threadIdOf(launch.thread);
+    if (slug === null || threadId === null) continue;
+    const scope = isRecord(scout.approval) ? text(scout.approval.scope) : null;
+    tasks.push({
+      repo,
+      slug,
+      kind: "scout",
+      stage: "crew",
+      threadId,
+      homeThreadId: homeOf(slug, scope),
+      pullRequest: null,
+      waitsOnUser: false,
+    });
+  }
+
+  const gates: Array<JbusGate> = [];
+  const questions = isRecord(files.questions) ? records(files.questions.records) : [];
+  for (const question of questions) {
+    if (question.answer !== null && question.answer !== undefined) continue;
+    if (typeof question.number !== "number") continue;
+    gates.push({
+      repo,
+      number: question.number,
+      threadId: threadIdOf(question.thread),
+      slug: text(question.slug),
+      question: text(question.question) ?? "",
+      askedAt: text(question.asked_at) ?? "",
+    });
+  }
+
+  const landed: Array<JbusLanded> = [];
+  if (isRecord(files.merged)) {
+    for (const [slug, pull] of Object.entries(files.merged)) {
+      if (!isRecord(pull)) continue;
+      const mergedAt = text(pull.mergedAt);
+      if (mergedAt === null || nowMs - Date.parse(mergedAt) > LANDED_WINDOW_MS) continue;
+      landed.push({ repo, slug, homeThreadId: homeOfSlug(slug), mergedAt });
+    }
+  }
+
+  return { homes, tasks, gates, landed };
+};
+
+/** The slugs whose briefs `buildRepoWork` reads: live rows and recent merges. */
+export const slugsNeedingBriefs = (
+  files: Pick<JbusRepoFiles, "work" | "merged">,
+  nowMs: number,
+): ReadonlyArray<string> => {
+  const slugs = new Set<string>();
+  const rows = isRecord(files.work) ? records(files.work.work) : [];
+  for (const row of rows) {
+    const slug = text(row.slug);
+    if (slug !== null && placeWorkRow(text(row.value) ?? "", text(row.lane) ?? "") !== null) {
+      slugs.add(slug);
+    }
+  }
+  if (isRecord(files.merged)) {
+    for (const [slug, pull] of Object.entries(files.merged)) {
+      const mergedAt = isRecord(pull) ? text(pull.mergedAt) : null;
+      if (mergedAt !== null && nowMs - Date.parse(mergedAt) <= LANDED_WINDOW_MS) slugs.add(slug);
+    }
+  }
+  return [...slugs];
+};
+
+export const mergeSnapshots = (snapshots: ReadonlyArray<JbusWorkSnapshot>): JbusWorkSnapshot => ({
+  homes: snapshots.flatMap((each) => each.homes),
+  tasks: snapshots.flatMap((each) => each.tasks),
+  gates: snapshots.flatMap((each) => each.gates),
+  landed: snapshots.flatMap((each) => each.landed),
+});
