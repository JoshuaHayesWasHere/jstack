+import { AuthOrchestrationReadScope } from "@t3tools/contracts";
+import type { EnvironmentId, JbusWorkSnapshot } from "@t3tools/contracts";
+
+import { useEnvironmentQuery } from "../state/query";
+import { serverEnvironment } from "../state/server";
+import { useEnvironmentScope } from "../state/session";
+
+/** jbus's tasks and homes on one environment; null while loading or on a server without them. */
+export function useJbusWork(environmentId: EnvironmentId | null): JbusWorkSnapshot | null {
+  const canRead = useEnvironmentScope(environmentId, AuthOrchestrationReadScope);
+  return useEnvironmentQuery(
+    environmentId === null || !canRead
+      ? null
+      : serverEnvironment.jbusWork({ environmentId, input: {} }),
+  ).data;
+}
