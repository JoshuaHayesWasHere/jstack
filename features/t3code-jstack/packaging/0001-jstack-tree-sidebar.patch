index 0000000000..bdd92721e2
--- /dev/null
+++ b/apps/web/src/components/sidebar/jstackTree.logic.ts
@@ -0,0 +1,369 @@
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import { isThreadWorking } from "@t3tools/client-runtime/state/thread-inbox";
+import type {
+  EnvironmentId,
+  JbusHome,
+  JbusTask,
+  JbusWorkSnapshot,
+  ScopedProjectRef,
+  ThreadId,
+} from "@t3tools/contracts";
+
+// jstack fork: the tree sidebar's rows, from jbus's snapshot joined to T3's threads by id.
+
+export type JstackTreeAttention = "gates" | "gates-and-quiet";
+
+export interface JstackTreeOptions {
+  readonly attention: JstackTreeAttention;
+  readonly landedCount: boolean;
+  readonly quietMinutes: number;
+  readonly rowCap: number;
+}
+
+/** Ticks for queue, crew, review and merge. A hollow tick is queued work or a quiet crew. */
+export interface JstackTicks {
+  readonly step: 0 | 1 | 2 | 3;
+  readonly hollow: boolean;
+  readonly asks: boolean;
+}
+
+export interface JstackTally {
+  readonly queue: number;
+  readonly crew: number;
+  readonly review: number;
+}
+
+export type JstackTreeRow =
+  | {
+      readonly kind: "project";
+      readonly key: string;
+      readonly thread: EnvironmentThreadShell;
+      readonly collapsed: boolean;
+      /** The root home itself waits on the user. */
+      readonly asksYou: boolean;
+      /** Something folded inside waits on the user. */
+      readonly dot: boolean;
+      readonly landed: number;
+      readonly taskCount: number;
+      readonly faded: boolean;
+      readonly selected: boolean;
+    }
+  | {
+      readonly kind: "domain";
+      readonly key: string;
+      readonly parentKey: string;
+      readonly scope: string;
+      readonly threadId: ThreadId;
+      /** null when the client has not loaded the home's thread, such as a long-settled one. */
+      readonly thread: EnvironmentThreadShell | null;
+      readonly open: boolean;
+      readonly asksYou: boolean;
+      readonly dot: boolean;
+      readonly tally: JstackTally;
+      readonly faded: boolean;
+      readonly selected: boolean;
+    }
+  | {
+      readonly kind: "worker";
+      readonly key: string;
+      readonly parentKey: string;
+      readonly depth: 1 | 2;
+      readonly slug: string;
+      /** The home's slug prefix, drawn faint, when the slug carries it. */
+      readonly prefix: string | null;
+      readonly word: string;
+      readonly tone: "asks" | "plain";
+      /** null for a scout, which draws one dot. */
+      readonly ticks: JstackTicks | null;
+      /** null until jbus launches the task. */
+      readonly threadId: ThreadId | null;
+      readonly thread: EnvironmentThreadShell | null;
+      readonly pullRequest: string | null;
+      readonly selected: boolean;
+    }
+  | {
+      readonly kind: "more";
+      readonly key: string;
+      readonly parentKey: string;
+      readonly depth: 1 | 2;
+      readonly homeKey: string;
+      readonly count: number;
+    }
+  | {
+      readonly kind: "loose";
+      readonly key: string;
+      readonly parentKey: string;
+      readonly thread: EnvironmentThreadShell;
+    };
+
+export interface JstackTreeInput {
+  readonly environmentId: EnvironmentId;
+  readonly projectKey: string;
+  readonly memberProjectRefs: ReadonlyArray<ScopedProjectRef>;
+  readonly snapshot: JbusWorkSnapshot;
+  /** Every thread of the environment, settled and snoozed ones included. */
+  readonly threadsById: ReadonlyMap<ThreadId, EnvironmentThreadShell>;
+  /** The folder's active threads, in the sidebar's order. */
+  readonly folderThreads: ReadonlyArray<EnvironmentThreadShell>;
+  readonly collapsed: boolean;
+  readonly routeThreadId: ThreadId | null;
+  /** Homes whose "+N" row the user opened. */
+  readonly expandedHomes: ReadonlySet<string>;
+  /** Worker order per home to keep while the pointer is in the sidebar; null re-sorts. */
+  readonly frozenOrder: ReadonlyMap<string, ReadonlyArray<string>> | null;
+  readonly lastVisitedAt: (thread: EnvironmentThreadShell) => string | null;
+  readonly nowMs: number;
+  readonly options: JstackTreeOptions;
+}
+
+export interface JstackTree {
+  readonly rows: ReadonlyArray<JstackTreeRow>;
+  /** Worker keys per home in drawn order, to freeze while the pointer is in the sidebar. */
+  readonly order: ReadonlyMap<string, ReadonlyArray<string>>;
+}
+
+/** Finished worker threads jbus no longer lists. Search still finds them. */
+const WORKER_TITLE = /^(crew|scout|review):/i;
+
+const MINUTE_MS = 60_000;
+
+const formatQuietAge = (minutes: number): string =>
+  minutes < 60
+    ? `${minutes}m`
+    : minutes < 48 * 60
+      ? `${Math.floor(minutes / 60)}h`
+      : `${Math.floor(minutes / 1440)}d`;
+
+const waitsOnUser = (thread: EnvironmentThreadShell | null) =>
+  thread !== null && (thread.hasPendingUserInput || thread.hasPendingApprovals);
+
+interface Worker {
+  readonly row: Extract<JstackTreeRow, { kind: "worker" }>;
+  readonly rank: number;
+  readonly stage: "queue" | "crew" | "review";
+}
+
+const STEP = { ready: 0, behind: 0, crew: 1, quiet: 1, review: 2 } as const;
+
+const toWorker = (
+  input: JstackTreeInput,
+  task: JbusTask,
+  home: JbusHome,
+  parentKey: string,
+  depth: 1 | 2,
+  gateThreads: ReadonlySet<string>,
+  gateSlugs: ReadonlySet<string>,
+): Worker => {
+  const thread = task.threadId === null ? null : (input.threadsById.get(task.threadId) ?? null);
+  const asks =
+    task.waitsOnUser ||
+    gateSlugs.has(`${task.repo}/${task.slug}`) ||
+    (task.threadId !== null && gateThreads.has(task.threadId)) ||
+    waitsOnUser(thread);
+  const quietMinutes =
+    thread === null ? 0 : Math.floor((input.nowMs - Date.parse(thread.updatedAt)) / MINUTE_MS);
+  const quietShown =
+    input.options.attention === "gates-and-quiet" &&
+    task.stage === "quiet" &&
+    quietMinutes >= input.options.quietMinutes;
+  const scout = task.kind === "scout";
+  const [word, rank] = asks
+    ? ["asks you", 0]
+    : scout
+      ? ["scout", 2]
+      : quietShown
+        ? [`quiet ${formatQuietAge(quietMinutes)}`, 1]
+        : task.stage === "quiet"
+          ? ["crew", 2]
+          : ([task.stage, { ready: 4, behind: 5, crew: 2, review: 3 }[task.stage]] as const);
+  const step = STEP[task.stage];
+  const prefix =
+    home.prefix !== null && task.slug.startsWith(home.prefix) && task.slug !== home.prefix
+      ? home.prefix
+      : null;
+  return {
+    rank,
+    stage: step === 0 ? "queue" : step === 1 ? "crew" : "review",
+    row: {
+      kind: "worker",
+      key: `jstack-task:${task.repo}/${task.slug}`,
+      parentKey,
+      depth,
+      slug: prefix === null ? task.slug : task.slug.slice(prefix.length),
+      prefix,
+      word,
+      tone: asks ? "asks" : "plain",
+      ticks: scout ? null : { step, hollow: step === 0 || quietShown, asks },
+      threadId: task.threadId,
+      thread,
+      pullRequest: task.pullRequest,
+      selected: task.threadId !== null && task.threadId === input.routeThreadId,
+    },
+  };
+};
+
+const ordered = (
+  workers: ReadonlyArray<Worker>,
+  frozen: ReadonlyArray<string> | undefined,
+): ReadonlyArray<Worker> => {
+  const ranked = workers
+    .map((worker, index) => ({ worker, index }))
+    .toSorted((a, b) => a.worker.rank - b.worker.rank || a.index - b.index)
+    .map(({ worker }) => worker);
+  if (frozen === undefined) return ranked;
+  const position = new Map(frozen.map((key, index) => [key, index]));
+  const kept = ranked
+    .filter((worker) => position.has(worker.row.key))
+    .toSorted((a, b) => position.get(a.row.key)! - position.get(b.row.key)!);
+  return [...kept, ...ranked.filter((worker) => !position.has(worker.row.key))];
+};
+
+const tallyOf = (workers: ReadonlyArray<Worker>): JstackTally => ({
+  queue: workers.filter((worker) => worker.stage === "queue").length,
+  crew: workers.filter((worker) => worker.stage === "crew").length,
+  review: workers.filter((worker) => worker.stage === "review").length,
+});
+
+const isMember = (input: JstackTreeInput, thread: EnvironmentThreadShell) =>
+  input.memberProjectRefs.some(
+    (ref) => ref.environmentId === input.environmentId && ref.projectId === thread.projectId,
+  );
+
+/** The folder's rows in tree mode, or null when no jstack root home lives in the project. */
+export function buildJstackTree(input: JstackTreeInput): JstackTree | null {
+  const { snapshot, options } = input;
+  const root = snapshot.homes.find((home) => {
+    if (home.scope !== null) return false;
+    const thread = input.threadsById.get(home.threadId);
+    return thread !== undefined && isMember(input, thread);
+  });
+  const rootThread = root === undefined ? undefined : input.threadsById.get(root.threadId);
+  if (root === undefined || rootThread === undefined) return null;
+
+  const projectKey = `jstack-home:${root.threadId}`;
+  const domains = snapshot.homes.filter((home) => home.repo === root.repo && home.scope !== null);
+  const homeIds = new Set([root.threadId, ...domains.map((home) => home.threadId)]);
+  const gates = snapshot.gates.filter((gate) => gate.repo === root.repo);
+  const gateThreads = new Set(
+    gates.flatMap((gate) => (gate.threadId === null ? [] : [gate.threadId])),
+  );
+  const gateSlugs = new Set(
+    gates.flatMap((gate) => (gate.slug === null ? [] : [`${gate.repo}/${gate.slug}`])),
+  );
+  const tasks = snapshot.tasks.filter((task) => {
+    if (task.repo !== root.repo || !homeIds.has(task.homeThreadId)) return false;
+    if (task.kind !== "scout") return true;
+    // jbus never closes a scout; its thread settling or archiving does.
+    const thread = task.threadId === null ? undefined : input.threadsById.get(task.threadId);
+    return (
+      thread !== undefined &&
+      thread.archivedAt === null &&
+      thread.settledOverride !== "settled" &&
+      thread.settledAt === null
+    );
+  });
+
+  const consumed = new Set<string>(homeIds);
+  for (const task of tasks) if (task.threadId !== null) consumed.add(task.threadId);
+
+  const order = new Map<string, ReadonlyArray<string>>();
+  const workersOf = (home: JbusHome, parentKey: string, depth: 1 | 2) => {
+    const workers = ordered(
+      tasks
+        .filter((task) => task.homeThreadId === home.threadId)
+        .map((task) => toWorker(input, task, home, parentKey, depth, gateThreads, gateSlugs)),
+      input.frozenOrder?.get(home.threadId),
+    );
+    order.set(
+      home.threadId,
+      workers.map((worker) => worker.row.key),
+    );
+    return workers;
+  };
+  const capped = (
+    workers: ReadonlyArray<Worker>,
+    homeKey: string,
+    parentKey: string,
+    depth: 1 | 2,
+  ): ReadonlyArray<JstackTreeRow> => {
+    const limit = input.expandedHomes.has(homeKey) ? workers.length : options.rowCap;
+    const shown: Array<JstackTreeRow> = workers.slice(0, limit).map((worker) => worker.row);
+    if (workers.length > limit) {
+      shown.push({
+        kind: "more",
+        key: `jstack-more:${homeKey}`,
+        parentKey,
+        depth,
+        homeKey,
+        count: workers.length - limit,
+      });
+    }
+    return shown;
+  };
+
+  const rootWorkers = workersOf(root, projectKey, 1);
+  const domainRows: Array<JstackTreeRow> = [];
+  let innerAsks = rootWorkers.some((worker) => worker.row.tone === "asks");
+  for (const home of domains) {
+    const thread = input.threadsById.get(home.threadId) ?? null;
+    const key = `jstack-home:${home.threadId}`;
+    const workers = workersOf(home, key, 2);
+    const asksYou = gateThreads.has(home.threadId) || waitsOnUser(thread);
+    const workerAsks = workers.some((worker) => worker.row.tone === "asks");
+    innerAsks ||= asksYou || workerAsks;
+    const selected = home.threadId === input.routeThreadId;
+    const open = selected || workers.some((worker) => worker.row.selected);
+    domainRows.push({
+      kind: "domain",
+      key,
+      parentKey: projectKey,
+      scope: home.scope ?? "",
+      threadId: home.threadId,
+      thread,
+      open,
+      asksYou,
+      dot: !open && workerAsks,
+      tally: tallyOf(workers),
+      faded: workers.length === 0 && !asksYou && (thread === null || !isThreadWorking(thread)),
+      selected,
+    });
+    if (open) domainRows.push(...capped(workers, home.threadId, key, 2));
+  }
+
+  const lastVisitedAt = input.lastVisitedAt(rootThread);
+  const landed = options.landedCount
+    ? snapshot.landed.filter(
+        (merge) =>
+          merge.repo === root.repo &&
+          (lastVisitedAt === null || Date.parse(merge.mergedAt) > Date.parse(lastVisitedAt)),
+      ).length
+    : 0;
+  const rootAsks = gateThreads.has(root.threadId) || waitsOnUser(rootThread);
+  const project: JstackTreeRow = {
+    kind: "project",
+    key: projectKey,
+    thread: rootThread,
+    collapsed: input.collapsed,
+    asksYou: rootAsks,
+    dot: input.collapsed && innerAsks,
+    landed,
+    taskCount: tasks.length,
+    faded: tasks.length === 0 && gates.length === 0 && !rootAsks && !isThreadWorking(rootThread),
+    selected: root.threadId === input.routeThreadId,
+  };
+  if (input.collapsed) return { rows: [project], order };
+
+  const loose: Array<JstackTreeRow> = input.folderThreads
+    .filter((thread) => !consumed.has(thread.id) && !WORKER_TITLE.test(thread.title))
+    .map((thread) => ({
+      kind: "loose",
+      key: `jstack-loose:${thread.id}`,
+      parentKey: projectKey,
+      thread,
+    }));
+
+  return {
+    rows: [project, ...capped(rootWorkers, root.threadId, projectKey, 1), ...domainRows, ...loose],
+    order,
+  };
+}
