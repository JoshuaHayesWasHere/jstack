diff --git a/apps/web/src/components/sidebar/jstackTree.logic.test.ts b/apps/web/src/components/sidebar/jstackTree.logic.test.ts
new file mode 100644
index 0000000000..634306be6a
--- /dev/null
+++ b/apps/web/src/components/sidebar/jstackTree.logic.test.ts
@@ -0,0 +1,249 @@
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import {
+  EMPTY_JBUS_WORK_SNAPSHOT,
+  EnvironmentId,
+  ProjectId,
+  ThreadId,
+  type JbusTask,
+  type JbusWorkSnapshot,
+} from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { makeThreadFixture, type ThreadFixtureOverrides } from "../../test-fixtures";
+import { buildJstackTree, type JstackTreeInput, type JstackTreeRow } from "./jstackTree.logic";
+
+const environmentId = EnvironmentId.make("environment-local");
+const projectId = ProjectId.make("project-jstack");
+const NOW = Date.parse("2026-10-29T12:00:00.000Z");
+const minutesAgo = (minutes: number) => new Date(NOW - minutes * 60_000).toISOString();
+
+const thread = (id: string, overrides: ThreadFixtureOverrides = {}): EnvironmentThreadShell =>
+  makeThreadFixture({
+    environmentId,
+    projectId,
+    id: ThreadId.make(id),
+    title: id,
+    updatedAt: minutesAgo(1),
+    ...overrides,
+  });
+
+const task = (slug: string, overrides: Partial<JbusTask> = {}): JbusTask => ({
+  repo: "jstack",
+  slug,
+  kind: "crew",
+  stage: "crew",
+  threadId: ThreadId.make(`crew-${slug}`),
+  homeThreadId: ThreadId.make("root"),
+  pullRequest: null,
+  waitsOnUser: false,
+  ...overrides,
+});
+
+const HOMES: JbusWorkSnapshot["homes"] = [
+  { repo: "jstack", scope: null, threadId: ThreadId.make("root"), prefix: null },
+  { repo: "jstack", scope: "flow", threadId: ThreadId.make("flow"), prefix: "fl-" },
+];
+
+function build(
+  snapshot: Partial<JbusWorkSnapshot>,
+  overrides: Partial<JstackTreeInput> & { threads?: ReadonlyArray<EnvironmentThreadShell> } = {},
+) {
+  const { threads = [], ...rest } = overrides;
+  const tasks = snapshot.tasks ?? [];
+  const all = [
+    thread("root"),
+    thread("flow"),
+    ...tasks.flatMap((t) =>
+      t.threadId === null || threads.some((known) => known.id === t.threadId)
+        ? []
+        : [thread(t.threadId)],
+    ),
+    ...threads,
+  ];
+  return buildJstackTree({
+    environmentId,
+    projectKey: "project",
+    memberProjectRefs: [{ environmentId, projectId }],
+    snapshot: { ...EMPTY_JBUS_WORK_SNAPSHOT, homes: HOMES, ...snapshot },
+    threadsById: new Map(all.map((shell) => [shell.id, shell])),
+    folderThreads: all,
+    collapsed: false,
+    routeThreadId: null,
+    expandedHomes: new Set(),
+    frozenOrder: null,
+    lastVisitedAt: () => null,
+    nowMs: NOW,
+    options: { attention: "gates-and-quiet", landedCount: true, quietMinutes: 20, rowCap: 8 },
+    ...rest,
+  });
+}
+
+const workers = (rows: ReadonlyArray<JstackTreeRow> | undefined) =>
+  (rows ?? []).flatMap((row) => (row.kind === "worker" ? [`${row.slug}:${row.word}`] : []));
+
+describe("buildJstackTree", () => {
+  it("returns null for a project without a jstack root home", () => {
+    expect(
+      build({}, { memberProjectRefs: [{ environmentId, projectId: ProjectId.make("other") }] }),
+    ).toBeNull();
+  });
+
+  it("ranks needs you, quiet, crew, review, then queued", () => {
+    const tree = build(
+      {
+        tasks: [
+          task("queued", { stage: "ready", threadId: null }),
+          task("reviewing", { stage: "review" }),
+          task("working"),
+          task("silent", { stage: "quiet" }),
+          task("gated"),
+        ],
+        gates: [
+          {
+            repo: "jstack",
+            number: 1,
+            threadId: null,
+            slug: "gated",
+            question: "Ship it?",
+            askedAt: minutesAgo(5),
+          },
+        ],
+      },
+      { threads: [thread("crew-silent", { updatedAt: minutesAgo(45) })] },
+    );
+    expect(workers(tree?.rows)).toEqual([
+      "gated:asks you",
+      "silent:quiet 45m",
+      "working:crew",
+      "reviewing:review",
+      "queued:ready",
+    ]);
+  });
+
+  it("reads a quiet task as crew under its threshold or with gates-only attention", () => {
+    const threads = [thread("crew-silent", { updatedAt: minutesAgo(10) })];
+    const tasks = [task("silent", { stage: "quiet" })];
+    expect(workers(build({ tasks }, { threads })?.rows)).toEqual(["silent:crew"]);
+    expect(
+      workers(
+        build(
+          { tasks },
+          {
+            threads: [thread("crew-silent", { updatedAt: minutesAgo(90) })],
+            options: { attention: "gates", landedCount: true, quietMinutes: 20, rowCap: 8 },
+          },
+        )?.rows,
+      ),
+    ).toEqual(["silent:crew"]);
+  });
+
+  it("keeps the frozen order and appends new tasks", () => {
+    const tasks = [task("a", { stage: "review" }), task("b")];
+    const first = build({ tasks });
+    expect(workers(first?.rows)).toEqual(["b:crew", "a:review"]);
+    const frozen = new Map([[ThreadId.make("root"), ["jstack-task:jstack/a"]]]);
+    const next = build(
+      { tasks: [...tasks, task("c", { waitsOnUser: true })] },
+      { frozenOrder: frozen },
+    );
+    expect(workers(next?.rows)).toEqual(["a:review", "c:asks you", "b:crew"]);
+  });
+
+  it("caps a home's rows behind a +N row until it is expanded", () => {
+    const tasks = Array.from({ length: 5 }, (_, index) => task(`t${index}`));
+    const options = { attention: "gates", landedCount: true, quietMinutes: 20, rowCap: 3 } as const;
+    const more = build({ tasks }, { options })?.rows.find((row) => row.kind === "more");
+    expect(more).toMatchObject({ count: 2, homeKey: "root" });
+    const open = build({ tasks }, { options, expandedHomes: new Set(["root"]) });
+    expect(open?.rows.some((row) => row.kind === "more")).toBe(false);
+    expect(workers(open?.rows)).toHaveLength(5);
+  });
+
+  it("opens a domain only while it or one of its tasks is selected", () => {
+    const tasks = [
+      task("fl-pump", { homeThreadId: ThreadId.make("flow"), waitsOnUser: true }),
+      task("fl-ready", { homeThreadId: ThreadId.make("flow"), stage: "ready", threadId: null }),
+    ];
+    const closed = build({ tasks });
+    expect(closed?.rows.find((row) => row.kind === "domain")).toMatchObject({
+      open: false,
+      dot: true,
+      tally: { queue: 1, crew: 1, review: 0 },
+    });
+    expect(workers(closed?.rows)).toEqual([]);
+
+    const open = build({ tasks }, { routeThreadId: ThreadId.make("crew-fl-pump") });
+    expect(open?.rows.find((row) => row.kind === "domain")).toMatchObject({
+      open: true,
+      dot: false,
+    });
+    const pump = open?.rows.find((row) => row.kind === "worker" && row.slug === "pump");
+    expect(pump).toMatchObject({ prefix: "fl-", selected: true, depth: 2 });
+  });
+
+  it("rolls everything inside up to the project row when folded", () => {
+    const tree = build(
+      { tasks: [task("fl-pump", { homeThreadId: ThreadId.make("flow"), waitsOnUser: true })] },
+      { collapsed: true },
+    );
+    expect(tree?.rows).toHaveLength(1);
+    expect(tree?.rows[0]).toMatchObject({ kind: "project", dot: true, taskCount: 1 });
+  });
+
+  it("counts merges since the root home was last visited", () => {
+    const landed = [
+      {
+        repo: "jstack",
+        slug: "old",
+        homeThreadId: ThreadId.make("root"),
+        mergedAt: minutesAgo(90),
+      },
+      { repo: "jstack", slug: "new", homeThreadId: ThreadId.make("root"), mergedAt: minutesAgo(5) },
+      { repo: "infra", slug: "else", homeThreadId: ThreadId.make("x"), mergedAt: minutesAgo(5) },
+    ];
+    const project = (tree: ReturnType<typeof build>) => tree?.rows[0];
+    expect(project(build({ landed }, { lastVisitedAt: () => minutesAgo(30) }))).toMatchObject({
+      landed: 1,
+    });
+    expect(project(build({ landed }))).toMatchObject({ landed: 2 });
+    expect(
+      project(
+        build(
+          { landed },
+          { options: { attention: "gates", landedCount: false, quietMinutes: 20, rowCap: 8 } },
+        ),
+      ),
+    ).toMatchObject({ landed: 0 });
+  });
+
+  it("drops scouts whose thread settled or archived", () => {
+    const tree = build(
+      {
+        tasks: [
+          task("live", { kind: "scout" }),
+          task("done", { kind: "scout" }),
+          task("gone", { kind: "scout" }),
+        ],
+      },
+      {
+        threads: [
+          thread("crew-done", { settledOverride: "settled" }),
+          thread("crew-gone", { archivedAt: minutesAgo(5) }),
+        ],
+      },
+    );
+    expect(workers(tree?.rows)).toEqual(["live:scout"]);
+  });
+
+  it("lists the folder's other threads loose, minus finished worker threads", () => {
+    const tree = build(
+      { tasks: [task("working")] },
+      {
+        threads: [thread("notes", { title: "Notes" }), thread("old", { title: "crew: old-task" })],
+      },
+    );
+    expect(tree?.rows.flatMap((row) => (row.kind === "loose" ? [row.thread.title] : []))).toEqual([
+      "Notes",
+    ]);
+  });
+});
diff --git a/apps/web/src/components/sidebar/jstackTree.logic.ts b/apps/web/src/components/sidebar/jstackTree.logic.ts
