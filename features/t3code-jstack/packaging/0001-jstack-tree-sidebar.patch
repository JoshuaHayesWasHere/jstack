+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Stream from "effect/Stream";
+
+import * as JbusWork from "./JbusWork.ts";
+
+const workFile = (value: string) =>
+  JSON.stringify({
+    work: [
+      { kind: "row", slug: "fix-it", value, lane: "running", thread: "mcp:crew", who: "crew" },
+    ],
+  });
+
+const seed = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const base = yield* fs.makeTempDirectoryScoped({ prefix: "t3code-jbus-work-" });
+  const roots = { jbus: path.join(base, "jbus"), home: path.join(base, "home") };
+  yield* fs.makeDirectory(path.join(roots.jbus, "jstack"), { recursive: true });
+  yield* fs.makeDirectory(path.join(roots.home, "jstack", "tasks"), { recursive: true });
+  // jbus keeps files beside its repo directories; probing `<file>/work.json` must not end discovery.
+  yield* fs.writeFileString(path.join(roots.jbus, "sign-in.json"), "{}");
+  yield* fs.writeFileString(path.join(roots.jbus, "jstack", "work.json"), workFile("working"));
+  yield* fs.writeFileString(path.join(roots.home, "jstack", "home-id"), "mcp:root\n");
+  return { roots, workPath: path.join(roots.jbus, "jstack", "work.json") };
+});
+
+it.live("reads each repo beside jbus's own files and follows work.json", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const { roots, workPath } = yield* seed;
+    const service = yield* JbusWork.make(roots);
+    const { latest, changes } = yield* service.subscribe;
+    assert.deepEqual(
+      latest.tasks.map((task) => [task.slug, task.stage, task.homeThreadId]),
+      [["fix-it", "crew", "mcp:root"]],
+    );
+
+    yield* fs.writeFileString(workPath, workFile("quiet"));
+    const next = yield* Stream.runHead(changes);
+    assert.deepEqual(
+      Option.map(next, (snapshot) => snapshot.tasks.map((task) => task.stage)),
+      Option.some(["quiet"]),
+    );
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
diff --git a/apps/server/src/jstack/JbusWork.ts b/apps/server/src/jstack/JbusWork.ts
new file mode 100644
index 0000000000..85299d8a8e
--- /dev/null
+++ b/apps/server/src/jstack/JbusWork.ts
@@ -0,0 +1,175 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- watch must register before the first read; see make.
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+
+import { EMPTY_JBUS_WORK_SNAPSHOT, JbusWorkSnapshot } from "@t3tools/contracts";
+import * as Clock from "effect/Clock";
+import * as Context from "effect/Context";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as PubSub from "effect/PubSub";
+import * as Queue from "effect/Queue";
+import * as Ref from "effect/Ref";
+import * as Schema from "effect/Schema";
+import * as Scope from "effect/Scope";
+import * as Semaphore from "effect/Semaphore";
+import * as Stream from "effect/Stream";
+
+import {
+  type SnapshotSubscription,
+  subscribeBeforeSnapshot,
+} from "../utils/subscribeBeforeSnapshot.ts";
+import {
+  buildRepoWork,
+  mergeSnapshots,
+  readHomeLine,
+  slugsNeedingBriefs,
+  type JbusRepoFiles,
+} from "./jbusWork.logic.ts";
+
+export class JbusWork extends Context.Service<
+  JbusWork,
+  {
+    readonly subscribe: Effect.Effect<SnapshotSubscription<JbusWorkSnapshot>, never, Scope.Scope>;
+  }
+>()("t3/jstack/JbusWork") {}
+
+export interface JbusWorkRoots {
+  readonly jbus: string;
+  readonly home: string;
+}
+
+const decodeJson = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Unknown));
+const encodeSnapshot = Schema.encodeSync(Schema.fromJsonString(JbusWorkSnapshot));
+
+const defaultJbusWorkRoots = (): JbusWorkRoots => {
+  const state = process.env.XDG_STATE_HOME || `${NodeOS.homedir()}/.local/state`;
+  return { jbus: `${state}/jbus`, home: `${state}/home` };
+};
+
+export const make = Effect.fn("JbusWork.make")(function* (roots: JbusWorkRoots) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const state = yield* Ref.make<JbusWorkSnapshot>(EMPTY_JBUS_WORK_SNAPSHOT);
+  const lastJson = yield* Ref.make(encodeSnapshot(EMPTY_JBUS_WORK_SNAPSHOT));
+  const changes = yield* PubSub.unbounded<JbusWorkSnapshot>();
+  const mutex = yield* Semaphore.make(1);
+
+  const readText = (file: string) =>
+    fs.readFileString(file).pipe(
+      Effect.map((value) => value.trim()),
+      Effect.orElseSucceed(() => null),
+    );
+  const readJson = (file: string) =>
+    fs.readFileString(file).pipe(
+      Effect.flatMap(decodeJson),
+      Effect.orElseSucceed((): unknown => null),
+    );
+  const listDirectory = (directory: string) =>
+    fs.readDirectory(directory).pipe(Effect.orElseSucceed((): ReadonlyArray<string> => []));
+
+  // exists fails, not false, when a parent is a file, as jbus/<file>.json/work.json is.
+  const isFile = (file: string) => fs.exists(file).pipe(Effect.orElseSucceed(() => false));
+  const repos = Effect.gen(function* () {
+    const found: Array<string> = [];
+    for (const name of yield* listDirectory(roots.jbus)) {
+      const hasWork = yield* isFile(path.join(roots.jbus, name, "work.json"));
+      const hasHome = yield* isFile(path.join(roots.home, name, "home-id"));
+      if (hasWork && hasHome) found.push(name);
+    }
+    return found.toSorted();
+  });
+
+  const readRepo = Effect.fnUntraced(function* (repo: string, nowMs: number) {
+    const bus = path.join(roots.jbus, repo);
+    const home = path.join(roots.home, repo);
+    const work = yield* readJson(path.join(bus, "work.json"));
+    const merged = yield* readJson(path.join(bus, "merged.json"));
+    const scopes: Array<JbusRepoFiles["scopes"][number]> = [];
+    for (const scope of yield* listDirectory(home)) {
+      const homeId = yield* readText(path.join(home, scope, "home-id"));
+      if (homeId === null || homeId === "") continue;
+      const prefix = yield* readText(path.join(home, scope, "prefix"));
+      scopes.push({ scope, homeId, prefix: prefix === "" ? null : prefix });
+    }
+    const briefHomes = new Map<string, string>();
+    for (const slug of slugsNeedingBriefs({ work, merged }, nowMs)) {
+      const brief = yield* readText(path.join(home, "tasks", `${slug}.md`));
+      const line = brief === null ? null : readHomeLine(brief);
+      if (line !== null) briefHomes.set(slug, line);
+    }
+    return buildRepoWork(
+      {
+        repo,
+        work,
+        merged,
+        questions: yield* readJson(path.join(bus, "questions.json")),
+        scouts: yield* readJson(path.join(bus, "scouts.json")),
+        rootHomeId: yield* readText(path.join(home, "home-id")),
+        scopes: scopes.toSorted((a, b) => a.scope.localeCompare(b.scope)),
+        briefHomes,
+      },
+      nowMs,
+    );
+  });
+
+  // Refreshes run on every debounced file event; tracing each would flood spans.
+  const refresh = Effect.fnUntraced(function* () {
+    const nowMs = yield* Clock.currentTimeMillis;
+    const snapshots: Array<JbusWorkSnapshot> = [];
+    for (const repo of yield* repos) snapshots.push(yield* readRepo(repo, nowMs));
+    const next = mergeSnapshots(snapshots);
+    const json = encodeSnapshot(next);
+    if (json === (yield* Ref.get(lastJson))) return;
+    yield* Ref.set(lastJson, json);
+    yield* Ref.set(state, next);
+    yield* PubSub.publish(changes, next);
+  });
+  const refreshLocked = mutex
+    .withPermits(1)(refresh())
+    .pipe(Effect.ignoreCause({ log: true }));
+
+  // The watched set is fixed at start; a repo jbus starts tracking later shows after a restart.
+  const watched = [roots.jbus];
+  for (const repo of yield* repos) {
+    watched.push(
+      path.join(roots.jbus, repo),
+      path.join(roots.home, repo),
+      path.join(roots.home, repo, "tasks"),
+    );
+  }
+  // node's watch registers synchronously, so no write between this and the first read is lost;
+  // FileSystem.watch registers only once its stream is first pulled.
+  const touched = yield* Queue.sliding<void>(1);
+  yield* Effect.acquireRelease(
+    Effect.sync(() =>
+      watched.flatMap((directory) => {
+        try {
+          const watcher = NodeFS.watch(directory, () => Queue.offerUnsafe(touched, undefined));
+          watcher.on("error", () => watcher.close());
+          return [watcher];
+        } catch {
+          return [];
+        }
+      }),
+    ),
+    (watchers) => Effect.sync(() => watchers.forEach((watcher) => watcher.close())),
+  );
+
+  yield* refreshLocked;
+
+  yield* Stream.fromQueue(touched).pipe(
+    Stream.debounce(Duration.millis(250)),
+    Stream.runForEach(() => refreshLocked),
+    Effect.forkScoped,
+  );
+
+  return JbusWork.of({
+    subscribe: subscribeBeforeSnapshot(changes, Ref.get(state), mutex),
+  });
+});
+
+export const layer = Layer.effect(JbusWork, make(defaultJbusWorkRoots()));
