+ * Where a task stands of `SEGMENTS`: null while it is queued, before its crew. The part of its
+ * review (review 1, fixing, review 2) is only in its word.
  */
-export interface JstackTicks {
-  readonly step: number;
-  readonly hollow: boolean;
+export interface JstackProgress {
