+/** The type of the first text in `row` that reads `text`, as the user sees it. */
+function typeOf(row: HTMLElement, text: string) {
+  const span = [...row.querySelectorAll<HTMLElement>("span, b")].find(
+    (element) => element.textContent === text,
+  );
+  if (span === undefined) throw new Error(`no text ${text} in the row`);
+  const style = getComputedStyle(span);
+  return { fontSize: style.fontSize, fontWeight: style.fontWeight };
+}
