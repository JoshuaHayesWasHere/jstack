+/** The theme's warning colour, amber, as the browser computes it. */
+const amber = () => {
+  const probe = document.createElement("i");
+  probe.className = "bg-warning";
+  document.body.append(probe);
+  const color = getComputedStyle(probe).backgroundColor;
+  probe.remove();
+  return color;
 };
 
+/** How each of a row's three segments, crew, review and merge, is drawn: amber, or its ink. */
+const segmentsOf = (row: Element) =>
+  [...row.querySelectorAll("i")].map((segment) => {
+    const color = getComputedStyle(segment).backgroundColor;
+    return color === amber() ? "amber" : Math.round(alphaOf(color) * 100) / 100;
+  });
