 .../sidebar/jstackTree.logic.test.ts          |  1 +
 .../components/sidebar/jstackTree.logic.ts    | 24 ++++++++++++-------
 packages/contracts/src/jbusWork.ts            |  6 +++++
 7 files changed, 49 insertions(+), 11 deletions(-)

