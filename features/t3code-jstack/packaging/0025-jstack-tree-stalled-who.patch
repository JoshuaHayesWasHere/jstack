+  it("carries who holds each row's next move, so the tree says stalled only of a crew that owes it", () => {
+    const work = {
+      work: [
+        row("on-ci", "check", "check", { who: "ci", waits: "the check runner" }),
+        row("on-crew", "rebase", "rebase", { who: "crew", waits: "its crewmate" }),
+      ],
+    };
+    const result = buildRepoWork(files({ work }), NOW);
+    expect(result.tasks.map((task) => [task.slug, task.who, task.waits])).toEqual([
+      ["on-ci", "ci", "the check runner"],
+      ["on-crew", "crew", "its crewmate"],
+    ]);
+  });
+
   it("carries each task's brief title and each gate's default, for the ask the tree unfolds", () => {
     const result = buildRepoWork(
       files({
