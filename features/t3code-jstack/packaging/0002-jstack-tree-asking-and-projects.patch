+
+const ASKS_STATUSES = new Set(["approval", "input", "request"]);
+
+/** Whether a folder has nothing running or waiting on you, so it fades below the divider. */
+export function jstackFolderIdle(threads: readonly EnvironmentThreadShell[]): boolean {
+  return threads.every((thread) => {
+    const status = resolveSidebarThreadStatus(thread);
+    return status !== "working" && !ASKS_STATUSES.has(status);
+  });
+}
+
+/**
+ * A project with no jstack home, in the tree's project-row style: its name folds it, since it
+ * has no main thread to open, and amber marks only a thread that waits on you.
+ */
+export const JstackFolderRow = memo(function JstackFolderRow(props: {
+  group: SidebarProjectSnapshot;
+  rowId: string;
+  collapsed: boolean;
+  threads: readonly EnvironmentThreadShell[];
+  hiddenThreads: readonly EnvironmentThreadShell[];
+  onToggle: (group: SidebarProjectSnapshot) => void;
+  onNewThread: (group: SidebarProjectSnapshot) => void;
+  onContextMenu: (group: SidebarProjectSnapshot, position: { x: number; y: number }) => void;
+}) {
+  const { group, collapsed, hiddenThreads } = props;
+  const asks = hiddenThreads.some((thread) =>
+    ASKS_STATUSES.has(resolveSidebarThreadStatus(thread)),
+  );
+  return (
+    <li
+      data-testid="jstack-tree-folder"
+      className={cn(
+        "group/project-folder relative mt-2 list-none first:mt-0",
+        jstackFolderIdle([...props.threads, ...hiddenThreads]) && "opacity-50",
+      )}
+    >
+      <button
+        type="button"
+        role="treeitem"
+        tabIndex={-1}
+        data-sidebar-row={props.rowId}
+        aria-expanded={!collapsed}
+        aria-label={`${group.displayName}${asks ? ", asks you" : ""}`}
+        onClick={() => props.onToggle(group)}
+        onContextMenu={(event) => {
+          event.preventDefault();
+          props.onContextMenu(group, { x: event.clientX, y: event.clientY });
+        }}
+        className={cn(ROW_BUTTON, "h-8 pr-14")}
+      >
+        <ProjectFavicon project={group} className="size-4 shrink-0" />
+        <span className="min-w-0 flex-1 truncate text-sm font-semibold text-sidebar-foreground">
+          {group.displayName}
+        </span>
+        {asks ? <GateDot /> : null}
+        {collapsed && hiddenThreads.length > 0 ? (
+          <span className="shrink-0 text-2xs tabular-nums text-sidebar-muted-foreground">
+            {hiddenThreads.length}
+          </span>
+        ) : null}
+      </button>
+      <span className="absolute inset-y-0 right-1 flex items-center gap-0.5">
+        <span className="opacity-0 focus-within:opacity-100 group-hover/project-folder:opacity-100 pointer-coarse:opacity-100">
+          <Button
+            data-sidebar-action-for={props.rowId}
+            size="icon-xs"
+            variant="ghost-muted"
+            aria-label={`New thread in ${group.displayName}`}
+            onClick={() => props.onNewThread(group)}
+          >
+            <SquarePenIcon aria-hidden />
+          </Button>
+        </span>
+        <button
+          type="button"
+          tabIndex={-1}
+          aria-label={collapsed ? `Unfold ${group.displayName}` : `Fold ${group.displayName}`}
+          onClick={() => props.onToggle(group)}
+          className="flex size-6 items-center justify-center rounded-(--control-radius) text-sidebar-muted-foreground outline-none hover:bg-sidebar-row-hover hover:text-sidebar-foreground focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
+        >
+          <ChevronDownIcon
+            aria-hidden
+            className={cn("size-3.5 transition-transform", collapsed && "-rotate-90")}
+          />
+        </button>
+      </span>
+    </li>
+  );
+});
