+/** A colour as the screen paints it on `under`, alpha and all: [r, g, b] in 0..255. */
+const painted = (color: string, under: string) => {
+  const canvas = document.createElement("canvas");
+  canvas.width = 1;
+  canvas.height = 1;
+  const context = canvas.getContext("2d")!;
+  context.fillStyle = under;
+  context.fillRect(0, 0, 1, 1);
+  context.fillStyle = color;
+  context.fillRect(0, 0, 1, 1);
+  const [r = 0, g = 0, b = 0] = context.getImageData(0, 0, 1, 1).data;
+  return [r, g, b];
+};
+
+/** WCAG 2.x relative luminance of a painted colour. */
+const luminance = (rgb: ReadonlyArray<number>) => {
+  const [r = 0, g = 0, b = 0] = rgb.map((channel) => {
+    const value = channel / 255;
+    return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+};
+
+/** The WCAG 2.x contrast of `ink` painted on `background`. */
+const contrast = (ink: string, background: string) => {
+  const [lighter, darker] = [
+    luminance(painted(ink, background)),
+    luminance(painted(background, "#000")),
+  ].toSorted((a, b) => b - a);
+  return (lighter! + 0.05) / (darker! + 0.05);
+};
