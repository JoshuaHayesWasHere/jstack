+/** The colour a utility class gives text, as the browser computes it in the current theme. */
+const inkOf = (className: string) => {
+  const probe = document.createElement("i");
+  probe.className = className;
+  document.body.append(probe);
+  const color = getComputedStyle(probe).color;
+  probe.remove();
+  return color;
+};
+
+/** An ink by name: sky, amber, muted, or the alpha of the sidebar's ink. */
+const named = (color: string) =>
+  color === inkOf("text-jstack-live")
+    ? "sky"
+    : color === inkOf("text-jstack-asks")
+      ? "amber"
+      : color === inkOf("text-sidebar-muted-foreground")
+        ? "muted"
+        : Math.round(alphaOf(color) * 100) / 100;
+
+/**
+ * A row's mark as drawn: a ring by how many of its thirds are filled, a diamond by which of its
+ * halves are, upper then lower, each with its ink.
+ */
+const markOf = (row: Element) => {
+  const svg = row.querySelector<SVGSVGElement>("svg[data-jstack-mark]");
+  if (svg === null) return null;
+  const box = svg.getBoundingClientRect();
+  const filled = [...svg.querySelectorAll("path")].map(
+    (part) => getComputedStyle(part).fill !== "none",
+  );
+  const ink = named(getComputedStyle(svg).color);
+  return svg.dataset.jstackMark === "ring"
+    ? { ring: filled.filter(Boolean).length, size: box.width, ink }
+    : { diamond: filled.slice(0, 2), size: box.width, ink };
+};
