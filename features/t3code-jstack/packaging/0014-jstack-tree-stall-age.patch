 };
 
+/** The stages in which a task's pull request is open. */
+const PULL_STAGES: ReadonlySet<JbusWorkStage> = new Set([
+  "review",
+  "findings",
+  "second",
+  "check",
+  "rebase",
+]);
+
+/** How long a task has waited, if it has waited long enough to say: see `JstackWaited`. */
+const waitedOf = (
+  input: JstackTreeInput,
+  task: JbusTask,
+  thread: EnvironmentThreadShell | null,
+): JstackWaited | null => {
+  if (task.held !== null) {
+    const age = formatAge(minutesSince(input.nowMs, task.held.since));
+    return { kind: "held", age, reason: task.held.reason === "" ? null : task.held.reason };
+  }
+  if (input.options.attention !== "gates-and-quiet" || thread === null) return null;
+  if (task.stage === "quiet") {
+    const minutes = minutesSince(input.nowMs, thread.updatedAt);
+    return minutes < input.options.quietMinutes
+      ? null
+      : { kind: "quiet", age: formatAge(minutes), reason: null };
+  }
+  if (task.kind !== "crew" || !PULL_STAGES.has(task.stage)) return null;
+  if (resolveSidebarThreadStatus(thread) === "working") return null;
+  // Its last turn's end, since a rename or a linked pull request also moves `updatedAt`.
+  const minutes = minutesSince(input.nowMs, thread.latestRun?.completedAt ?? thread.updatedAt);
+  return minutes < input.options.quietMinutes
+    ? null
+    : { kind: "stalled", age: formatAge(minutes), reason: null };
