+/**
+ * How long a task has waited, drawn beside its stage word: `quiet` for a crew that stopped writing
+ * before its pull request, `stalled` for one idle while its pull request waits, `held` for a pull
+ * request jmerge or jbus holds, with why.
+ */
+export interface JstackWaited {
+  readonly kind: "quiet" | "stalled" | "held";
+  /** Such as `45m`. */
+  readonly age: string;
+  /** Why it is held; null for a quiet or stalled crew. */
+  readonly reason: string | null;
+}
+
+/** A wait as words, such as `held 3h: draft`. */
+export const waitedText = (waited: JstackWaited): string =>
+  `${waited.kind} ${waited.age}${waited.reason === null ? "" : `: ${waited.reason}`}`;
+
 export interface JstackTally {
   readonly queue: number;
   readonly crew: number;
@@ -129,6 +146,7 @@ export type JstackTreeRow =
       readonly prefix: string | null;
       readonly word: string;
       readonly tone: "asks" | "plain";
+      readonly waited: JstackWaited | null;
       /** null for a scout, which draws one dot. */
       readonly ticks: JstackTicks | null;
       /** null until jbus launches the task. */
@@ -261,7 +279,10 @@ const WORKER_TITLE = /^(crew|scout|review):/i;
 
 const MINUTE_MS = 60_000;
 
-const formatQuietAge = (minutes: number): string =>
+const minutesSince = (nowMs: number, at: string) =>
+  Math.max(0, Math.floor((nowMs - Date.parse(at)) / MINUTE_MS));
+
+const formatAge = (minutes: number): string =>
   minutes < 60
     ? `${minutes}m`
     : minutes < 48 * 60
@@ -301,6 +322,41 @@ const STAGES: Record<
   rebase: { word: "rebase", step: 5, group: "review", rank: 3 },
 };
 
+/** The stages in which a task's pull request is open. */
+const PULL_STAGES: ReadonlySet<JbusWorkStage> = new Set([
+  "review",
+  "findings",
+  "second",
+  "check",
+  "rebase",
+]);
+
+/** How long a task has waited, if it has waited long enough to say: see `JstackWaited`. */
+const waitedOf = (
+  input: JstackTreeInput,
+  task: JbusTask,
+  thread: EnvironmentThreadShell | null,
+): JstackWaited | null => {
+  if (task.held !== null) {
+    const age = formatAge(minutesSince(input.nowMs, task.held.since));
+    return { kind: "held", age, reason: task.held.reason === "" ? null : task.held.reason };
+  }
+  if (input.options.attention !== "gates-and-quiet" || thread === null) return null;
+  if (task.stage === "quiet") {
+    const minutes = minutesSince(input.nowMs, thread.updatedAt);
+    return minutes < input.options.quietMinutes
+      ? null
+      : { kind: "quiet", age: formatAge(minutes), reason: null };
+  }
+  if (task.kind !== "crew" || !PULL_STAGES.has(task.stage)) return null;
+  if (resolveSidebarThreadStatus(thread) === "working") return null;
+  // Its last turn's end, since a rename or a linked pull request also moves `updatedAt`.
+  const minutes = minutesSince(input.nowMs, thread.latestRun?.completedAt ?? thread.updatedAt);
+  return minutes < input.options.quietMinutes
+    ? null
+    : { kind: "stalled", age: formatAge(minutes), reason: null };
+};
+
 /** How many ticks a task's row draws: one for each step, and the merge. */
 export const TICKS = 7;
 
