@@ -83,6 +88,41 @@ const placeWorkRow = (value: string, lane: string): Placement | null => {
   }
 };
 
+interface Holds {
+  readonly bySlug: ReadonlyMap<string, JbusHeld>;
+  /** By pull request, as a row names it: `#3`. */
+  readonly byPull: ReadonlyMap<string, JbusHeld>;
+}
+
+/**
+ * The holds on a repo's rows. jmerge's are `hold` items of `waiting-on-user.json`, keyed `#<n>`,
+ * whose line is `hold <n> <url>: <reason>` (jmerge.lines.waits). jbus's are `held.json`, whose
+ * own `since` is when the hold began, which the `held` item of `waiting-on-user.json` lists only
+ * later, once it wakes the home.
+ */
+const holdsOf = (files: Pick<JbusRepoFiles, "waiting" | "held">): Holds => {
+  const bySlug = new Map<string, JbusHeld>();
+  const byPull = new Map<string, JbusHeld>();
+  for (const item of records(files.waiting)) {
+    const key = text(item.key);
+    const since = text(item.since);
+    const line = text(item.line);
+    if (item.kind !== "hold" || key === null || since === null || line === null) continue;
+    const url = text(item.url);
+    const after = url === null ? -1 : line.indexOf(`${url}: `);
+    const reason = after < 0 ? line : line.slice(after + `${url}: `.length);
+    byPull.set(key, { since, reason });
+  }
+  for (const one of records(files.held)) {
+    const since = text(one.since);
+    if (since === null || !Array.isArray(one.rows)) continue;
+    for (const slug of one.rows) {
+      if (typeof slug === "string") bySlug.set(slug, { since, reason: text(one.reason) ?? "" });
+    }
+  }
+  return { bySlug, byPull };
+};
+
 /** What a row waits on the user for, from jbus's `value` and `who` (features/jbus/src/jbus/work.py). */
 const waitsOnOf = (value: string, who: unknown): JbusWaitsOn | null => {
   if (who !== "user") return null;
@@ -165,12 +205,14 @@ export const buildRepoWork = (files: JbusRepoFiles, nowMs: number): JbusWorkSnap
   };
 
