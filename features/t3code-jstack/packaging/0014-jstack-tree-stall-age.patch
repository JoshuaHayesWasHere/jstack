     if (slug === null || row.kind !== "row") continue;
     const placed = placeWorkRow(text(row.value) ?? "", text(row.lane) ?? "");
     if (placed === null) continue;
+    const pullRequest = text(row.pr);
     tasks.push({
       repo,
       slug,
@@ -178,10 +220,14 @@ export const buildRepoWork = (files: JbusRepoFiles, nowMs: number): JbusWorkSnap
       stage: placed.stage,
       threadId: threadIdOf(row.thread),
       homeThreadId: homeOfSlug(slug),
-      pullRequest: text(row.pr),
+      pullRequest,
       waitsOn: waitsOnOf(text(row.value) ?? "", row.who),
       waits: text(row.waits) ?? "",
       brief: files.briefTitles.get(slug) ?? null,
+      held:
+        (pullRequest === null ? undefined : holds.byPull.get(pullRequest)) ??
+        holds.bySlug.get(slug) ??
+        null,
     });
   }
   for (const scout of records(files.scouts)) {
@@ -201,6 +247,7 @@ export const buildRepoWork = (files: JbusRepoFiles, nowMs: number): JbusWorkSnap
       waitsOn: null,
       waits: "",
       brief: null,
+      held: null,
     });
