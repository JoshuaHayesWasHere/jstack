-  const startingScopes = files.startingScopes.map((scope) => ({ repo, scope }));
+  const relaunches = isRecord(files.relaunches) ? files.relaunches : {};
+  const startingScopes = files.startingScopes.map((scope) => {
+    const launch = relaunches[scope];
+    const says = isRecord(launch) ? text(launch.says) : null;
+    return says === null ? { repo, scope } : { repo, scope, says };
+  });
   return { homes, startingScopes, tasks, gates, landed };
 };
 
diff --git a/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx b/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx
index 0744dce92a..3afda4861f 100644
--- a/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx
+++ b/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx
@@ -766,3 +766,31 @@ describe("JstackTreeRowView pinned homes", () => {
     expect(await auditIdle()).toEqual([]);
   });
 });
+
+describe("JstackTreeRowView starting homes", () => {
+  it("says why a starting home's start failed in place of starting..., and starting... while none did", async () => {
+    const says = "start failed: not signed in: waits for claudeAgent to be signed in again";
+    const snapshot: JbusWorkSnapshot = {
+      ...SNAPSHOT,
+      startingScopes: [
+        { repo: "jstack", scope: "infra" },
+        { repo: "jstack", scope: "ops", says },
+      ],
+    };
+    await using screen = await render(<LiveTree snapshot={snapshot} spies={actions()} sent={[]} />);
+    const rowOf = (scope: string) =>
+      screen.container.querySelector<HTMLElement>(
+        `[data-sidebar-row="jstack-starting:jstack/${scope}"]`,
+      )!;
+    await expect.element(rowOf("ops")).toBeVisible();
+    expect(rowOf("ops").textContent).toBe(`ops ${says}`);
+    expect(rowOf("ops").textContent).not.toContain("starting...");
+    expect(rowOf("infra").textContent).toBe("infra starting...");
+    // The words outrun the row: the whole of them is on hover.
+    await userEvent.hover(rowOf("ops"));
+    await vi.waitFor(() =>
+      expect(document.querySelector('[data-slot="tooltip-popup"]')?.textContent).toBe(says),
+    );
+    expect(await audit()).toEqual([]);
+  });
+});
