   /** `home/<repo>/home-id`. */
   readonly rootHomeId: string | null;
   readonly scopes: ReadonlyArray<{
@@ -281,7 +283,12 @@ export const buildRepoWork = (files: JbusRepoFiles, nowMs: number): JbusWorkSnap
     }
