From: JoshuaHayesWasHere <josh.hayes121@icloud.com>
Date: Mon, 9 Nov 2026 10:53:22 -0500
Subject: [PATCH 30/30] fix(web): a starting jstack home says why its start
 failed, from jbus's relaunches.json

JbusWork reads relaunches.json beside work.json and carries its `says` on
each starting scope; the tree's starting-home row prints it in place of
"starting...", whole on hover.
---
 apps/server/src/jstack/JbusWork.test.ts       | 44 ++++++++++++++++++-
 apps/server/src/jstack/JbusWork.ts            |  2 +
 apps/server/src/jstack/jbusWork.logic.test.ts |  1 +
 apps/server/src/jstack/jbusWork.logic.ts      |  9 +++-
 .../sidebar/JstackTreeRows.browser.test.tsx   | 28 ++++++++++++
 .../src/components/sidebar/JstackTreeRows.tsx | 43 ++++++++++++------
 .../components/sidebar/jstackTree.logic.ts    | 11 +++--
 packages/contracts/src/jbusWork.ts            |  2 +
 8 files changed, 122 insertions(+), 18 deletions(-)

diff --git a/apps/server/src/jstack/JbusWork.test.ts b/apps/server/src/jstack/JbusWork.test.ts
index c30e8437c6..b96bb4f355 100644
--- a/apps/server/src/jstack/JbusWork.test.ts
+++ b/apps/server/src/jstack/JbusWork.test.ts
@@ -54,7 +54,7 @@ it.live(
       yield* fs.writeFileString(path.join(scope, "plan.md"), "# jstack, ops: plan\n");
       yield* fs.writeFileString(path.join(scope, "prefix"), "ops-\n");
       const starting = yield* nextWhere(changes, (next) => next.startingScopes.length > 0);
-      assert.deepEqual(
+      assert.deepEqual<unknown>(
         Option.map(starting, (next) => [next.startingScopes, next.homes.map((home) => home.scope)]),
         Option.some([[{ repo: "jstack", scope: "ops" }], [null]]),
       );
@@ -106,3 +106,45 @@ it.live("shows a work.json write while jbus writes its outbox.lock beside it wit
     assert.isTrue(Option.isSome(quiet));
   }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
 );
+
+it.live("says why a starting scope's home did not start, from jbus's relaunches.json", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const { roots } = yield* seed;
+    for (const scope of ["ops", "flow"]) {
+      yield* fs.makeDirectory(path.join(roots.home, "jstack", scope));
+      yield* fs.writeFileString(path.join(roots.home, "jstack", scope, "plan.md"), "# plan\n");
+    }
+    const service = yield* JbusWork.make(roots);
+    const { latest, changes } = yield* service.subscribe;
+    assert.deepEqual(latest.startingScopes, [
+      { repo: "jstack", scope: "flow" },
+      { repo: "jstack", scope: "ops" },
+    ]);
+
+    // What jbus writes once the ops home's start failed; flow's last launch says nothing.
+    yield* fs.writeFileString(
+      path.join(roots.jbus, "jstack", "relaunches.json"),
+      JSON.stringify({
+        ops: {
+          at: "2026-11-09T15:35:05+00:00",
+          thread: "mcp:ops",
+          why: "it has no thread",
+          says: "start failed: not signed in",
+        },
+        flow: { at: "2026-11-09T15:35:05+00:00", thread: "mcp:flow", why: "it has no thread" },
+      }),
+    );
+    const failed = yield* nextWhere(changes, (next) =>
+      next.startingScopes.some((each) => each.says !== undefined),
+    );
+    assert.deepEqual(
+      Option.map(failed, (next) => next.startingScopes),
+      Option.some([
+        { repo: "jstack", scope: "flow" },
+        { repo: "jstack", scope: "ops", says: "start failed: not signed in" },
+      ]),
+    );
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
