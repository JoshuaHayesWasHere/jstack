+import { orderItemsByPreferredIds, resolveSidebarThreadStatus } from "../Sidebar.logic";
 
 // jstack fork: the tree sidebar's rows, from jbus's snapshot joined to T3's threads by id.
 // Every T3 project is a root row: a jstack root home's project, a plain folder, or "No project".
@@ -621,6 +621,107 @@ export function arrangeJstackRoots<T>(
