+import { getProjectOrderKey } from "@t3tools/client-runtime/state/project-grouping";
+import { EnvironmentId, ProjectId } from "@t3tools/contracts";
+import { describe, expect, it, vi } from "vite-plus/test";
+import { userEvent } from "vite-plus/test/browser";
+
+import "~/index.css";
+import { act, render } from "../../../test/render";
+import { attachSidebarTree, SIDEBAR_TREE_PROPS } from "../../lib/sidebarTree";
+import type { SidebarProjectSnapshot } from "../../sidebarProjectGrouping";
+import {
+  parsePersistedState,
+  PERSISTED_STATE_KEY,
+  type PersistedUiState,
+  useUiStateStore,
+} from "../../uiStateStore";
+import type { JstackRootRow } from "./jstackTree.logic";
+import { useJstackRootOrder } from "./jstackRootOrder";
+import { JstackTreeRowView, type JstackTreeRowActions } from "./JstackTreeRows";
+
+const environmentId = EnvironmentId.make("environment-local");
+
+interface Root {
+  readonly row: JstackRootRow;
+  readonly group: SidebarProjectSnapshot;
+}
+
+/** A project's root row: active unless idle, and "No project" pinned last. */
+const root = (name: string, idle: boolean, noProject = false): Root => {
+  const projectId = ProjectId.make(`project-${name}`);
+  const member = {
+    id: projectId,
+    environmentId,
+    title: name,
+    workspaceRoot: `/repos/${name}`,
+    physicalProjectKey: `${environmentId}:/repos/${name}`,
+    environmentLabel: null,
+    defaultModelSelection: null,
+    scripts: [],
+    projectIcon: null,
+    createdAt: "2026-10-29T00:00:00.000Z",
+    updatedAt: "2026-10-29T00:00:00.000Z",
+  };
+  return {
+    row: {
+      kind: "project",
+      key: `root:${name}`,
+      main: null,
+      noProject,
+      collapsed: false,
+      asksYou: false,
+      dot: false,
+      landed: 0,
+      folded: { count: 0, unit: "thread" },
+      faded: idle,
+      selected: false,
+    },
+    group: {
+      ...member,
+      projectKey: name,
+      displayName: name,
+      memberProjects: [member],
+      memberProjectRefs: [{ environmentId, projectId }],
+      groupedProjectCount: 1,
+      environmentPresence: "local-only",
+      allRemoteMembersAreDesktopLocal: false,
+      allRemoteMembersAreWsl: false,
+      remoteEnvironmentLabels: [],
+    } as SidebarProjectSnapshot,
+  };
+};
+
+// The sidebar's own order: alpha and gamma are active, beta and delta idle.
+const ROOTS = [
+  root("alpha", false),
+  root("beta", true),
+  root("gamma", false),
+  root("delta", true),
+  root("No project", true, true),
+];
+
+const noop = () => {};
+const actions = (order: ReturnType<typeof useJstackRootOrder<Root>>): JstackTreeRowActions => ({
+  onOpenThread: noop,
+  onToggleProject: noop,
+  onExpandHome: noop,
+  onNewThread: noop,
+  onCopyPath: noop,
+  onOpenProjectSettings: noop,
+  onCopyName: noop,
+  onHomeWork: noop,
+  onArchiveHome: noop,
+  onStartHome: noop,
+  onOpenChildHomeEditor: noop,
+  onCloseChildHomeEditor: noop,
+  onSendChildHome: async () => true,
+  onDismissStartingHome: noop,
+  onOpenBrief: noop,
+  onRemoveTask: noop,
+  onOpenAnswer: noop,
+  onCloseAnswer: noop,
+  onSendAnswer: async () => true,
+  onPressRoot: order.press,
+  onStepRoot: order.step,
+});
+
+/** The tree's roots as the sidebar draws them, with the divider above the idle ones. */
+function Roots(props: { roots: ReadonlyArray<Root> }) {
+  const order = useJstackRootOrder({
+    roots: props.roots,
+    head: (one) => one.row,
+    orderIds: (one) => one.group.memberProjects.map(getProjectOrderKey),
+    dragDistance: 6,
+  });
+  return (
+    <>
+      <ul
+        {...SIDEBAR_TREE_PROPS}
+        ref={attachSidebarTree}
+        className="flex w-[300px] flex-col gap-px bg-sidebar"
+      >
+        {order.roots.flatMap((one) => [
+          one === order.dividerBefore ? (
+            <li key="divider" aria-hidden data-testid="divider" className="my-2 border-t" />
+          ) : null,
+          <JstackTreeRowView
+            key={one.row.key}
+            row={one.row}
+            group={one.group}
+            actions={actions(order)}
+            place={order.placeOf(one.row.key)}
+            dragging={order.drag?.key === one.row.key}
+          />,
+        ])}
+      </ul>
+      <p aria-live="polite" data-testid="said">
+        {order.said}
+      </p>
+    </>
+  );
+}
+
+/** The roots in drawn order, "|" for the divider. */
+const drawn = (container: HTMLElement) =>
+  [
+    ...container.querySelectorAll<HTMLElement>(
+      '[data-testid="jstack-tree-project"], [data-testid="divider"]',
+    ),
+  ].map((item) =>
+    item.dataset.testid === "divider"
+      ? "|"
+      : item.querySelector("[data-sidebar-row] span")!.textContent,
+  );
+
+const rowOf = (container: HTMLElement, name: string) =>
+  container.querySelector<HTMLElement>(`[data-sidebar-row="root:${name}"]`)!;
+
+const pointer = (type: string, x: number, y: number, buttons: number) =>
+  new PointerEvent(type, {
+    bubbles: true,
+    cancelable: true,
+    composed: true,
+    pointerId: 1,
+    isPrimary: true,
+    button: 0,
+    buttons,
+    clientX: x,
+    clientY: y,
+  });
+
+/** Presses a root row and drags it to `y`, in steps, as a mouse does; release ends it. */
+async function drag(row: HTMLElement, y: number, release = true) {
+  const rect = row.getBoundingClientRect();
+  const x = rect.left + 40;
+  let at = rect.top + rect.height / 2;
+  await act(() => row.dispatchEvent(pointer("pointerdown", x, at, 1)));
+  const step = (y - at) / 8;
+  for (let index = 0; index < 8; index++) {
+    at += step;
+    await act(() => document.dispatchEvent(pointer("pointermove", x, at, 1)));
+  }
+  if (release) await act(() => document.dispatchEvent(pointer("pointerup", x, at, 0)));
+}
+
+const centerOf = (row: HTMLElement) => {
+  const rect = row.getBoundingClientRect();
+  return rect.top + rect.height / 2;
+};
+
+/** What a reload reads back: the UI state as the browser keeps it. */
+const reload = () => {
+  const kept = window.localStorage.getItem(PERSISTED_STATE_KEY);
+  useUiStateStore.setState(
+    parsePersistedState(kept === null ? {} : (JSON.parse(kept) as PersistedUiState)),
+  );
+};
+
+/** A project order no other test sees, kept nowhere once the test ends. */
+function freshOrder() {
+  const forget = () => {
+    window.localStorage.removeItem(PERSISTED_STATE_KEY);
+    useUiStateStore.setState({ projectOrder: [] });
+  };
+  forget();
+  const stack = new DisposableStack();
+  stack.defer(forget);
+  return stack;
+}
+
+describe("dragging a jstack root row", () => {
+  it("moves a root by mouse within its group, and keeps the place across a reload", async () => {
+    using _order = freshOrder();
+    const screen = await render(<Roots roots={ROOTS} />, { router: false });
+    expect(drawn(screen.container)).toEqual(["alpha", "gamma", "|", "beta", "delta", "No project"]);
+
+    // Mid-drag, the row shows at the place it would drop at, and its group makes room.
+    const gamma = rowOf(screen.container, "gamma");
+    await drag(gamma, centerOf(rowOf(screen.container, "alpha")) - 10, false);
+    expect(drawn(screen.container)).toEqual(["gamma", "alpha", "|", "beta", "delta", "No project"]);
+    expect(gamma.closest("li")!.hasAttribute("data-dragging")).toBe(true);
+    await act(() => document.dispatchEvent(pointer("pointerup", 0, 0, 0)));
+    expect(gamma.closest("li")!.hasAttribute("data-dragging")).toBe(false);
+    expect(drawn(screen.container)).toEqual(["gamma", "alpha", "|", "beta", "delta", "No project"]);
+
+    // The UI state writes it down, and a fresh start draws the same order.
+    await vi.waitFor(() =>
+      expect(window.localStorage.getItem(PERSISTED_STATE_KEY)).toContain("/repos/gamma"),
+    );
+    await screen[Symbol.asyncDispose]();
+    useUiStateStore.setState({ projectOrder: [] });
