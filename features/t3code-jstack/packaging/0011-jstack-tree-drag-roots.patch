+/** Where a root row stands in its own group, active or idle, and so where it can move. */
+export interface JstackRootPlace {
+  readonly index: number;
+  readonly count: number;
+  readonly idle: boolean;
+}
+
+/** The root rows that move among themselves: its group's, and none for "No project". */
+function rootGroup<T>(roots: ReadonlyArray<T>, head: (root: T) => JstackRootRow, key: string) {
+  const root = roots.find((one) => head(one).key === key);
+  if (root === undefined || head(root).noProject) return null;
+  const idle = head(root).faded;
+  const group = roots.filter((one) => !head(one).noProject && head(one).faded === idle);
+  return { root, idle, group };
+}
+
+export function jstackRootPlace<T>(
+  roots: ReadonlyArray<T>,
+  head: (root: T) => JstackRootRow,
+  key: string,
+): JstackRootPlace | null {
+  const found = rootGroup(roots, head, key);
+  if (found === null) return null;
+  return { index: found.group.indexOf(found.root), count: found.group.length, idle: found.idle };
+}
+
+/**
+ * Moves a root row to place `to` of its own group, which it never leaves: the divider and the
+ * groups stay automatic, and "No project" stays pinned last. `target` is the root whose place
+ * it takes. Null when nothing moves.
+ */
+export function moveJstackRoot<T>(
+  roots: ReadonlyArray<T>,
+  head: (root: T) => JstackRootRow,
+  key: string,
+  to: number,
+): { readonly roots: ReadonlyArray<T>; readonly dragged: T; readonly target: T } | null {
+  const found = rootGroup(roots, head, key);
+  if (found === null) return null;
+  const { root, idle, group } = found;
+  const place = Math.max(0, Math.min(to, group.length - 1));
+  if (group[place] === root) return null;
+  const target = group[place]!;
+  const moved = group.filter((one) => one !== root);
+  moved.splice(place, 0, root);
+  let next = 0;
+  return {
+    roots: roots.map((one) =>
+      !head(one).noProject && head(one).faded === idle ? moved[next++]! : one,
+    ),
+    dragged: root,
+    target,
+  };
+}
+
+/**
+ * Root rows in the order the user dragged them to, kept as the projects' order keys
+ * (`projectOrder`): ranked roots first, the rest after them in the sidebar's order. The split
+ * into active and idle comes after, so each group keeps this order.
+ */
+export function orderJstackRoots<T>(
+  roots: ReadonlyArray<T>,
+  head: (root: T) => JstackRootRow,
+  orderIds: (root: T) => ReadonlyArray<string>,
+  projectOrder: ReadonlyArray<string>,
+): ReadonlyArray<T> {
+  return orderItemsByPreferredIds({
+    items: roots,
+    preferredIds: projectOrder,
+    getId: (root) => head(root).key,
+    getPreferenceIds: orderIds,
+  });
+}
+
+/**
+ * What `reorderProjects` takes to move a root to place `to` of its group. The order it starts
+ * from is the one before the split, so a root that later turns active or idle keeps its rank
+ * among the others; projects the sidebar does not draw keep their keys, after these.
+ */
+export function jstackRootReorder<T>(
+  ordered: ReadonlyArray<T>,
+  head: (root: T) => JstackRootRow,
+  orderIds: (root: T) => ReadonlyArray<string>,
+  projectOrder: ReadonlyArray<string>,
+  move: { readonly key: string; readonly to: number },
+): {
+  readonly current: ReadonlyArray<string>;
+  readonly dragged: ReadonlyArray<string>;
+  readonly target: ReadonlyArray<string>;
+} | null {
+  const moved = moveJstackRoot(arrangeJstackRoots(ordered, head).roots, head, move.key, move.to);
+  if (moved === null) return null;
+  const drawn = ordered.filter((root) => !head(root).noProject).flatMap(orderIds);
+  const known = new Set(drawn);
+  return {
+    current: [...drawn, ...projectOrder.filter((id) => !known.has(id))],
+    dragged: orderIds(moved.dragged),
+    target: orderIds(moved.target),
+  };
+}
