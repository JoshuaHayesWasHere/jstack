diff --git a/apps/web/src/components/sidebar/jstackRootOrder.ts b/apps/web/src/components/sidebar/jstackRootOrder.ts
new file mode 100644
index 0000000000..f70b81782e
--- /dev/null
+++ b/apps/web/src/components/sidebar/jstackRootOrder.ts
@@ -0,0 +1,134 @@
+import { useRef, useState } from "react";
+
+import { useStableCallback } from "../../hooks/useStableCallback";
+import { useUiStateStore } from "../../uiStateStore";
+import { SidebarPointerSensor } from "../Sidebar.pointer";
+import {
+  arrangeJstackRoots,
+  jstackRootPlace,
+  jstackRootReorder,
+  moveJstackRoot,
+  orderJstackRoots,
+  type JstackRootPlace,
+  type JstackRootRow,
+} from "./jstackTree.logic";
+
+// jstack fork: the tree's root rows keep the order the user drags them to, within the active
+// group and within the idle one, as the projects' order (`projectOrder`), which the UI state
+// keeps across a reload. Which group a root is in stays automatic.
+
+/** The root being dragged, and the place of its group it would drop at. */
+export interface JstackRootDrag {
+  readonly key: string;
+  readonly to: number;
+}
+
+const rowOf = (key: string) =>
+  document.querySelector<HTMLElement>(`[data-sidebar-row="${CSS.escape(key)}"]`);
+
+export function useJstackRootOrder<T>(input: {
+  readonly roots: ReadonlyArray<T>;
+  readonly head: (root: T) => JstackRootRow;
+  /** The order keys of a root's projects, as `projectOrder` holds them. */
+  readonly orderIds: (root: T) => ReadonlyArray<string>;
+  /** How far the pointer goes before a press becomes a drag. */
+  readonly dragDistance: number;
+}) {
+  const { roots, head, orderIds } = input;
+  const projectOrder = useUiStateStore((store) => store.projectOrder);
+  const reorderProjects = useUiStateStore((store) => store.reorderProjects);
+  const [drag, setDrag] = useState<JstackRootDrag | null>(null);
+  // What a move announces, for a screen reader: the root's new place in its group.
+  const [said, setSaid] = useState("");
+  const sensorRef = useRef<SidebarPointerSensor | null>(null);
+
+  const ordered = orderJstackRoots(roots, head, orderIds, projectOrder);
+  const arranged = arrangeJstackRoots(ordered, head);
+  // While dragging, the root shows at the place it would drop at, and its group moves round it.
+  const preview = drag === null ? null : moveJstackRoot(arranged.roots, head, drag.key, drag.to);
+
+  const placeOf = (key: string): JstackRootPlace | null =>
+    jstackRootPlace(arranged.roots, head, key);
+
+  const move = useStableCallback((key: string, to: number) => {
+    const reorder = jstackRootReorder(ordered, head, orderIds, projectOrder, { key, to });
+    if (reorder === null) return false;
+    reorderProjects(reorder.current, reorder.dragged, reorder.target);
+    const place = jstackRootPlace(arranged.roots, head, key)!;
+    const at = Math.max(0, Math.min(to, place.count - 1));
+    setSaid(`Moved to ${at + 1} of ${place.count} ${place.idle ? "idle" : "active"} projects.`);
+    return true;
+  });
+
+  /** One place up or down its group, from the keyboard or the row's menu. */
+  const step = useStableCallback((key: string, by: -1 | 1) => {
+    const place = placeOf(key);
+    if (place === null || !move(key, place.index + by)) return;
+    // A row React moves down loses focus, so the tree's focus goes back to it once drawn.
+    window.requestAnimationFrame(() => rowOf(key)?.focus());
+  });
+
+  /** The place of its group a root dragged to `y` drops at, from where the others are drawn. */
+  const dropPlace = useStableCallback((key: string, y: number) => {
+    const idle = placeOf(key)?.idle;
+    return arranged.roots.filter((root) => {
+      const row = head(root);
+      if (row.key === key || row.noProject || row.faded !== idle) return false;
+      const rect = rowOf(row.key)?.getBoundingClientRect();
+      return rect !== undefined && rect.top + rect.height / 2 < y;
+    }).length;
+  });
+  // The sensor's callbacks outlive the render that made them, so they read the latest place.
+  const latestPlaceOf = useStableCallback(placeOf);
+
+  /** A press on a root row, which becomes a drag once the pointer has gone far enough. */
+  const press = useStableCallback((key: string, event: PointerEvent) => {
+    if (!event.isPrimary || event.button !== 0) return;
+    const start = placeOf(key);
+    if (start === null || start.count < 2) return;
+    let to = start.index;
+    sensorRef.current?.cancel();
+    sensorRef.current = new SidebarPointerSensor({
+      active: key,
+      event,
+      options: {
+        distance: input.dragDistance,
+        onAttach: () => {},
+        onFinish: () => {
+          sensorRef.current = null;
+          setDrag(null);
+        },
+      },
+      onPending: () => {},
+      onStart: () => setDrag({ key, to }),
+      onMove: ({ y }) => {
+        // A root that turns active or idle mid-drag has left the group it was dragged in.
+        if (latestPlaceOf(key)?.idle !== start.idle) {
+          sensorRef.current?.cancel();
+          return;
+        }
+        const next = dropPlace(key, y);
+        if (next === to) return;
+        to = next;
+        setDrag({ key, to });
+      },
+      onEnd: () => {
+        move(key, to);
+      },
+      onCancel: () => {},
+      onAbort: () => {},
+    });
+  });
+
+  const shown = preview?.roots ?? arranged.roots;
+  const firstIdle = shown.find((root) => head(root).faded);
+  return {
+    roots: shown,
+    dividerBefore: firstIdle === undefined || firstIdle === shown[0] ? null : firstIdle,
+    drag,
+    said,
+    placeOf,
+    step,
+    press,
+  };
+}
