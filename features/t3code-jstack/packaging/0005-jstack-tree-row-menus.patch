+
+/** What a tree row's context menu can do; `JstackTreeRowView` runs the one picked. */
+export type JstackRowMenuId =
+  | "open-home"
+  | "open-thread"
+  | "open-asked-in"
+  | "toggle-ask"
+  | "fold"
+  | "show-more"
+  | "new-thread"
+  | "copy-path"
+  | "project-settings"
+  | "copy-scope"
+  | "copy-slug";
+
+/**
+ * A tree row's context menu, one table per kind. Every row has one, so right-click, the
+ * ContextMenu key and Shift+F10 reach the same actions as the row's own click and buttons.
+ */
+export function jstackRowMenu(
+  row: Exclude<JstackTreeRow, { kind: "loose" }>,
+  state: { readonly askShown: boolean },
+): ReadonlyArray<ContextMenuItem<JstackRowMenuId>> {
+  switch (row.kind) {
+    case "project":
+      return [
+        ...(row.main === null ? [] : [{ id: "open-home" as const, label: "Open home" }]),
+        { id: "fold", label: row.collapsed ? "Unfold" : "Fold" },
+        { id: "new-thread", label: "New thread", separatorBefore: true },
+        { id: "copy-path", label: "Copy path" },
+        { id: "project-settings", label: "Project settings", icon: "settings" },
+      ];
+    case "domain":
+      return [
+        { id: "open-home", label: "Open home" },
+        { id: "copy-scope", label: "Copy scope name", separatorBefore: true },
+      ];
+    case "worker":
+      return [
+        ...(row.threadId !== null
+          ? [{ id: "open-thread" as const, label: "Open thread" }]
+          : row.ask === null
+            ? [{ id: "open-asked-in" as const, label: "Open its home" }]
+            : [
+                {
+                  id: "toggle-ask" as const,
+                  label: state.askShown ? "Hide what it asks" : "Show what it asks",
+                },
+                {
+                  id: "open-asked-in" as const,
+                  label: row.ask.askedIn === null ? "Open its home" : `Open ${row.ask.askedIn}`,
+                },
+              ]),
+        { id: "copy-slug", label: "Copy slug", separatorBefore: true },
+      ];
+    case "more":
+      return [{ id: "show-more", label: `Show ${row.count} more` }];
+  }
+}
