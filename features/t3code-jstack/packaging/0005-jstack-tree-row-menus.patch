+  ticks: { step: 0, hollow: true, asks: true },
+  threadId: null,
+  openThreadId: ThreadId.make("gate"),
+  ask: { what: "Which valve size?", askedIn: "gate thread" },
+};
+
+const menuItems = () =>
+  [...document.querySelectorAll('[role="menu"] [role="menuitem"]')].map((item) =>
+    item.textContent?.trim(),
+  );
+
+/** Every row kind the tree draws, under one root, as the sidebar draws them. */
+function everyRow(spies: JstackTreeRowActions) {
+  const jstack = group("jstack");
+  return render(
+    <Tree
+      actions={spies}
+      rows={[
+        [root(), jstack],
+        [home, jstack],
+        [worker, jstack],
+        [queued, jstack],
+        [asking, jstack],
+      ]}
+    />,
+    { router: false },
+  );
+}
+
+describe("JstackTreeRowView context menus", () => {
+  it("opens each row's own menu on right-click and runs what the mouse picks", async () => {
+    const spies = actions();
+    await using screen = await everyRow(spies);
+    const cases = [
+      {
+        name: /^jstack .*main thread$/,
+        items: ["Open home", "Fold", "New thread", "Copy path", "Project settings"],
+        pick: "Copy path",
+        ran: () => expect(spies.onCopyPath).toHaveBeenCalledWith(group("jstack")),
+      },
+      {
+        name: "flow home",
+        items: ["Open home", "Copy scope name"],
+        pick: "Open home",
+        ran: () => expect(spies.onOpenThread).toHaveBeenCalledWith(ThreadId.make("flow")),
+      },
+      {
+        name: "fl-pump crew",
+        items: ["Open thread", "Copy slug"],
+        pick: "Copy slug",
+        ran: () => expect(spies.onCopyName).toHaveBeenCalledWith("fl-pump", "slug"),
+      },
+      {
+        name: "fl-meter ready",
+        items: ["Open its home", "Copy slug"],
+        pick: "Open its home",
+        ran: () => expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("flow")),
+      },
+      {
+        name: "fl-valve asks you",
+        items: ["Show what it asks", "Open gate thread", "Copy slug"],
+        pick: "Open gate thread",
+        ran: () => expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("gate")),
+      },
+    ];
+    for (const one of cases) {
+      await userEvent.click(screen.getByRole("treeitem", { name: one.name }), { button: "right" });
+      await expect.element(page.getByRole("menu")).toBeVisible();
+      expect(menuItems()).toEqual(one.items);
+      await userEvent.click(page.getByRole("menuitem", { name: one.pick }));
+      await expect.element(page.getByRole("menu")).not.toBeInTheDocument();
+      one.ran();
+    }
+  });
+
+  it("opens the focused row's menu from the keyboard alone, on the ContextMenu key and on Shift+F10", async () => {
+    const spies = actions();
+    await using screen = await everyRow(spies);
+    const valve = screen.getByRole("treeitem", { name: "fl-valve asks you" });
+
+    // Tab into the tree, then walk down to the asking row: root, home, crew, queued, asking.
+    await userEvent.keyboard("{Tab}");
+    await expect
+      .element(screen.getByRole("treeitem", { name: /^jstack .*main thread$/ }))
+      .toHaveFocus();
+    await userEvent.keyboard("{ArrowDown}{ArrowDown}{ArrowDown}{ArrowDown}");
+    await expect.element(valve).toHaveFocus();
+
+    await userEvent.keyboard("{ContextMenu}");
+    await expect.element(page.getByRole("menuitem", { name: "Show what it asks" })).toHaveFocus();
+    await userEvent.keyboard("{Enter}");
+    await expect.element(page.getByRole("menu")).not.toBeInTheDocument();
+    await expect.element(valve).toHaveFocus();
+    await expect.element(screen.getByText("Which valve size?")).toBeVisible();
+
+    await userEvent.keyboard("{Shift>}{F10}{/Shift}");
+    await expect.element(page.getByRole("menuitem", { name: "Hide what it asks" })).toHaveFocus();
+    await userEvent.keyboard("{ArrowDown}{ArrowDown}{Enter}");
+    expect(spies.onCopyName).toHaveBeenCalledWith("fl-valve", "slug");
+
+    await userEvent.keyboard("{ArrowUp}{ArrowUp}{ArrowUp}{ArrowUp}");
+    await userEvent.keyboard("{Shift>}{F10}{/Shift}");
+    await expect.element(page.getByRole("menuitem", { name: "Open home" })).toHaveFocus();
+    await userEvent.keyboard("{ArrowDown}{Enter}");
+    expect(spies.onToggleProject).toHaveBeenCalledWith(group("jstack"));
+
+    await userEvent.keyboard("{ArrowDown}{ContextMenu}");
+    await expect.element(page.getByRole("menuitem", { name: "Open home" })).toHaveFocus();
+    await userEvent.keyboard("{Escape}");
+    await expect.element(page.getByRole("menu")).not.toBeInTheDocument();
+    await expect.element(screen.getByRole("treeitem", { name: "flow home" })).toHaveFocus();
+    expect(spies.onOpenThread).not.toHaveBeenCalled();
+  });
+
+  it("passes an axe check, with a row's menu open and with it closed", async () => {
+    await using screen = await everyRow(actions());
+    const audit = async () => {
+      // A bare render has no landmark around it; in the app the sidebar's own nav is one.
+      const result = await axe.run(document.body, { rules: { region: { enabled: false } } });
+      return result.violations.map((violation) => `${violation.id}: ${violation.help}`);
+    };
+    expect(await audit()).toEqual([]);
+    await userEvent.click(screen.getByRole("treeitem", { name: "flow home" }), {
+      button: "right",
+    });
+    await expect.element(page.getByRole("menu")).toBeVisible();
+    expect(await audit()).toEqual([]);
+    await userEvent.keyboard("{Escape}");
+  });
+});
