+import type { ThreadId } from "@t3tools/contracts";
+
+import { persistClientSettingsUpdate, useClientSettings } from "../../hooks/useSettings";
+import { toastManager } from "../ui/toast";
+import { togglePinnedHome } from "./jstackTree.logic";
+
+// jstack fork: the child homes the user pinned open in the tree, kept in the client settings
+// beside the tree's other options, so a pin lasts across a reload. T3's own thread pins are apart.
+
+export function useJstackPinnedHomes(): {
+  readonly pinnedHomes: ReadonlySet<ThreadId>;
+  readonly togglePin: (homeThreadId: ThreadId) => void;
+} {
+  const pinned = useClientSettings((settings) => settings.jstackTreePinnedHomes);
+  const pinnedHomes = new Set(pinned);
+  const togglePin = (homeThreadId: ThreadId) => {
+    // Read and written in one step, so a pin never undoes another setting's change.
+    persistClientSettingsUpdate((current) => ({
+      ...current,
+      jstackTreePinnedHomes: togglePinnedHome(current.jstackTreePinnedHomes, homeThreadId),
