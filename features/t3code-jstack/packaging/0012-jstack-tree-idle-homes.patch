+
+// flow has a task running; jview has nothing live and merged two lately; dictation has neither.
+const IDLE_SNAPSHOT: JbusWorkSnapshot = {
+  ...SNAPSHOT,
+  homes: [
+    ...SNAPSHOT.homes,
+    { repo: "jstack", scope: "jview", threadId: ThreadId.make("jview"), prefix: "jv-" },
+    { repo: "jstack", scope: "dictation", threadId: ThreadId.make("dictation"), prefix: "di-" },
+  ],
+  landed: [
+    {
+      repo: "jstack",
+      slug: "jv-graph",
+      homeThreadId: ThreadId.make("jview"),
+      mergedAt: "2026-10-29T09:00:00.000Z",
+    },
+    {
+      repo: "jstack",
+      slug: "jv-legend",
+      homeThreadId: ThreadId.make("jview"),
+      mergedAt: "2026-10-29T11:40:00.000Z",
+    },
+  ],
+};
+
+function idleTree(spies: JstackTreeRowActions) {
+  return render(<LiveTree snapshot={IDLE_SNAPSHOT} spies={spies} sent={[]} />, { router: false });
+}
+
+/**
+ * The audit, less contrast: an idle home draws at half ink, as idle roots do, which axe counts
+ * against it whatever this change does.
+ */
+const auditIdle = async () =>
+  (await audit()).filter((violation) => !violation.startsWith("color-contrast:"));
+
+const homeItem = (screen: Screen, scope: string) =>
+  screen.getByRole("treeitem", { name: new RegExp(`^${scope} .*home`) });
+
+/** The chevron the pointer folds a home by; the tree holds treeitems alone, so it is unseen. */
+const chevron = (screen: Screen, label: string) =>
+  screen.container.querySelector<HTMLElement>(`[aria-label="${label}"]`);
+
+/** What a line shows the eye: its text, less what only a screen reader says. */
+const shownText = (line: Element) => {
+  const copy = line.cloneNode(true) as Element;
+  for (const unseen of copy.querySelectorAll(".sr-only")) unseen.remove();
+  return copy.textContent;
+};
+
+/** The home's own list item, which holds its line and, for a live home, its tally. */
+const homeLine = (screen: Screen, scope: string) =>
+  homeItem(screen, scope).element().closest("li")!;
+
+describe("JstackTreeRowView idle homes", () => {
+  it("draws a home with no live work as its one line, name and age, and a live one with its tally", async () => {
+    await using screen = await idleTree(actions());
+    for (const scope of ["jview", "dictation"]) {
+      const line = homeLine(screen, scope);
+      // One 28px line: the row itself, with nothing drawn under it.
+      expect(line.getBoundingClientRect().height).toBe(28);
+      expect(shownText(line)).not.toMatch(/idle/);
+      // Its age, at the row's end.
+      expect(line.querySelector(".tabular-nums")?.textContent).not.toBe("");
+    }
+    // dictation finished nothing lately, so it has nothing to unfold.
+    expect(homeItem(screen, "dictation").element().hasAttribute("aria-expanded")).toBe(false);
+    await expect.element(homeItem(screen, "jview")).toHaveAttribute("aria-expanded", "false");
+
+    // The live home is as it was: a tally line under its row, and no fold of its own.
+    const flow = homeLine(screen, "flow");
+    expect(flow.getBoundingClientRect().height).toBeGreaterThan(28);
+    expect(shownText(flow)).toMatch(/crew 1/);
+    await expect.element(homeItem(screen, "flow")).toHaveAttribute("aria-expanded", "false");
+    expect(chevron(screen, "Unfold flow")).toBeNull();
+    expect(chevron(screen, "Unfold dictation")).toBeNull();
+    expect(await auditIdle()).toEqual([]);
+  });
+
+  it("by mouse: unfolds an idle home to what it merged, newest first, folds it again, and opens it from its name", async () => {
+    const spies = actions();
+    await using screen = await idleTree(spies);
+    await userEvent.click(chevron(screen, "Unfold jview")!);
+    await expect.element(homeItem(screen, "jview")).toHaveAttribute("aria-expanded", "true");
+    const legend = screen.getByRole("treeitem", { name: "jv-legend merged 20m" });
+    await expect.element(legend).toBeVisible();
+    await expect
+      .element(screen.getByRole("treeitem", { name: "jv-graph merged 3h" }))
+      .toBeVisible();
+    expect(
+      [...document.querySelectorAll("[data-sidebar-row^='jstack-finished:']")].map(
+        (row) => row.textContent,
+      ),
+    ).toEqual(["jv-legend merged 20m", "jv-graph merged 3h"]);
+    expect(await auditIdle()).toEqual([]);
+
+    await userEvent.click(legend);
+    expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("jview"));
+    await userEvent.click(chevron(screen, "Fold jview")!);
+    await expect.element(legend).not.toBeInTheDocument();
+    await expect.element(homeItem(screen, "jview")).toHaveAttribute("aria-expanded", "false");
+    expect(homeLine(screen, "jview").getBoundingClientRect().height).toBe(28);
+
+    // A click on the name still opens the home, and folds nothing.
+    await userEvent.click(homeItem(screen, "jview"));
+    expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("jview"));
+    await expect.element(homeItem(screen, "jview")).toHaveAttribute("aria-expanded", "false");
+    expect(spies.onToggleHome).toHaveBeenCalledTimes(2);
+  });
+
+  it("by keyboard alone: unfolds and folds an idle home with the arrow keys and its menu, and steps into what it merged", async () => {
+    const spies = actions();
+    await using screen = await idleTree(spies);
+    const jview = homeItem(screen, "jview");
+
+    // Root, tidy, flow, jview.
+    await userEvent.keyboard("{Tab}");
+    await expect.element(rootItem(screen)).toHaveFocus();
+    await userEvent.keyboard("{ArrowDown}{ArrowDown}{ArrowDown}");
+    await expect.element(jview).toHaveFocus();
+
+    await userEvent.keyboard("{ArrowRight}");
+    await expect.element(jview).toHaveAttribute("aria-expanded", "true");
+    await expect.element(jview).toHaveFocus();
+    await userEvent.keyboard("{ArrowRight}");
+    await expect
+      .element(screen.getByRole("treeitem", { name: "jv-legend merged 20m" }))
+      .toHaveFocus();
+    await userEvent.keyboard("{ArrowLeft}");
+    await expect.element(jview).toHaveFocus();
+    await userEvent.keyboard("{ArrowLeft}");
+    await expect.element(jview).toHaveAttribute("aria-expanded", "false");
+    await expect
+      .element(screen.getByRole("treeitem", { name: "jv-legend merged 20m" }))
+      .not.toBeInTheDocument();
+    expect(spies.onOpenThread).not.toHaveBeenCalled();
+
+    // Open home, Unfold; then Open home, Fold.
+    await userEvent.keyboard("{ContextMenu}");
+    await expect.element(page.getByRole("menuitem", { name: "Open home" })).toHaveFocus();
+    await userEvent.keyboard("{ArrowDown}{Enter}");
+    await expect.element(jview).toHaveAttribute("aria-expanded", "true");
+    await expect.element(jview).toHaveFocus();
+    await userEvent.keyboard("{Shift>}{F10}{/Shift}");
+    await expect.element(page.getByRole("menuitem", { name: "Fold" })).toBeVisible();
+    await userEvent.keyboard("{ArrowDown}{Enter}");
+    await expect.element(jview).toHaveAttribute("aria-expanded", "false");
+
+    // Enter opens the home; dictation, with nothing to unfold, takes no arrow to fold.
+    await userEvent.keyboard("{Enter}");
+    expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("jview"));
+    const dictation = homeItem(screen, "dictation");
+    await userEvent.keyboard("{ArrowDown}{ArrowRight}");
+    await expect.element(dictation).toHaveFocus();
+    expect(dictation.element().hasAttribute("aria-expanded")).toBe(false);
+    expect(spies.onToggleHome).toHaveBeenCalledTimes(4);
+
+    // The live home is unchanged: its arrow opens it, as before.
+    await userEvent.keyboard("{ArrowUp}{ArrowUp}{ArrowRight}");
+    expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("flow"));
+  });
+});
