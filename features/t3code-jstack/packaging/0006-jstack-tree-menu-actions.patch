+/** A row's menu item and what it runs, built beside the row, so no item runs another row's action. */
+interface RowMenuItem extends Omit<ContextMenuItem, "id" | "children"> {
+  readonly run: () => void;
+}
+
+/**
+ * Opens a row's menu at the pointer and runs the item picked. The menu reaches the desktop
+ * process as data, so each item goes by its place in the list.
+ * Every row opens its menu here, and sidebarTree.ts turns ContextMenu and Shift+F10 into this.
+ */
+const rowMenu = (items: ReadonlyArray<RowMenuItem>) => (event: MouseEvent) => {
+  event.preventDefault();
+  const api = readLocalApi();
+  if (!api) return;
+  void api.contextMenu
+    .show(
+      items.map(({ run: _run, ...item }, place) => ({ ...item, id: String(place) })),
+      { x: event.clientX, y: event.clientY },
+    )
+    .then((picked) => {
+      if (picked !== null) items[Number(picked)]?.run();
+    })
+    .catch(() => undefined);
+};
