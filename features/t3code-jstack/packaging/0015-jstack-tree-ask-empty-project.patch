 }) {
   const {
     projectScopeKey,
@@ -442,6 +448,7 @@ function useSidebarThreads(input: {
     routeRowThreadKey,
     folderGroups,
     keepEmptyFolders: keepEmpty,
+    jstackTreeOn,
   } = input;
   // Folders already separate the work, so boring mode has no Working shelf.
   const workingShelfEnabled =
@@ -529,7 +536,10 @@ function useSidebarThreads(input: {
   const projectFolders =
     folderGroups === null
       ? null
-      : groupSidebarThreadsByProject(folderGroups, activeThreads, keepEmpty).map((folder) => {
+      : (jstackTreeOn && !keepEmpty
+          ? jstackProjectFolders(folderGroups, activeThreads)
+          : groupSidebarThreadsByProject(folderGroups, activeThreads, keepEmpty)
+        ).map((folder) => {
           const collapsed = !resolveProjectExpanded(
             projectExpandedById,
             sidebarFolderExpansionKeys(folder.group),
@@ -1282,6 +1292,9 @@ export default function Sidebar({ routeReveal }: { routeReveal: SidebarRouteReve
     },
   );
 
