+  const jstackTreeEnabled = useClientSettings((settings) => settings.jstackTreeSidebarEnabled);
+  const jbusWork = useJbusWork(jstackTreeEnabled ? primaryEnvironmentId : null);
   const {
     workingShelfEnabled,
     pinnedThreads,
@@ -1332,16 +1345,15 @@ export default function Sidebar({ routeReveal }: { routeReveal: SidebarRouteReve
         : scopedProjectGroups
       : null,
     keepEmptyFolders: scopedProjectGroups.length > 0,
+    jstackTreeOn: jbusWork !== null && primaryEnvironmentId !== null,
   });
 
   // jstack fork: once jbus's snapshot loads, every project folder draws as a root row of the
   // tree: a jstack root home's project, a plain folder, or "No project".
-  const jstackTreeEnabled = useClientSettings((settings) => settings.jstackTreeSidebarEnabled);
   const jstackAttention = useClientSettings((settings) => settings.jstackTreeAttention);
   const jstackLandedCount = useClientSettings((settings) => settings.jstackTreeLandedCount);
   const jstackQuietMinutes = useClientSettings((settings) => settings.jstackTreeQuietMinutes);
   const jstackRowCap = useClientSettings((settings) => settings.jstackTreeRowCap);
-  const jbusWork = useJbusWork(jstackTreeEnabled ? primaryEnvironmentId : null);
   const jstackNowMinute = useNowMinute();
   const jstackLocalVisits = useUiStateStore((store) => store.threadLastVisitedAtById);
   const [jstackExpandedHomes, setJstackExpandedHomes] = useState<ReadonlySet<string>>(
