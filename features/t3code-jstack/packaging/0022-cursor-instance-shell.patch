diff --git a/packages/provider-cursor/src/server/instanceShell.ts b/packages/provider-cursor/src/server/instanceShell.ts
new file mode 100644
index 0000000000..1edf4d8afb
--- /dev/null
+++ b/packages/provider-cursor/src/server/instanceShell.ts
@@ -0,0 +1,44 @@
+import * as NodeAsyncHooks from "node:async_hooks";
+
+// @cursor/sdk runs in this process and has no per-agent shell option: it reads
+// `process.env.SHELL` to pick, start and give the environment of each command's shell.
+// Work run under `withInstanceShell` reads its instance's SHELL there instead, and every
+// other reader, T3's own terminals and other providers included, still reads the server's.
+const instanceShell = new NodeAsyncHooks.AsyncLocalStorage<string>();
+let installed = false;
+
+function installInstanceShell(): void {
+  if (installed) return;
+  installed = true;
+  const scoped = (key: string | symbol) => (key === "SHELL" ? instanceShell.getStore() : undefined);
+  process.env = new Proxy(process.env, {
+    get: (target, key) => scoped(key) ?? Reflect.get(target, key),
+    set: (target, key, value) => Reflect.set(target, key, value),
+    has: (target, key) => scoped(key) !== undefined || Reflect.has(target, key),
+    ownKeys: (target) => {
+      const keys = Reflect.ownKeys(target);
+      return scoped("SHELL") !== undefined && !keys.includes("SHELL") ? [...keys, "SHELL"] : keys;
+    },
+    getOwnPropertyDescriptor: (target, key) => {
+      const value = scoped(key);
+      return value === undefined
+        ? Reflect.getOwnPropertyDescriptor(target, key)
+        : { value, writable: true, enumerable: true, configurable: true };
+    },
+  });
+}
+
+/** Runs `run`, and all the async work it starts, with `process.env.SHELL` reading `shell`. */
+export function withInstanceShell<A>(shell: string | undefined, run: () => Promise<A>): Promise<A> {
+  if (shell === undefined) return run();
+  installInstanceShell();
+  return instanceShell.run(shell, run);
+}
+
+/**
+ * Runs `run` outside any instance's shell. A callback from the SDK back into T3 goes through
+ * this, so that Effect fibers it wakes, which may be anyone's, read the server's SHELL.
+ */
+export function withoutInstanceShell<A>(run: () => A): A {
+  return instanceShell.exit(run);
+}
