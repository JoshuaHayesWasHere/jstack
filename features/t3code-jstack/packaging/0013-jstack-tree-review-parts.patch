diff --git a/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx b/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx
index 49743f8716..5ce8d06ffe 100644
--- a/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx
+++ b/apps/web/src/components/sidebar/JstackTreeRows.browser.test.tsx
@@ -1366,3 +1366,48 @@ describe("JstackTreeRowView idle homes", () => {
     expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("flow"));
   });
 });
+
+// One task in each part of its pull request's review, each as jbus's row value names it.
+const REVIEW_SNAPSHOT: JbusWorkSnapshot = {
+  ...SNAPSHOT,
+  tasks: [
+    { ...crewTask("first", "root"), stage: "review" },
+    { ...crewTask("fixes", "root"), stage: "findings" },
+    { ...crewTask("again", "root"), stage: "second" },
+    { ...crewTask("green", "root"), stage: "check" },
+    { ...crewTask("onto", "root"), stage: "rebase" },
+    crewTask("tidy", "root"),
+    crewTask("fl-pump", "flow"),
+  ],
+};
+
+/** The tick a row's ticks stand at: the one drawn at full ink, every tick before it fainter. */
+const tickAt = (row: Element) => {
+  const ticks = [...row.querySelectorAll("i")];
+  const ink = ticks.map((tick) => alphaOf(getComputedStyle(tick).backgroundColor));
+  return { count: ticks.length, at: ink.indexOf(Math.max(...ink)) };
+};
+
+describe("JstackTreeRowView review parts", () => {
+  it("says which part of its review a task is in, and steps its ticks with it", async () => {
+    await using screen = await render(
+      <LiveTree snapshot={REVIEW_SNAPSHOT} spies={actions()} sent={[]} />,
+      { router: false },
+    );
+    const parts = [
+      ["tidy", "crew", 1],
+      ["first", "review 1", 2],
+      ["fixes", "fixing", 3],
+      ["again", "review 2", 4],
+      ["green", "checks", 5],
+      ["onto", "rebase", 5],
+    ] as const;
+    for (const [slug, word, step] of parts) {
+      const row = screen.getByRole("treeitem", { name: new RegExp(`^${slug} `) });
+      await expect.element(row).toBeVisible();
+      expect(shownText(row.element())).toBe(`${slug} ${word}`);
+      expect(tickAt(row.element())).toEqual({ count: 7, at: step });
+    }
+    expect(await audit()).toEqual([]);
+  });
+});
