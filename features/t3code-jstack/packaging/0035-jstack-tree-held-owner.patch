+/**
+ * What the polish home showed as `held 5m` for pull requests that waited only on their own crew to
+ * rerun a proof: a hold jbus says the crew owns, one the user owns, and one the user owns on a
+ * row that also asks a word.
+ */
+const OWNED_SINCE = "2026-10-29T11:55:00+00:00";
+const OWNED: JbusWorkSnapshot = {
+  ...ASKING,
+  tasks: [
+    {
+      ...crewTask("sb-proof", "sidebar"),
+      stage: "check",
+      held: { since: OWNED_SINCE, reason: "proved-missing", who: "crew" },
+    },
+    {
+      ...crewTask("sb-again", "sidebar"),
+      stage: "check",
+      held: { since: OWNED_SINCE, reason: "approve it again", who: "user" },
+    },
+    {
+      ...crewTask("sb-word", "sidebar"),
+      stage: "review",
+      waitsOn: "word",
+      waits: "your word",
+      held: { since: OWNED_SINCE, reason: "your word", who: "user" },
+    },
+  ],
+};
+
+describe("JstackTreeRowView held tags", () => {
+  it("says the crew owes a hold its crew owns, held of one the user owns, and asks you first", async () => {
+    await using screen = await render(<AskingTree spies={actions()} snapshot={OWNED} />, {
+      router: false,
+    });
+    const tagOf = (slug: string) => {
+      const row = screen.getByRole("button", { name: new RegExp(`^${slug} `) }).element();
+      return [...row.querySelectorAll(":scope > span:not(.sr-only)")]
+        .slice(1)
+        .map((span) => span.textContent)
+        .join(" ");
+    };
+    await expect.element(screen.getByRole("button", { name: /^sb-proof / })).toBeVisible();
+    expect(tagOf("sb-proof")).toBe("crew owes 5m");
+    expect(tagOf("sb-again")).toBe("held 5m");
+    expect(tagOf("sb-word")).toBe("asks you held 5m");
+  });
+});
+
 describe("JstackTreeRowView idle homes", () => {
