+    };
     for (const slug of one.rows) {
-      if (typeof slug === "string") bySlug.set(slug, { since, reason: text(one.reason) ?? "" });
+      if (typeof slug === "string") bySlug.set(slug, held);
     }
   }
   return { bySlug, byPull };
