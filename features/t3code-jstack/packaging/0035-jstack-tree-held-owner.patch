   it("carries who holds each row's next move, so the tree says stalled only of a crew that owes it", () => {
     const work = {
       work: [
diff --git a/apps/server/src/jstack/jbusWork.logic.ts b/apps/server/src/jstack/jbusWork.logic.ts
