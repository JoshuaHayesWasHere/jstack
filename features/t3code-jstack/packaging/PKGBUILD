# T3 Code nightly with jstack's tree sidebar: upstream's tag, plus this folder's patches.
# `jinstall --setup` prints the command that builds and installs it, which keeps makepkg's
# work out of this folder:
#   env BUILDDIR=~/.cache/t3code-jstack PKGDEST=~/.cache/t3code-jstack \
#     SRCDEST=~/.cache/t3code-jstack makepkg -si -D <this folder>
# The version is the nightly's, plus `.jstack.<series>`: the first 10 hex digits of the sha256
# of this folder's patches in name order. `jinstall --doctor` compares the app's version with
# the patches here, and jinstall's tests fail while `pkgver` names another series, so bump it
# with every change to a patch.

pkgname=t3code-jstack
_tag=v0.1.5-nightly.20261029.3877
pkgver=0.1.5_nightly.20261029.3877.jstack.05899adb5c
pkgrel=1
pkgdesc='T3 Code nightly with the jstack tree sidebar'
arch=('x86_64')
url='https://github.com/pingdotgg/t3code'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libsecret'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
# vite-plus is from the AUR (vite-plus-bin), so makepkg -s cannot install it: it must be on PATH.
# libxcrypt-compat: electron-builder's fpm, which also writes a .deb, needs libcrypt.so.1.
makedepends=('imagemagick' 'libxcrypt-compat' 'nodejs' 'patch' 'pkgconf' 'rust')
provides=("t3code-nightly=${pkgver%%.jstack*}")
conflicts=('t3code-nightly-bin' 't3code-nightly' 't3code-bin' 't3code')
options=('!debug' '!strip')

_patches=(0001-jstack-tree-sidebar.patch)
source=("t3code-${_tag#v}.tar.gz::https://github.com/pingdotgg/t3code/archive/refs/tags/${_tag}.tar.gz"
        "${_patches[@]}")
sha256sums=('SKIP'
            'SKIP')

_tree="t3code-${_tag#v}"

prepare() {
  command -v vp >/dev/null || {
    echo 'vp is not on PATH: yay -S vite-plus-bin' >&2
    return 1
  }
  cd "$srcdir/$_tree"
  local one
  for one in "${_patches[@]}"; do
    patch -p1 --forward --quiet < "$srcdir/$one"
  done
  vp i --frozen-lockfile
}

build() {
  cd "$srcdir/$_tree"
  rm -rf "$srcdir/release"
  node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64 \
    --build-version "${_tag#v}+jstack.${pkgver##*.jstack.}" --output-dir "$srcdir/release"
  local appimage=("$srcdir"/release/*.AppImage)
  chmod +x "${appimage[0]}"
  rm -rf "$srcdir/squashfs-root"
  (cd "$srcdir" && "${appimage[0]}" --appimage-extract >/dev/null)
  if [[ ! -x "$srcdir/squashfs-root/AppRun" || ! -f "$srcdir/squashfs-root/chrome-sandbox" ]]; then
    echo 'The AppImage payload is missing its launcher or Chromium sandbox.' >&2
    return 1
  fi
}

package() {
  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership "$srcdir/squashfs-root/." "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  # Run outside an AppImage, the app's updater stays off, so it never swaps back to upstream.
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/t3code-jstack" <<EOF
#!/bin/sh
export T3CODE_DISABLE_AUTO_UPDATE=1
exec /opt/$pkgname/AppRun "\$@"
EOF
  # The nightly package's names, which autostart entries and scripts already call.
  ln -s t3code-jstack "$pkgdir/usr/bin/t3code-nightly"
  ln -s t3code-jstack "$pkgdir/usr/bin/t3-code-nightly-desktop"

  # Icon lookup only sees sizes registered in hicolor's index.theme (max 512x512).
  local icon size_dir
  for icon in "$srcdir"/squashfs-root/usr/share/icons/hicolor/*/apps/t3code.png; do
    size_dir="${icon%/apps/t3code.png}"
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${size_dir##*/}/apps/$pkgname.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/t3code.desktop" <<EOF
[Desktop Entry]
Name=T3 Code (jstack)
Comment=T3 Code nightly with the jstack tree sidebar
Exec=t3code-jstack %U
TryExec=t3code-jstack
Terminal=false
Type=Application
Icon=$pkgname
StartupWMClass=t3code
Categories=Development;
MimeType=x-scheme-handler/t3code;
EOF

  install -Dm644 "$srcdir/$_tree/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
