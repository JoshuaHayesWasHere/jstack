+
+/** What jstack's home shares in `home/<repo>/`, which no scope can be named. */
+const SHARED_DIRECTORIES = new Set(["tasks", "scouts", "reports", "log"]);
+const SHARED_FILES = new Set(["off", "merge.log"]);
+
+/**
+ * Why a scope cannot have this name, by the rules the root home's "Making a scope" checks, or
+ * null. A hint before the send: the root home checks again against what is on disk.
+ */
+export function scopeNameProblem(name: string, taken: ReadonlyArray<string>): string | null {
+  const scope = name.trim();
+  if (scope === "") return "Name the scope.";
+  if (!/^[A-Za-z0-9_-][A-Za-z0-9._-]*$/.test(scope)) {
+    return "A scope's name is letters, digits, dots and dashes, and no dot first.";
+  }
+  if (SHARED_DIRECTORIES.has(scope))
+    return `${scope} is a directory every home of the repo shares.`;
+  if (SHARED_FILES.has(scope)) return `${scope} is a file of the repo's home.`;
+  if (taken.includes(scope)) return `${scope} is already a scope of this repo.`;
+  return null;
+}
