+  // Every directory whose entries a refresh reads, so a write in any of them refreshes: the
+  // roots, each candidate repo's two directories, and every directory of a tracked repo's home,
+  // a scope made after the server started included. Each refresh re-derives the set first.
+  const touched = yield* Queue.sliding<void>(1);
+  const watchers = new Map<string, NodeFS.FSWatcher>();
+  yield* Effect.addFinalizer(() =>
+    Effect.sync(() => {
+      for (const watcher of watchers.values()) watcher.close();
+      watchers.clear();
+    }),
+  );
+  const isDirectory = (entry: string) =>
+    fs.stat(entry).pipe(
+      Effect.map((info) => info.type === "Directory"),
+      Effect.orElseSucceed(() => false),
+    );
+  const directoriesIn = Effect.fnUntraced(function* (directory: string) {
+    const found: Array<string> = [];
+    for (const name of yield* listDirectory(directory)) {
+      const entry = path.join(directory, name);
+      if (yield* isDirectory(entry)) found.push(entry);
+    }
+    return found;
+  });
+  const watchedDirectories = Effect.gen(function* () {
+    const wanted = new Set([roots.jbus, roots.home]);
+    for (const entry of yield* directoriesIn(roots.jbus)) wanted.add(entry);
+    for (const entry of yield* directoriesIn(roots.home)) wanted.add(entry);
+    for (const repo of yield* repos) {
+      for (const entry of yield* directoriesIn(path.join(roots.home, repo))) wanted.add(entry);
+    }
+    return wanted;
+  });
+  // node's watch registers synchronously, so a write after this and before the read is not lost;
+  // FileSystem.watch registers only once its stream is first pulled.
+  const syncWatchers = Effect.fnUntraced(function* () {
+    const wanted = yield* watchedDirectories;
+    for (const [directory, watcher] of watchers) {
+      if (wanted.has(directory)) continue;
+      watcher.close();
+      watchers.delete(directory);
+    }
+    for (const directory of wanted) {
+      if (watchers.has(directory)) continue;
+      const watcher = openWatcher(directory, () => Queue.offerUnsafe(touched, undefined));
+      if (watcher === null) continue;
+      watcher.on("error", () => {
+        watcher.close();
+        if (watchers.get(directory) === watcher) watchers.delete(directory);
+      });
+      watchers.set(directory, watcher);
+    }
+  });
+
   // Refreshes run on every debounced file event; tracing each would flood spans.
   const refresh = Effect.fnUntraced(function* () {
+    yield* syncWatchers();
     const nowMs = yield* Clock.currentTimeMillis;
     const snapshots: Array<JbusWorkSnapshot> = [];
     for (const repo of yield* repos) snapshots.push(yield* readRepo(repo, nowMs));
