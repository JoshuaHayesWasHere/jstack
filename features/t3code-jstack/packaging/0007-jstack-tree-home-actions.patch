+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import {
+  DEFAULT_PROVIDER_INTERACTION_MODE,
+  DEFAULT_RUNTIME_MODE,
+  DEFAULT_SERVER_SETTINGS,
+  type EnvironmentId,
+  type ScopedThreadRef,
+  type ThreadId,
+} from "@t3tools/contracts";
+import { resolveProjectSettings } from "@t3tools/shared/projectSettings";
+
+import { useComposerDraftStore } from "~/composerDraftStore";
+import { newMessageId, newThreadId } from "~/lib/utils";
+import { dispatchSnapShotComposerFocus } from "../../lib/desktopSnapShot";
+import { resolveProjectDefaultProviderModelSelection } from "../../providerInstances";
+import { appAtomRegistry } from "../../rpc/atomRegistry";
+import { environmentServerConfigsAtom } from "../../state/server";
+import { threadEnvironment } from "../../state/threads";
+import { useOrchestrationCommand } from "../../state/use-orchestration-command";
+import type { SidebarProjectSnapshot } from "../../sidebarProjectGrouping";
+
+// jstack fork: what the tree's home actions do. Every write goes through a home as a real user
+// message, which the home then acts on as the user's word; the T3 server runs no jbus write.
+
+/**
+ * Puts New crew task or New scout text in a home's composer, after any draft it already has, so
+ * nothing the user typed is lost. A mounted composer takes it from the store as it is.
+ */
+export function placeHomeWork(target: ScopedThreadRef, text: string): void {
+  const store = useComposerDraftStore.getState();
+  const existing = store.getComposerDraft(target)?.prompt ?? "";
+  const next =
+    existing.trim() === ""
+      ? text
+      : existing.endsWith(text)
+        ? existing
+        : `${existing.trimEnd()}\n\n${text}`;
+  store.setPrompt(target, next);
+}
+
+/** Focuses the open thread's composer at its end, once the thread the route names has drawn. */
+export function focusComposerSoon(): void {
+  window.requestAnimationFrame(() => dispatchSnapShotComposerFocus());
+}
+
+export interface JstackHomeSends {
+  /** Sends a home a user message, after its running turn if it has one. */
+  readonly sendToHome: (
+    environmentId: EnvironmentId,
+    threadId: ThreadId,
+    thread: EnvironmentThreadShell | null,
+    text: string,
+  ) => Promise<boolean>;
+  /**
+   * Starts a project's root home: a new thread in its main checkout that runs `/home`. Its
+   * thread, else `no-model` when no provider can run it, else null when the send failed.
+   */
+  readonly startHome: (group: SidebarProjectSnapshot) => Promise<ThreadId | "no-model" | null>;
+}
+
+export function useJstackHomeSends(): JstackHomeSends {
+  const startTurn = useOrchestrationCommand(threadEnvironment.startTurn);
+  return {
+    sendToHome: async (environmentId, threadId, thread, text) => {
+      const result = await startTurn({
+        environmentId,
+        input: {
+          threadId,
+          message: { messageId: newMessageId(), role: "user", text, attachments: [] },
+          runtimeMode: thread?.runtimeMode ?? DEFAULT_RUNTIME_MODE,
+          interactionMode: thread?.interactionMode ?? DEFAULT_PROVIDER_INTERACTION_MODE,
+          dispatchMode: "queue",
+        },
+      });
+      return result._tag === "Success";
+    },
+    startHome: async (group) => {
+      const config = appAtomRegistry.get(environmentServerConfigsAtom).get(group.environmentId);
+      const settings = config?.settings ?? DEFAULT_SERVER_SETTINGS;
+      const defaults = resolveProjectSettings(settings, group.id, group).settings;
+      const modelSelection =
+        defaults.defaultModelSelection ??
+        resolveProjectDefaultProviderModelSelection(config?.providers ?? [], settings, group.id);
+      if (modelSelection === null) return "no-model";
+      const runtimeMode = defaults.defaultRuntimeMode ?? DEFAULT_RUNTIME_MODE;
+      const threadId = newThreadId();
+      const createdAt = new Date().toISOString();
+      const repo = group.workspaceRoot.split("/").filter(Boolean).at(-1) ?? group.displayName;
+      const result = await startTurn({
+        environmentId: group.environmentId,
+        input: {
+          threadId,
+          message: { messageId: newMessageId(), role: "user", text: "/home", attachments: [] },
+          modelSelection,
+          runtimeMode,
+          interactionMode: DEFAULT_PROVIDER_INTERACTION_MODE,
+          bootstrap: {
+            createThread: {
+              projectId: group.id,
+              title: `home: ${repo}`,
+              modelSelection,
+              runtimeMode,
+              interactionMode: DEFAULT_PROVIDER_INTERACTION_MODE,
+              // A home runs in the main checkout, never a worktree of its own.
+              branch: null,
+              worktreePath: null,
+              createdAt,
+            },
+          },
+          createdAt,
+        },
+      });
+      return result._tag === "Success" ? threadId : null;
+    },
+  };
+}
