+/** The next snapshot the test is waiting for, read off the stream of changes. */
+const nextWhere = <A>(
+  changes: Stream.Stream<A>,
+  test: (snapshot: A) => boolean,
+): Effect.Effect<Option.Option<A>> =>
+  changes.pipe(Stream.filter(test), Stream.runHead, Effect.timeout("5 seconds"), Effect.orDie);
+
+it.live(
+  "shows a scope its root home makes as starting, until the scope's home writes home-id",
+  () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const { roots } = yield* seed;
+      const service = yield* JbusWork.make(roots);
+      const { latest, changes } = yield* service.subscribe;
+      assert.deepEqual(latest.startingScopes, []);
+
+      // What the root home's "Making a scope" writes, in its order.
+      const scope = path.join(roots.home, "jstack", "ops");
+      yield* fs.makeDirectory(scope);
+      yield* fs.writeFileString(path.join(scope, "plan.md"), "# jstack, ops: plan\n");
+      yield* fs.writeFileString(path.join(scope, "prefix"), "ops-\n");
+      const starting = yield* nextWhere(changes, (next) => next.startingScopes.length > 0);
+      assert.deepEqual(
+        Option.map(starting, (next) => [next.startingScopes, next.homes.map((home) => home.scope)]),
+        Option.some([[{ repo: "jstack", scope: "ops" }], [null]]),
+      );
+
+      // `/home ops` writes the scope's home-id, inside the new scope's own directory.
+      yield* fs.writeFileString(path.join(scope, "home-id"), "mcp:ops-home\n");
+      const started = yield* nextWhere(changes, (next) => next.startingScopes.length === 0);
+      assert.deepEqual(
+        Option.map(started, (next) =>
+          next.homes.map((home) => [home.scope, home.threadId, home.prefix]),
+        ),
+        Option.some([
+          [null, "mcp:root", null],
+          ["ops", "mcp:ops-home", "ops-"],
+        ]),
+      );
+    }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
+
+it.live("finds a repo whose root home starts after the server does", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const { roots } = yield* seed;
+    const service = yield* JbusWork.make(roots);
+    const { latest, changes } = yield* service.subscribe;
+    assert.deepEqual(
+      latest.homes.map((home) => home.repo),
+      ["jstack"],
+    );
+
+    // "Start a home" in a project jbus already tracks: `/home` writes home/<repo>/home-id.
+    yield* fs.makeDirectory(path.join(roots.jbus, "winnifred"));
+    yield* fs.writeFileString(path.join(roots.jbus, "winnifred", "work.json"), '{"work": []}');
+    yield* fs.makeDirectory(path.join(roots.home, "winnifred"));
+    yield* fs.writeFileString(path.join(roots.home, "winnifred", "home-id"), "mcp:winnifred\n");
+    const found = yield* nextWhere(changes, (next) => next.homes.length === 2);
+    assert.deepEqual(
+      Option.map(found, (next) => next.homes.map((home) => [home.repo, home.threadId])),
+      Option.some([
+        ["jstack", "mcp:root"],
+        ["winnifred", "mcp:winnifred"],
+      ]),
+    );
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
+
+it.live("never shows a scope whose home handed off as starting", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const { roots } = yield* seed;
+    // What /handoff leaves of a scoped home: its plan and its note, and no home-id.
+    const scope = path.join(roots.home, "jstack", "ops");
+    yield* fs.makeDirectory(scope);
+    yield* fs.writeFileString(path.join(scope, "plan.md"), "# jstack, ops: plan\n");
+    yield* fs.writeFileString(path.join(scope, "handoff.md"), "Was home: mcp:ops-home\n");
+    const service = yield* JbusWork.make(roots);
+    const { latest } = yield* service.subscribe;
+    assert.deepEqual(latest.startingScopes, []);
+    assert.deepEqual(
+      latest.homes.map((home) => home.scope),
+      [null],
+    );
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
