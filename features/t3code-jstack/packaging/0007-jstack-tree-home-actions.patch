+export function scopeNameProblem(name: string, taken: ReadonlyArray<string>): string | null {
+  const scope = name.trim();
+  if (scope === "") return "Name the scope.";
+  if (!/^[A-Za-z0-9_-][A-Za-z0-9._-]*$/.test(scope)) {
+    return "A scope's name is letters, digits, dots and dashes, and no dot first.";
+  }
+  if (SHARED_DIRECTORIES.has(scope))
+    return `${scope} is a directory every home of the repo shares.`;
+  if (SHARED_FILES.has(scope)) return `${scope} is a file of the repo's home.`;
