+// Every command the sends run goes through here, so the test reads what reaches the server.
+const commands = vi.hoisted(() => ({
+  startTurn: vi.fn(async (_value: unknown) => ({ _tag: "Success" as const, value: undefined })),
+}));
+vi.mock("../../state/use-orchestration-command", () => ({
