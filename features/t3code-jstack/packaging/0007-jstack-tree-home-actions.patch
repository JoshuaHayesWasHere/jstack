+
+it("starts a home as a new thread in the project's main checkout whose first message is /home", async () => {
+  commands.startTurn.mockClear();
+  let started: Awaited<ReturnType<JstackHomeSends["startHome"]>> = null;
+  await withSends(async (sends) => {
+    started = await sends.startHome(winnifred);
