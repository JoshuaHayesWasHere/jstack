+import { scopeThreadRef } from "@t3tools/client-runtime/environment";
+import { EnvironmentId, ThreadId, type ScopedThreadRef } from "@t3tools/contracts";
+import { createRef, type RefObject, useEffect } from "react";
+import { expect, it } from "vite-plus/test";
+import { userEvent } from "vite-plus/test/browser";
+
+import "~/index.css";
+import { useComposerDraftStore } from "~/composerDraftStore";
+import { act, render } from "../../../test/render";
+import { subscribeSnapShotComposerFocus } from "../../lib/desktopSnapShot";
+import {
+  ComposerPromptEditorTiptap as ComposerPromptEditor,
+  type ComposerPromptEditorHandle,
+} from "../ComposerPromptEditorTiptap";
+import { focusComposerSoon, placeHomeWork } from "./jstackHomeActions";
+import { HOME_WORK_PROMPT } from "./jstackTree.logic";
+
+const environmentId = EnvironmentId.make("environment-local");
+
+/** A home's composer as ChatView mounts it: its draft from the store, focused on the event. */
+function HomeComposer(props: {
+  target: ScopedThreadRef;
+  editorRef: RefObject<ComposerPromptEditorHandle | null>;
+}) {
+  const prompt = useComposerDraftStore(
+    (store) => store.getComposerDraft(props.target)?.prompt ?? "",
+  );
+  // ChatView's own subscription to the window event that focuses its composer.
+  useEffect(
+    () => subscribeSnapShotComposerFocus(() => props.editorRef.current?.focusAtEnd()),
+    [props.editorRef],
+  );
+  return (
+    <>
+      <button type="button">elsewhere</button>
+      <ComposerPromptEditor
+        editorRef={props.editorRef}
+        value={prompt}
+        cursor={prompt.length}
+        contextRecords={new Map()}
+        skills={[]}
+        disabled={false}
+        placeholder=""
+        onChange={(next) => useComposerDraftStore.getState().setPrompt(props.target, next)}
+        onPaste={() => {}}
+      />
+    </>
+  );
+}
+
+const promptOf = (target: ScopedThreadRef) =>
+  useComposerDraftStore.getState().getComposerDraft(target)?.prompt ?? "";
+
+it("puts New crew task in a home's composer that is already mounted, focused at its end", async () => {
+  const target = scopeThreadRef(environmentId, ThreadId.make("home-mounted"));
+  const editorRef = createRef<ComposerPromptEditorHandle>();
+  await using screen = await render(<HomeComposer target={target} editorRef={editorRef} />, {
+    router: false,
+  });
+  const editor = screen.container.querySelector<HTMLElement>('[contenteditable="true"]')!;
+  await userEvent.click(screen.getByRole("button", { name: "elsewhere" }));
+
+  await act(() => {
+    placeHomeWork(target, HOME_WORK_PROMPT.crew);
+    focusComposerSoon();
+  });
+  await expect.poll(() => editor.textContent).toBe("New crew task: ");
+  await expect.poll(() => document.activeElement === editor).toBe(true);
+
+  await userEvent.keyboard("tidy the sidebar");
+  expect(promptOf(target)).toBe("New crew task: tidy the sidebar");
+});
+
+it("keeps a draft the home's composer already has, and puts New scout after it", async () => {
+  const target = scopeThreadRef(environmentId, ThreadId.make("home-drafted"));
+  useComposerDraftStore.getState().setPrompt(target, "half a thought");
+  const editorRef = createRef<ComposerPromptEditorHandle>();
+  await using screen = await render(<HomeComposer target={target} editorRef={editorRef} />, {
+    router: false,
+  });
+  const editor = screen.container.querySelector<HTMLElement>('[contenteditable="true"]')!;
+  await expect.poll(() => editor.textContent).toBe("half a thought");
+
+  await act(() => placeHomeWork(target, HOME_WORK_PROMPT.scout));
+  expect(promptOf(target)).toBe("half a thought\n\nNew scout: ");
+  await expect.poll(() => editor.innerText.replace(/\n+/g, "|")).toBe("half a thought|New scout: ");
+
+  // A second pick adds nothing more.
+  await act(() => placeHomeWork(target, HOME_WORK_PROMPT.scout));
+  expect(promptOf(target)).toBe("half a thought\n\nNew scout: ");
+});
