+const fallback = vi.hoisted(() => ({ model: { instanceId: "claude", model: "opus" } }));
+vi.mock("../../providerInstances", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../providerInstances")>()),
+  resolveProjectDefaultProviderModelSelection: () => fallback.model,
+}));
+
+const environmentId = EnvironmentId.make("environment-local");
+const projectId = ProjectId.make("project-winnifred");
+const model: ModelSelection = { instanceId: ProviderInstanceId.make("claude"), model: "opus" };
