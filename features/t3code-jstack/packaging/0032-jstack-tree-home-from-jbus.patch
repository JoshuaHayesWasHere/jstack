 4 files changed, 25 insertions(+), 45 deletions(-)

diff --git a/apps/server/src/jstack/JbusWork.test.ts b/apps/server/src/jstack/JbusWork.test.ts
index b96bb4f3..eccd8763 100644
--- a/apps/server/src/jstack/JbusWork.test.ts
+++ b/apps/server/src/jstack/JbusWork.test.ts
@@ -12,7 +12,15 @@ import * as JbusWork from "./JbusWork.ts";
 const workFile = (value: string) =>
   JSON.stringify({
     work: [
-      { kind: "row", slug: "fix-it", value, lane: "running", thread: "mcp:crew", who: "crew" },
+      {
+        kind: "row",
+        slug: "fix-it",
+        value,
+        lane: "running",
+        thread: "mcp:crew",
+        who: "crew",
+        home: "uncategorized",
+      },
     ],
   });
 
@@ -79,6 +87,10 @@ it.live("shows a work.json write while jbus writes its outbox.lock beside it wit
     const fs = yield* FileSystem.FileSystem;
     const path = yield* Path.Path;
     const { roots, workPath } = yield* seed;
+    // jbus homes the row under `uncategorized`, so the tree draws it once that home has started.
+    const uncategorized = path.join(roots.home, "jstack", "uncategorized");
+    yield* fs.makeDirectory(uncategorized);
+    yield* fs.writeFileString(path.join(uncategorized, "home-id"), "mcp:uncategorized-home\n");
     const service = yield* JbusWork.make(roots);
     const { latest, changes } = yield* service.subscribe;
     assert.deepEqual(
