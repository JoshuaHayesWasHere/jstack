     }
     return buildRepoWork(
       {
@@ -130,6 +135,7 @@ export const make = Effect.fn("JbusWork.make")(function* (roots: JbusWorkRoots)
         scopes: scopes.toSorted((a, b) => a.scope.localeCompare(b.scope)),
