+      }),
+      NOW,
+    );
+    expect(result.tasks.map((task) => task.brief)).toEqual([
+      "each menu item carries its own action",
+    ]);
+    expect(result.gates.map((gate) => gate.default)).toEqual(["it waits"]);
+  });
+
+  it("reads a brief's title from its heading, after the slug", () => {
+    expect(readBriefTitle("# sb-one: each menu item carries its own action\nTask: x")).toBe(
+      "each menu item carries its own action",
+    );
+    expect(readBriefTitle("Task: x")).toBeNull();
+  });
+
   it("nests each task under the home its brief names", () => {
