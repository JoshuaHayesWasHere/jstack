 });
+
+const sidebarHome = ThreadId.make("sidebar");
+
+/** What jbus said at the user's click: a queued task waits on an approval, a gate asks. */
+const ASKING: JbusWorkSnapshot = {
+  ...EMPTY_JBUS_WORK_SNAPSHOT,
+  homes: [
+    { repo: "jstack", scope: null, threadId: ThreadId.make("root"), prefix: null },
+    { repo: "jstack", scope: "flow", threadId: ThreadId.make("flow"), prefix: "fl-" },
+    { repo: "jstack", scope: "sidebar", threadId: sidebarHome, prefix: "sb-" },
+  ],
+  tasks: [
+    {
+      ...crewTask("sb-menus-own-actions", "sidebar"),
+      stage: "ready",
+      threadId: null,
+      waitsOnUser: true,
+      waits: "your approval",
+      brief: "each tree menu item carries its own action",
+    },
+    { ...crewTask("sb-valve", "sidebar"), stage: "ready", threadId: null },
+    crewTask("sb-gated", "sidebar"),
+    // Launched: jbus has its thread, which the client has not loaded yet.
+    { ...crewTask("sb-launched", "sidebar"), stage: "ready" },
+  ],
+  gates: [
+    {
+      repo: "jstack",
+      number: 7,
+      threadId: sidebarHome,
+      slug: "sb-valve",
+      question: "Which valve size?",
+      default: "the small valve",
+      askedAt: "2026-10-29T11:00:00.000Z",
+    },
+    {
+      repo: "jstack",
+      number: 8,
+      threadId: ThreadId.make("crew-sb-gated"),
+      slug: "sb-gated",
+      question: "Keep the old menu?",
+      default: "keep it",
+      askedAt: "2026-10-29T11:00:00.000Z",
+    },
+  ],
+};
+
+/** The tree with the sidebar home open, as the user had it, and a flow home that asks. */
+function AskingTree(props: { spies: JstackTreeRowActions }) {
+  const threads = [
+    rootThread,
+    { ...flowThread, hasPendingUserInput: true },
+    makeThreadFixture({ environmentId, projectId, id: sidebarHome }),
+    makeThreadFixture({ environmentId, projectId, id: ThreadId.make("crew-sb-gated") }),
+  ];
+  const tree = buildJstackTree({
+    environmentId,
+    folderRowId: "folder:jstack",
+    noProject: false,
+    memberProjectRefs: [{ environmentId, projectId }],
+    snapshot: ASKING,
+    threadsById: new Map(threads.map((thread) => [thread.id, thread] as const)),
+    folderThreads: [],
+    hiddenThreads: [],
+    collapsed: false,
+    routeThreadId: sidebarHome,
+    expandedHomes: new Set(),
+    frozenOrder: null,
+    lastVisitedAt: () => null,
+    childHomeEditor: false,
+    requestedScopes: [],
+    nowMs: Date.parse("2026-10-29T12:00:00.000Z"),
+    options: { attention: "gates", landedCount: false, quietMinutes: 20, rowCap: 8 },
+  });
+  return (
+    <ul
+      {...SIDEBAR_TREE_PROPS}
+      ref={attachSidebarTree}
+      className="flex w-[300px] flex-col gap-px bg-sidebar"
+    >
+      {tree.rows.map((row) =>
+        row.kind === "loose" ? null : (
+          <JstackTreeRowView
+            key={row.key}
+            row={row}
+            group={group("jstack")}
+            actions={props.spies}
+          />
+        ),
+      )}
+    </ul>
+  );
+}
+
+describe("JstackTreeRowView asks you", () => {
+  const press = async (row: { element: () => Element }, key: string) => {
+    (row.element() as HTMLElement).focus();
+    await userEvent.keyboard(key);
+  };
+
+  it("unfolds what a task with no thread asks, its default and its brief, by click and by Enter, while its home is open", async () => {
+    for (const how of ["click", "Enter"] as const) {
+      const spies = actions();
+      await using screen = await render(<AskingTree spies={spies} />, { router: false });
+      const approval = screen.getByRole("treeitem", { name: /^sb-menus-own-actions asks you/ });
+      const gated = screen.getByRole("treeitem", { name: /^sb-valve asks you/ });
+      for (const row of [approval, gated]) {
+        if (how === "click") await userEvent.click(row);
+        else await press(row, "{Enter}");
+        await expect.element(row).toHaveAttribute("aria-expanded", "true");
+      }
+      await expect.element(screen.getByText("waits on your approval")).toBeVisible();
+      await expect
+        .element(screen.getByText("Brief: each tree menu item carries its own action"))
+        .toBeVisible();
+      await expect.element(screen.getByText("Which valve size?")).toBeVisible();
+      await expect.element(screen.getByText("Default: the small valve")).toBeVisible();
+      // Its home is the thread already open, so opening it would do nothing.
+      expect(spies.onOpenThread).not.toHaveBeenCalled();
+    }
+  });
+
+  it("opens the thread that asks, a task's own or a home's, by click and by Enter", async () => {
+    for (const how of ["click", "Enter"] as const) {
+      const spies = actions();
+      await using screen = await render(<AskingTree spies={spies} />, { router: false });
+      const cases = [
+        [screen.getByRole("treeitem", { name: /^sb-gated asks you/ }), "crew-sb-gated"],
+        [screen.getByRole("treeitem", { name: /^flow asks you/ }), "flow"],
+      ] as const;
+      for (const [row, opens] of cases) {
+        if (how === "click") await userEvent.click(row);
+        else await press(row, "{Enter}");
+        expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make(opens));
+      }
+    }
+  });
+
+  it("does not say a launched task asks you while its thread is not live, and opens its thread by click and by Enter", async () => {
+    for (const how of ["click", "Enter"] as const) {
+      const spies = actions();
+      await using screen = await render(<AskingTree spies={spies} />, { router: false });
+      const launched = screen.getByRole("treeitem", { name: /^sb-launched / });
+      expect(launched.element().textContent).not.toContain("asks you");
+      if (how === "click") await userEvent.click(launched);
+      else await press(launched, "{Enter}");
+      expect(spies.onOpenThread).toHaveBeenLastCalledWith(ThreadId.make("crew-sb-launched"));
+    }
+  });
+});
