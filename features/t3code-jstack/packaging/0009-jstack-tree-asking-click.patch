+    const work = {
+      work: [
+        row("asking", "asking", "gate", { who: "user", waits: "your answer" }),
+        row("unapproved", "unapproved", "queued", { thread: "", who: "user" }),
+        row("held", "hold", "hold", { who: "user", waits: "your word" }),
+        // jbus reads a launched thread T3 does not list yet as starting, held by the crew.
+        row("launching", "launching", "running", { facts: { thread: "starting" } }),
+        // Gone with nothing written: jbus holds these for the user.
+        lost("gone", "none"),
+        lost("unknown", "missing"),
+        lost("ended", "completed"),
+      ],
+    };
+    const result = buildRepoWork(files({ work }), NOW);
+    expect(result.tasks.map((task) => [task.slug, task.waitsOnUser])).toEqual([
