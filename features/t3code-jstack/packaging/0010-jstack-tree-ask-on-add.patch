+import { EnvironmentId, ProjectId } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import type { SidebarProjectSnapshot } from "../../sidebarProjectGrouping";
+import { projectsToAsk, type JstackAskCandidate } from "./jstackAskOnAdd";
+
+const environmentId = EnvironmentId.make("environment-local");
+
+function project(name: string): SidebarProjectSnapshot {
+  const projectId = ProjectId.make(`project-${name}`);
+  return {
+    id: projectId,
+    environmentId,
+    title: name,
+    workspaceRoot: `/repos/${name}`,
+    defaultModelSelection: null,
+    scripts: [],
+    projectIcon: { kind: "monogram", text: name[0]!, color: "pink" },
+    createdAt: "2026-10-29T00:00:00.000Z",
+    updatedAt: "2026-10-29T00:00:00.000Z",
+    projectKey: name,
+    displayName: name,
+    memberProjects: [],
+    memberProjectRefs: [{ environmentId, projectId }],
+    groupedProjectCount: 1,
+    environmentPresence: "local-only",
+    allRemoteMembersAreDesktopLocal: false,
+    allRemoteMembersAreWsl: false,
+    remoteEnvironmentLabels: [],
+  };
+}
+
+const homeless = (name: string): JstackAskCandidate => ({ group: project(name), askable: true });
+const homed = (name: string): JstackAskCandidate => ({ group: project(name), askable: false });
+const names = (asked: ReadonlyArray<SidebarProjectSnapshot>) => asked.map((each) => each.title);
+
+describe("projectsToAsk", () => {
+  it("asks about none of the projects there when the tree first loads, and counts them all as seen", () => {
+    const first = projectsToAsk(null, [homeless("winnifred"), homed("jstack")]);
+    expect(first.ask).toEqual([]);
+    expect(projectsToAsk(first.seen, [homeless("winnifred"), homed("jstack")]).ask).toEqual([]);
+  });
+
+  it("asks about a project added with no home once, and never again", () => {
+    const first = projectsToAsk(null, [homed("jstack")]);
+    const added = projectsToAsk(first.seen, [homed("jstack"), homeless("winnifred")]);
+    expect(names(added.ask)).toEqual(["winnifred"]);
+    // Every later pass, whether the user said Yes, Not now or nothing, asks nothing more.
+    const later = projectsToAsk(added.seen, [homed("jstack"), homeless("winnifred")]);
+    expect(later.ask).toEqual([]);
+    expect(projectsToAsk(later.seen, [homeless("winnifred")]).ask).toEqual([]);
+  });
+
+  it("never asks about a project added with a home, nor once its home has gone", () => {
+    const first = projectsToAsk(null, []);
+    const added = projectsToAsk(first.seen, [homed("winnifred")]);
+    expect(added.ask).toEqual([]);
+    expect(projectsToAsk(added.seen, [homeless("winnifred")]).ask).toEqual([]);
+  });
+
+  it("asks nothing for a root with no member projects, such as No project", () => {
+    const noProject = { group: { ...project("none"), memberProjectRefs: [] }, askable: true };
+    const first = projectsToAsk(null, []);
+    expect(projectsToAsk(first.seen, [noProject]).ask).toEqual([]);
+  });
+});
diff --git a/apps/web/src/components/sidebar/jstackAskOnAdd.ts b/apps/web/src/components/sidebar/jstackAskOnAdd.ts
new file mode 100644
index 0000000000..6fa083c76e
--- /dev/null
+++ b/apps/web/src/components/sidebar/jstackAskOnAdd.ts
@@ -0,0 +1,117 @@
+import type { ScopedProjectRef } from "@t3tools/contracts";
+import { useEffect, useRef } from "react";
+
+import type { SidebarProjectSnapshot } from "../../sidebarProjectGrouping";
+import { toastManager } from "../ui/toast";
+
+// jstack fork: a project added to T3 asks once whether to start a jstack home for it. The
+// projects this client has seen are kept, so a project is asked about at most once, ever.
+
+export const JSTACK_SEEN_PROJECTS_KEY = "t3code:jstack-seen-projects:v1";
+
+/** A root row of the tree, as the ask reads it. */
+export interface JstackAskCandidate {
+  readonly group: SidebarProjectSnapshot;
+  /** A project with no jbus home that is not "No project": the one kind that is asked. */
+  readonly askable: boolean;
+}
+
+function projectKey(ref: ScopedProjectRef): string {
+  return `${ref.environmentId}:${ref.projectId}`;
+}
+
+/**
+ * The projects to ask about and the seen set that follows. With no seen set yet, every project
+ * there is counts as seen and none is asked: only a project added after that is new. A project
+ * is seen once any of its members is, and every member of a root counts as seen from then on,
+ * whether it was asked about or already had a home.
+ */
+export function projectsToAsk(
+  seen: ReadonlySet<string> | null,
+  candidates: ReadonlyArray<JstackAskCandidate>,
+): { readonly seen: ReadonlySet<string>; readonly ask: ReadonlyArray<SidebarProjectSnapshot> } {
+  const next = new Set(seen ?? []);
+  const ask: Array<SidebarProjectSnapshot> = [];
+  for (const { group, askable } of candidates) {
+    const keys = group.memberProjectRefs.map(projectKey);
+    if (keys.length === 0) continue;
+    if (seen !== null && askable && !keys.some((key) => seen.has(key))) ask.push(group);
+    for (const key of keys) next.add(key);
+  }
+  return { seen: next, ask };
+}
+
+function readSeenProjects(): ReadonlySet<string> | null {
+  try {
+    const raw = window.localStorage.getItem(JSTACK_SEEN_PROJECTS_KEY);
+    if (raw === null) return null;
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) return null;
+    return new Set(parsed.filter((each): each is string => typeof each === "string"));
+  } catch {
+    return null;
+  }
+}
+
+function writeSeenProjects(seen: ReadonlySet<string>): void {
+  try {
+    window.localStorage.setItem(JSTACK_SEEN_PROJECTS_KEY, JSON.stringify([...seen]));
+  } catch {}
+}
+
+/**
+ * Asks "Start a jstack home for <project>?" once for each project added after the first load.
+ * Yes starts a home as the row's "Start a home" does; Not now leaves that action on the row.
+ * An ask still open when its project gets a home closes, so its Yes never starts a second.
+ * `candidates` is null until every project and thread has loaded.
+ */
+export function useJstackAskOnAdd(
+  candidates: ReadonlyArray<JstackAskCandidate> | null,
+  startHome: (group: SidebarProjectSnapshot) => void,
+): void {
+  // Read from localStorage once, then kept here: the sidebar renders often.
+  const seenRef = useRef<ReadonlySet<string> | null | undefined>(undefined);
+  // The asks still open, by the root's project key.
+  const openRef = useRef(new Map<string, ReturnType<typeof toastManager.add>>());
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- keeps the seen projects in localStorage and opens imperative toastManager toasts for new ones
+  useEffect(() => {
+    if (candidates === null) return;
+    const open = openRef.current;
+    const close = (key: string) => {
+      const toastId = open.get(key);
+      if (toastId === undefined) return;
+      open.delete(key);
+      toastManager.close(toastId);
+    };
+    for (const { group, askable } of candidates) if (!askable) close(group.projectKey);
+    if (seenRef.current === undefined) seenRef.current = readSeenProjects();
+    const before = seenRef.current;
+    const { seen, ask } = projectsToAsk(before, candidates);
+    seenRef.current = seen;
+    if (before === null || seen.size !== before.size) writeSeenProjects(seen);
+    for (const group of ask) {
+      const key = group.projectKey;
+      const toastId = toastManager.add({
+        type: "info",
+        title: `Start a jstack home for ${group.displayName}?`,
+        description: "A home plans and runs its work. Not now leaves Start a home on its row.",
+        timeout: 0,
+        actionProps: {
+          children: "Yes",
+          onClick: () => {
+            close(key);
+            startHome(group);
+          },
+        },
+        data: {
+          hideCopyButton: true,
+          secondaryActionProps: {
+            children: "Not now",
+            onClick: () => close(key),
+          },
+        },
+      });
+      open.set(key, toastId);
+    }
+  }, [candidates, startHome]);
+}
