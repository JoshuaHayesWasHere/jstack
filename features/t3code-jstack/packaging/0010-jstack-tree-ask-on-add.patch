@@ -0,0 +1,141 @@
+import { EnvironmentId, ProjectId } from "@t3tools/contracts";
+import { expect, it, vi } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+import { render } from "../../../test/render";
+import type { SidebarProjectSnapshot } from "../../sidebarProjectGrouping";
+import { ToastProvider } from "../ui/toast";
+import {
+  JSTACK_SEEN_PROJECTS_KEY,
+  useJstackAskOnAdd,
+  type JstackAskCandidate,
+} from "./jstackAskOnAdd";
+
+const environmentId = EnvironmentId.make("environment-local");
+
+function project(name: string): SidebarProjectSnapshot {
+  const projectId = ProjectId.make(`project-${name}`);
+  return {
+    id: projectId,
+    environmentId,
+    title: name,
+    workspaceRoot: `/repos/${name}`,
+    defaultModelSelection: null,
+    scripts: [],
+    projectIcon: { kind: "monogram", text: name[0]!, color: "pink" },
+    createdAt: "2026-10-29T00:00:00.000Z",
+    updatedAt: "2026-10-29T00:00:00.000Z",
+    projectKey: name,
+    displayName: name,
+    memberProjects: [],
+    memberProjectRefs: [{ environmentId, projectId }],
+    groupedProjectCount: 1,
+    environmentPresence: "local-only",
+    allRemoteMembersAreDesktopLocal: false,
+    allRemoteMembersAreWsl: false,
+    remoteEnvironmentLabels: [],
+  };
+}
+
+const jstack: JstackAskCandidate = { group: project("jstack"), askable: false };
+const winnifred: JstackAskCandidate = { group: project("Winnifred"), askable: true };
+
+function Asker(props: {
+  candidates: ReadonlyArray<JstackAskCandidate> | null;
+  startHome: (group: SidebarProjectSnapshot) => void;
+}) {
+  useJstackAskOnAdd(props.candidates, props.startHome);
+  return null;
+}
+
+/** The sidebar as the ask sees it: the client's projects over time, one render each. */
+async function sidebar(startHome: (group: SidebarProjectSnapshot) => void) {
+  const screen = await render(
+    <ToastProvider>
+      <Asker candidates={null} startHome={startHome} />
+    </ToastProvider>,
+  );
+  return {
+    screen,
+    show: (candidates: ReadonlyArray<JstackAskCandidate> | null) =>
+      screen.rerender(
+        <ToastProvider>
+          <Asker candidates={candidates} startHome={startHome} />
+        </ToastProvider>,
+      ),
+  };
+}
+
+const ask = () => page.getByText("Start a jstack home for Winnifred?");
+
+/** A client that has seen no project yet, as before the tree first loaded. */
+function freshClient(): Disposable {
+  window.localStorage.removeItem(JSTACK_SEEN_PROJECTS_KEY);
+  return { [Symbol.dispose]: () => window.localStorage.removeItem(JSTACK_SEEN_PROJECTS_KEY) };
+}
+
+it("asks once when a project is added, and Yes starts its home as Start a home does", async () => {
+  using _client = freshClient();
+  const startHome = vi.fn();
+  const { screen, show } = await sidebar(startHome);
+  await using _screen = screen;
+  // The tree's first load seeds what is there; nothing is asked.
+  await show([jstack]);
+  await expect.element(page.getByText(/Start a jstack home/)).not.toBeInTheDocument();
+
+  await show([jstack, winnifred]);
+  await expect.element(ask()).toBeVisible();
+  await page.getByRole("button", { name: "Yes" }).click();
+  expect(startHome).toHaveBeenCalledTimes(1);
+  expect(startHome).toHaveBeenCalledWith(winnifred.group);
+  await expect.element(ask()).not.toBeInTheDocument();
+});
+
+it("Not now closes the ask and starts nothing, and a project seen once is never asked again", async () => {
+  using _client = freshClient();
+  const startHome = vi.fn();
+  {
+    const { screen, show } = await sidebar(startHome);
+    await using _screen = screen;
+    await show([jstack]);
+    await show([jstack, winnifred]);
+    await expect.element(ask()).toBeVisible();
+    // By keyboard: Enter on the focused button.
+    page.getByRole("button", { name: "Not now" }).element().focus();
+    await userEvent.keyboard("{Enter}");
+    await expect.element(ask()).not.toBeInTheDocument();
+    await show([jstack, winnifred]);
+  }
+  // A new window or a restart reads what this client has seen.
+  const { screen, show } = await sidebar(startHome);
+  await using _screen = screen;
+  await show([jstack, winnifred]);
+  await show([winnifred, jstack]);
+  await expect.element(page.getByText(/Start a jstack home/)).not.toBeInTheDocument();
+  expect(startHome).not.toHaveBeenCalled();
+});
+
+it("closes the ask once the project has a home from anywhere else, so no Yes starts a second", async () => {
+  using _client = freshClient();
+  const startHome = vi.fn();
+  const { screen, show } = await sidebar(startHome);
+  await using _screen = screen;
+  await show([jstack]);
+  await show([jstack, winnifred]);
+  await expect.element(ask()).toBeVisible();
+  // Its row's "Start a home" ran, and the home has drawn.
+  await show([jstack, { ...winnifred, askable: false }]);
+  await expect.element(ask()).not.toBeInTheDocument();
+  expect(startHome).not.toHaveBeenCalled();
+});
+
+it("waits for every project and thread to load before it seeds or asks", async () => {
+  using _client = freshClient();
+  const startHome = vi.fn();
+  const { screen, show } = await sidebar(startHome);
+  await using _screen = screen;
+  await show(null);
+  expect(window.localStorage.getItem(JSTACK_SEEN_PROJECTS_KEY)).toBeNull();
+  await show([jstack, winnifred]);
+  await expect.element(page.getByText(/Start a jstack home/)).not.toBeInTheDocument();
+});
