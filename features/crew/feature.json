{
  "$schema": "../../schemas/feature.schema.json",
  "name": "crew",
  "description": "The crewmate: does the one task of a brief in its own worktree and opens its pull request.",
  "hidden": [
    "crew"
  ],
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "startup|resume|clear|compact|fork",
      "script": "hooks/gh-logged.sh",
      "harnesses": [
        "claude-code"
      ]
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "hooks/check-foreground.sh",
      "harnesses": [
        "claude-code"
      ],
      "refuses": true
    }
  ],
  "projectSkills": [
    "project-skill/verify-crew-proof"
  ]
}
