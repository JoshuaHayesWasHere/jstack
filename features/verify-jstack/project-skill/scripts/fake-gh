#!/bin/sh
# Verification scaffolding: stands in for `gh` inside a verify-jstack sandbox, so no drive
# reaches GitHub. launch.sh links it as $VERIFY_JSTACK_SANDBOX/stub/gh.
# It answers from the files in $VERIFY_JSTACK_SANDBOX/gh, which a drive edits:
#   open.json    the open pull requests, as `gh pr list --json` gives them, and in REST's shape to
#                `gh api .../pulls?state=open`, its `updated_at` the whole entry, so a drive's
#                change to one moves it
#   merged.json  the merged ones
#   commits.json what `gh api` gives for the default branch's commits
#   checks.json  each commit's check runs, by its sha: `{}` gives every commit none
#   logs/<id>    the log of the job whose id is <id>, which is not found when the file is not
#   rate-limit.json  what `gh api rate_limit` gives, GitHub's API budget: a full one when it is not
#   runs.json    the repo's workflow runs, as `gh api .../actions/runs` gives them: none when it is
#                not. `gh run cancel <id>` marks run <id> of it completed and cancelled, and
#                `gh run rerun <id>` (with or without `--failed`) queued again, at its next
#                attempt; a run it does not hold is not found, exit 1
#   jobs/<id>.json  what `gh api .../actions/runs/<id>/jobs` gives for run <id>: no job when it is
#                not
# With `-i` an answer of `gh api` has its status and an ETag first, and with
# `-H 'If-None-Match: <that ETag>'` it is a 304 and nothing more, exit 1, as gh's.
# A commit asked for by its sha lists no changed files, and has no statuses. The repo's owner is
# sandbox-owner, and a pull request has no comment, line comment or review.
# `gh pr edit <number> --base <branch>` bases that pull request of open.json on the branch.
# Every call is one line in $VERIFY_JSTACK_SANDBOX/gh/calls.log. It never merges: `gh pr merge`
# and anything else it does not know exit 64.
G=${VERIFY_JSTACK_SANDBOX:?source the sandbox env.sh first}/gh
echo "$*" >>"$G/calls.log"
arg_after() {
  want=$1
  shift
  while [ "$#" -gt 1 ]; do
    if [ "$1" = "$want" ]; then
      echo "$2"
      return
    fi
    shift
  done
}
api() {
  case $2 in
  rate_limit)
    cat "$G/rate-limit.json" 2>/dev/null || {
      full='{"limit": 5000, "used": 0, "remaining": 5000, "reset": 1791824400}'
      printf '{"resources": {"core": %s, "graphql": %s}}\n' "$full" "$full"
    }
    ;;
  'repos/{owner}/{repo}') echo '{"name": "demo", "owner": {"login": "sandbox-owner"}}' ;;
  */issues/*/comments* | */pulls/*/comments* | */pulls/*/reviews*) echo '[]' ;;
  */actions/runs\?*) cat "$G/runs.json" 2>/dev/null || echo '{"workflow_runs": []}' ;;
  */actions/runs/*/jobs | */actions/runs/*/jobs\?*)
    run=${2#*/actions/runs/}
    cat "$G/jobs/${run%%/*}.json" 2>/dev/null || echo '{"total_count": 0, "jobs": []}'
    ;;
  */pulls\?state=open*)
    jq -c 'map({number, html_url: .url, title, draft: false, head: {ref: .headRefName, sha: .headRefOid}}
      + {base: {ref: .baseRefName}, updated_at: tojson})' "$G/open.json"
    ;;
  */check-runs | */check-runs\?*)
    sha=${2%%/check-runs*}
    jq -c --arg sha "${sha##*/}" '{check_runs: (.[$sha] // [])}' "$G/checks.json"
    ;;
  */commits/*/status) echo '{"statuses": []}' ;;
  */commits/*) echo '{"files": []}' ;;
  */actions/jobs/*/logs)
    job=${2%/logs}
    cat "$G/logs/${job##*/}" 2>/dev/null || {
      echo "gh: Not Found (HTTP 404)" >&2
      return 1
    }
    ;;
  *) cat "$G/commits.json" ;;
  esac
}
case "$1 $2" in
"pr list")
  if [ -n "$(arg_after --base "$@")" ]; then
    echo "[]"
    exit
  fi
  state=$(arg_after --state "$@")
  head=$(arg_after --head "$@")
  if [ -n "$head" ]; then
    jq -c --arg head "$head" 'map(select(.headRefName == $head))' "$G/${state:-open}.json"
  else
    cat "$G/${state:-open}.json"
  fi
  ;;
"pr view")
  case $3 in
  -* | '') jq -c '.[0] // error("no pull request")' "$G/open.json" ;;
  *) jq -c --arg pr "$3" 'map(select((.number | tostring) == $pr or .url == $pr or .headRefName == $pr)) | .[0] // error("no pull request")' "$G/open.json" ;;
  esac
  ;;
"pr edit")
  base=$(arg_after --base "$@")
  [ -n "$base" ] || exit 64
  jq --arg pr "$3" --arg base "$base" 'map(if (.number | tostring) == $pr then .baseRefName = $base else . end)' "$G/open.json" >"$G/open.json.new" &&
    mv "$G/open.json.new" "$G/open.json"
  ;;
"repo view") echo main ;;
"run cancel" | "run rerun")
  verb=$2
  shift 2
  for id; do
    case $id in -*) ;; *) break ;; esac
  done
  if ! jq -e --arg id "$id" 'any(.workflow_runs[]; (.id | tostring) == $id)' "$G/runs.json" >/dev/null 2>&1; then
    echo "could not find any workflow run with ID $id" >&2
    exit 1
  fi
  if [ "$verb" = cancel ]; then
    now='.status = "completed" | .conclusion = "cancelled"'
  else
    now='.status = "queued" | .conclusion = null | .run_attempt = (.run_attempt // 1) + 1'
  fi
  jq --arg id "$id" ".workflow_runs |= map(if (.id | tostring) == \$id then $now else . end)" \
    "$G/runs.json" >"$G/runs.json.new" && mv "$G/runs.json.new" "$G/runs.json"
  ;;
"api --paginate") ;;
api\ *)
  case " $* " in
  *" -i "*)
    body=$(api "$@") || exit
    etag="W/\"$(printf '%s' "$body" | shasum -a 256 | cut -c1-40)\""
    if [ "$(arg_after -H "$@")" = "If-None-Match: $etag" ]; then
      printf 'HTTP/2.0 304 Not Modified\r\n\r\n'
      echo "gh: HTTP 304" >&2
      exit 1
    fi
    printf 'HTTP/2.0 200 OK\r\nEtag: %s\r\n\r\n%s\n' "$etag" "$body"
    ;;
  *) api "$@" ;;
  esac
  ;;
*) exit 64 ;;
esac
