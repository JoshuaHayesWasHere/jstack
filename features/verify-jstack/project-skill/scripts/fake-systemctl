#!/bin/sh
# The sandbox's stand-in for `systemctl --user`: it says the manager reads this HOME, and
# does to the unit directory what systemd does on enable and disable of a linked unit. It
# starts and stops nothing. Every call is a line in the log.
log=${FAKE_SYSTEMCTL_LOG:-${VERIFY_JSTACK_SANDBOX:?}/systemctl.log}
units=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
echo "$*" >>"$log"
[ "${1-}" = --user ] || {
  echo "fake-systemctl: only --user is stood in for" >&2
  exit 64
}
shift
# The folder systemd's enable links a unit into: the .wants of the target its WantedBy= names.
# It reads the unit with the shell alone, since a test's PATH may hold no sed or grep.
wants() {
  target=timers.target
  while IFS= read -r line; do
    case $line in WantedBy=?*)
      target=${line#WantedBy=}
      break
      ;;
    esac
  done <"$units/$1" 2>/dev/null
  echo "$units/$target.wants"
}
case ${1-} in
show-environment) echo "HOME=$HOME" ;;
daemon-reload) ;;
is-enabled)
  if [ -L "$(wants "$2")/$2" ]; then echo enabled; else
    echo linked
    exit 1
  fi
  ;;
enable)
  [ "$2" = --now ] && [ -L "$units/$3" ] || exit 1
  mkdir -p "$(wants "$3")"
  ln -sfn "$(readlink "$units/$3")" "$(wants "$3")/$3"
  ;;
disable)
  [ "$2" = --now ] && [ -L "$units/$3" ] || exit 1
  rm -f "$(wants "$3")/$3" "$units/$3"
  ;;
show) for unit in "$@"; do case $unit in *.service | *.timer) echo no ;; esac done ;;
*)
  echo "fake-systemctl: no stand-in for $*" >&2
  exit 64
  ;;
esac
